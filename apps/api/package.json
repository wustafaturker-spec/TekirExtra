{
  "name": "@tekirextra/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node scripts/dev-izle.mjs main",
    "dev:tek": "prisma generate && tsc -p tsconfig.json && node dist/main.js",
    "dev:worker": "node scripts/dev-izle.mjs worker",
    "dev:worker:tek": "prisma generate && tsc -p tsconfig.json && node dist/main.worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "test": "vitest run",
    "test:ai-kalite": "vitest run --config vitest.ai-kalite.config.ts",
    "seed:satin-alma": "node scripts/seed-satin-alma-test.mts",
    "test:kabul": "npx turbo build --filter=@tekirextra/api... && vitest run --config vitest.kabul.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.8.0",
    "@tekirextra/baglanti": "workspace:*",
    "@tekirextra/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^6.3.1",
    "bwip-js": "^4.11.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "imapflow": "^2.4.0",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.38",
    "multer": "^2.5.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.61.1",
    "qrcode-generator": "^2.0.4",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "undici": "6.29.1",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "2.16.2",
    "prisma": "^6.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
