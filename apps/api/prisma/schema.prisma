model PersonelSayac {
  tenantId String @id @map("tenant_id") @db.Uuid
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("personel_sayaclari")
}

model Personel {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  personelNo         String              @map("personel_no")
  ad                 String
  soyad              String
  tckn               String?
  eposta             String?
  telefon            String?
  departman          String?
  unvan              String?
  calismaTipi        PersonelCalismaTipi @default(tam_zamanli) @map("calisma_tipi")
  girisTarihi        DateTime            @map("giris_tarihi") @db.Date
  cikisTarihi        DateTime?           @map("cikis_tarihi") @db.Date
  netMaas            Decimal             @map("net_maas") @db.Decimal(15, 2)
  brutMaas           Decimal?            @map("brut_maas") @db.Decimal(15, 2)
  engellilikDerecesi Int?                @map("engellilik_derecesi")
  sgkTesvikOrani     Decimal             @default(0) @map("sgk_tesvik_orani") @db.Decimal(6, 3)
  iban               String?
  cariId             String?             @unique @map("cari_id") @db.Uuid
  aktif              Boolean             @default(true)
  durum              PersonelDurum       @default(aktif)
  ayrilisNedeni      String?             @map("ayrilis_nedeni")
  isyeriId           String?             @map("isyeri_id") @db.Uuid
  departmanId        String?             @map("departman_id") @db.Uuid
  pozisyonId         String?             @map("pozisyon_id") @db.Uuid
  yoneticiId         String?             @map("yonetici_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cari                  CariHesap?                   @relation(fields: [cariId], references: [id], onDelete: SetNull)
  bordrolar             PersonelBordro[]
  avanslar              PersonelAvans[]
  istihdamDonemleri     PersonelIstihdamDonemi[]
  izinTalepleri         PersonelIzinTalebi[]
  izinBakiyeHareketleri PersonelIzinBakiyeHareketi[]
  isyeri                PersonelIsyeri?              @relation(fields: [isyeriId], references: [id])
  departmanKaydi        PersonelDepartman?           @relation(fields: [departmanId], references: [id])
  pozisyon              PersonelPozisyon?            @relation(fields: [pozisyonId], references: [id])
  yonetici              Personel?                    @relation("PersonelYonetici", fields: [yoneticiId], references: [id])
  bagliPersoneller      Personel[]                   @relation("PersonelYonetici")
  belgeler              PersonelBelgesi[]
  donemCalismalari      PersonelDonemCalisma[]

  @@unique([tenantId, personelNo])
  @@index([tenantId, ad, soyad])
  @@map("personel")
}

model PersonelDonemCalisma {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  personelId        String                  @map("personel_id") @db.Uuid
  yil               Int
  ay                Int
  primGunu          Int                     @default(30) @map("prim_gunu")
  eksikGunNedeni    PersonelEksikGunNedeni? @map("eksik_gun_nedeni")
  sgkTesvikOrani    Decimal?                @map("sgk_tesvik_orani") @db.Decimal(6, 3)
  sahisSigortaPrimi Decimal                 @default(0) @map("sahis_sigorta_primi") @db.Decimal(15, 2)
