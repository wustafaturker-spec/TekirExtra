generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

enum Rol {
  yonetici
  muhasebe
  satis
  salt_okunur
  mali_musavir
  b2b_bayi
  uretim_planlama
  uretim_operatoru
  depo
  kalite
  maliyet_muhasebesi
  /// PRS-17 (P2-8): insan kaynakları; İK modülüne erişir, finans ekranlarına erişmez.
  ik
  /// PRS-21 (P3-4): çalışan self-servisi; yalnız @Roller("calisan") uçları + oturum/bildirim.
  calisan
}

enum BaglantiAile {
  ebelge
  pazaryeri
  pos
  banka
  sms
}

enum BaglantiDurumu {
  pasif
  aktif
  hata
}

enum BelgeDurum {
  kuyrukta
  iletildi
  kabul
  ret
  hata
  iptal
}

enum AbonelikDurumu {
  deneme
  aktif
  askida
  iptal
}

enum PazaryeriSiparisDurumu {
  yeni
  esleme_bekliyor
  faturalanmaya_hazir
  faturalandi
  iptal
  hata
}

enum PazaryeriKesintiDurumu {
  bekliyor
  giderlesti
}

enum PosTahsilatDurumu {
  baslatildi
  odendi
  basarisiz
  iptal
  suresi_doldu
}

enum DuzeltmeDurumu {
  acik
  incelemede
  beklemede
  cozuldu
  yoksayildi
}

enum DuzeltmeOnemi {
  bilgi
  uyari
  kritik
}

enum DuzeltmeTuru {
  banka_ekstre
  kredi_karti
  masraf
  pos
  ebelge
  stok
  cek_senet
  fatura_cari
  /// SAT-11: sipariş–mal kabul–fatura arasındaki miktar/fiyat farkı
  satin_alma
}

model Tenant {
  ihtiyacPlanlari         IhtiyacPlani[]
  tahsilatSozBaglari      TahsilatSozBaglantisi[]
  tahsilatTakipleri       TahsilatTakibi[]
  odemeSozleri            OdemeSozu[]
  faturaGecikmeTahminleri FaturaGecikmeTahmini[]
  id                      String                  @id @default(uuid()) @db.Uuid
  unvan                   String
  vkn                     String                  @unique
  vergiDairesi            String?                 @map("vergi_dairesi")
  /// EBLG-62: e-belgenin satıcı tarafına ve PDF'lere yazılan firma bilgisi.
  adres                   String?                 @map("adres")
  ilce                    String?                 @map("ilce")
  il                      String?                 @map("il")
  postaKodu               String?                 @map("posta_kodu")
  telefon                 String?                 @map("telefon")
  eposta                  String?                 @map("eposta")
  webSitesi               String?                 @map("web_sitesi")
  /// EBLG-101: entegratöre yüklenen firma tasarımının üst şeridi. Boşsa ünvan yazılır.
  belgeMarkaAdi           String?                 @map("belge_marka_adi")
  belgeMarkaAlt           String?                 @map("belge_marka_alt")
  /// EBLG-101: satıcı bilgilerinin altında ve alt satırda basılan serbest ek bilgi (ör. sertifika no).
  belgeEkBilgi            String?                 @map("belge_ek_bilgi")
  /// EBLG-101: sağ üstte basılan rozet görselleri (data URI dizisi, en çok 3).
  belgeRozetleri          Json?                   @map("belge_rozetleri")
  mersisNo                String?                 @map("mersis_no")
  ticaretSicilNo          String?                 @map("ticaret_sicil_no")
  /// EBLG-77: firmanın kendi e-belge mükellefiyetleri. null: GİB mükellef
  /// listesinden belirlenir; true/false: firma ayarında elle söylenmiştir.
  /// e-Arşiv listesi GİB'de yayınlanmadığı için otomatikte e-Faturayı izler.
  efaturaMukellefi        Boolean?                @map("efatura_mukellefi")
  earsivMukellefi         Boolean?                @map("earsiv_mukellefi")
  eirsaliyeMukellefi      Boolean?                @map("eirsaliye_mukellefi")
  /// KLN-21: 2FA'nın zorunlu olduğu roller; boşsa zorunluluk yok.
  ikiAdimZorunluRoller    String[]                @default([]) @map("iki_adim_zorunlu_roller")
  /// KLN-22: oturum girişten itibaren en çok bu kadar gün açık kalır (1–30).
  oturumSuresiGun         Int                     @default(30) @map("oturum_suresi_gun")
  /// KLN-22: son yenilemesi bu kadar dakikadan eski oturum yenilenmez; null = kapalı.
  hareketsizlikDk         Int?                    @map("hareketsizlik_dk")
  /// Yolcu beraberi (tax-free): KDV iadesini yapan aracı kurumun varsayılanı;
  /// sihirbazda faturaya özel değiştirilir.
  araciKurumVkn           String?                 @map("araci_kurum_vkn")
  araciKurumEtiket        String?                 @map("araci_kurum_etiket")
  araciKurumUnvan         String?                 @map("araci_kurum_unvan")
  /// SGK faturası: firmanın hangi grupta olduğu ve Kurum'da tanımlı kodu/adı.
  /// Sağlık hizmeti sunucusunda sabittir, her faturada tekrar yazılmaz.
  sgkIlaveFaturaTipi      String?                 @map("sgk_ilave_fatura_tipi")
  sgkMukellefKodu         String?                 @map("sgk_mukellef_kodu")
  sgkMukellefAdi          String?                 @map("sgk_mukellef_adi")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  users                     User[]
  modulAyarlari             ModulAyar[]
  baglantilar               Baglanti[]
  auditLoglar               AuditLog[]
  abonelik                  TenantAbonelik?
  abonelikDegisiklikleri    AbonelikDegisikligi[]
  abonelikTalepleri         AbonelikTalebi[]
  abonelikOdemeleri         AbonelikOdemesi[]
  abonelikOdemeDenemeleri   AbonelikOdemeDenemesi[]
  abonelikKarti             AbonelikKarti?
  abonelikFaturaAyarlari    AbonelikFaturaAyari[]
  odenenAbonelikFaturalari  AbonelikFaturasi[]       @relation("AbonelikFaturasiOdeyen")
  kesilenAbonelikFaturalari AbonelikFaturasi[]       @relation("AbonelikFaturasiFaturalayan")
  destekIzinleri            DestekIzni[]
  ozelRoller                OzelRol[]
  cariMahsuplari            CariMahsup[]
  destekOturumlari          DestekOturumu[]
  pazaryeriSiparisleri      PazaryeriSiparis[]
  posTahsilatlari           PosTahsilat[]
  pazaryeriKesintileri      PazaryeriKesinti[]
  bankaHesapEslemeleri      BankaBaglantiHesap[]
  bankaOdemeTalimatlari     BankaOdemeTalimati[]
  odemeTalimatiFaturalari   BankaOdemeTalimatiFatura[]
  odemePaketleri            OdemePaketi[]
  numaraSayaclari           NumaraSayaci[]
  masrafKategorileri        MasrafKategori[]
  masraflar                 Masraf[]
  masrafOdemeleri           MasrafOdeme[]
  gelirKategorileri         GelirKategori[]
  gelirKayitlari            GelirKaydi[]
  kiraSozlesmeleri          KiraSozlesme[]
  epostaGonderimleri        EpostaGonderim[]
  gelenEpostalar            GelenEposta[]
  eirsaliyeKayitlari        EirsaliyeKayit[]
  gelenEirsaliyeler         GelenEirsaliye[]
  elleKurlari               ElleKur[]
  elleKurOlaylari           ElleKurOlayi[]
  krediKartlari             KrediKarti[]
  krediKartiHareketleri     KrediKartiHareket[]
  krediKartiTaksitleri      KrediKartiTaksit[]
  krediKartiEkstreleri      KrediKartiEkstre[]
  personeller               Personel[]
  personelBordrolari        PersonelBordro[]
  personelAvanslari         PersonelAvans[]
  personelIstihdamDonemleri PersonelIstihdamDonemi[]
  personelBordroKalemleri   PersonelBordroKalemi[]
  personelBordroOdemeleri   PersonelBordroOdeme[]
  izinTurleri               PersonelIzinTuru[]
  izinTalepleri             PersonelIzinTalebi[]
  izinBakiyeHareketleri     PersonelIzinBakiyeHareketi[]
  personelTatilGunleri      PersonelTatilGunu[]
  personelIsyerleri         PersonelIsyeri[]
  personelDepartmanlari     PersonelDepartman[]
  personelPozisyonlari      PersonelPozisyon[]
  personelBelgeleri         PersonelBelgesi[]
  personelDonemCalismalari  PersonelDonemCalisma[]
  personelSayaci            PersonelSayac?
  uretimSayaclari           UretimSayac[]
  makbuzSerileri            MakbuzSeri[]
  cekSenetBordrolari        CekSenetBordro[]
  cekSenetBordroSayaclari   CekSenetBordroSayac[]
  uretimBildirimleri        UretimBildirimi[]
  isMerkezleri              IsMerkezi[]
  kaliteKontrolleri         UretimKaliteKontrol[]
  uretimSarfDuzeltmeleri    UretimSarfDuzeltme[]
  uretimVardiyalari         UretimVardiya[]
  uretimDuruslari           UretimDurus[]
  uretimDonemKilitleri      UretimDonemKilidi[]
  maliDonemler              MaliDonem[]
  bildirimler               Bildirim[]
  bildirimTeslimatlari      BildirimTeslimati[]
  bildirimTercihleri        BildirimTercihi[]
  bildirimAyarlari          BildirimKullaniciAyari[]
  maliDonemOlaylari         MaliDonemOlayi[]
  butceler                  Butce[]
  satinAlmaTalepleri        SatinAlmaTalebi[]
  satinAlmaTalepKalemleri   SatinAlmaTalepKalemi[]
  satinAlmaTeklifleri       SatinAlmaTeklifi[]
  satinAlmaTeklifKalemleri  SatinAlmaTeklifKalemi[]
  satinAlmaTalepOlaylari    SatinAlmaTalepOlayi[]
  satinAlmaSayaclari        SatinAlmaSayac[]
  butceSatirlari            ButceSatiri[]
  butceOlaylari             ButceOlayi[]
  donemKontrolleri          DonemKontrolu[]
  uretimEmriCiktilari       UretimEmriCikti[]
  urunRecetesiCiktilari     UrunRecetesiCikti[]
  crmFirsatlari             CrmFirsat[]
  projeler                  Proje[]
  projeAsamalari            ProjeAsama[]
  projeAltKirilimlari       ProjeAltKirilim[]
  projeNotlari              ProjeNot[]
  duzeltmeKayitlari         DuzeltmeKaydi[]
  duzeltmeOlaylari          DuzeltmeOlayi[]
  stokMaliyetDuzeltmeleri   StokMaliyetDuzeltme[]
  maliyetDagitimlari        MaliyetDagitimi[]
  maliyetDagitimPaylari     MaliyetDagitimPayi[]
  personelUcretleri         PersonelUcret[]
  personelBilgiTalepleri    PersonelBilgiTalebi[]

  stokEkVergileri         StokEkVergi[]
  ajanOturumlari          AjanOturumu[]
  aiOnayTalepleri         AiOnayTalebi[]
  aiMcpAnahtarlari        AiMcpAnahtari[]
  aiAracIstekleri         AiAracIstegi[]
  aiKullanim              AiKullanim[]
  aiCagriIzleri           AiCagriIz[]
  aiOcrDenetimleri        AiOcrDenetim[]
  aiVeriAktarimOnaylari   AiVeriAktarimOnayi[]
  belgeOcrKayitlari       BelgeOcrKaydi[]
  aiAyari                 TenantAiAyari?
  aiTavani                PlatformAiTavani?
  epostaTeklifIslemleri   EpostaTeklifIslemi[]
  aiHafiza                AiHafiza[]
  isKutusuKapanislari     IsKutusuKapanisi[]
  onDenetimKararlari      OnDenetimKarari[]
  onDenetimSusturmalari   OnDenetimSusturma[]
  cariMukerrerIstisnalari CariMukerrerIstisna[]
  cariBirlestirmeleri     CariBirlestirme[]
  teklifTakipleri         TeklifTakibi[]
  aiGorevleri             TenantAiGorev[]
  aiGorevCalismalari      TenantAiGorevCalisma[]
  aiIcgoruleri            AiIcgoru[]

  @@map("tenants")
}

/// KLN-08: v1.0 fiyatlandırma uygulamaz. Sağlayıcı ve dönem alanları ileride
/// ödeme altyapısı bağlanırken tenant tablosunu değiştirmeden kullanılacaktır.
model TenantAbonelik {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @unique @map("tenant_id") @db.Uuid
  planKodu             String         @default("v1") @map("plan_kodu")
  durum                AbonelikDurumu @default(aktif)
  faturaEpostasi       String?        @map("fatura_epostasi")
  faturalandirmaUnvani String?        @map("faturalandirma_unvani")
  saglayici            String?
  saglayiciMusteriRef  String?        @map("saglayici_musteri_ref")
  donemBaslangici      DateTime?      @map("donem_baslangici")
  donemSonu            DateTime?      @map("donem_sonu")
  iptalTarihi          DateTime?      @map("iptal_tarihi")
  /// PLT-13: "odeme" nedeniyle askıdaki firma başarılı ödemeyle kendiliğinden açılır.
  askiNedeni           String?        @map("aski_nedeni") @db.VarChar(20)
  meta                 Json?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([durum, donemSonu])
  @@map("tenant_abonelikleri")
}

model AbonelikDegisikligi {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  oncekiPlan  String?         @map("onceki_plan")
  yeniPlan    String          @map("yeni_plan")
  oncekiDurum AbonelikDurumu? @map("onceki_durum")
  yeniDurum   AbonelikDurumu  @map("yeni_durum")
  neden       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("abonelik_degisiklikleri")
}

/// Platform P0-1: firma yöneticisinin plan değişikliği talebi; platform onaylar ya da reddeder.
/// Firma başına tek bekleyen talep (kısmi benzersiz indeks göçte).
model AbonelikTalebi {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  mevcutPlan           String    @map("mevcut_plan")
  istenenPlan          String    @map("istenen_plan")
  /// bekliyor | onaylandi | reddedildi | geri_cekildi
  durum                String    @default("bekliyor")
  aciklama             String?   @db.VarChar(500)
  kararNotu            String?   @map("karar_notu") @db.VarChar(500)
  isteyenUserId        String    @map("isteyen_user_id") @db.Uuid
  kararVerenPlatformId String?   @map("karar_veren_platform_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  kararAt              DateTime? @map("karar_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("abonelik_talepleri")
}

/// KLN-20: şablondan türetilen, yalnız yetki kapatan özel rol. `kapaliKutular`: "modul.islem".
model OzelRol {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  ad            String   @db.VarChar(80)
  sablonRol     Rol      @map("sablon_rol")
  kapaliKutular String[] @default([]) @map("kapali_kutular")
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullanicilar User[]

  @@unique([tenantId, ad])
  @@map("ozel_roller")
}

/// KLN-24: firma yöneticisinin TekirExtra ekibine verdiği süreli destek izni.
model DestekIzni {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  verenUserId    String    @map("veren_user_id") @db.Uuid
  /// 1 | 24 | 168
  sureSaat       Int       @map("sure_saat")
  baslangic      DateTime  @default(now())
  bitis          DateTime
  geriAlanUserId String?   @map("geri_alan_user_id") @db.Uuid
  geriAlindiAt   DateTime? @map("geri_alindi_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  veren      User            @relation("DestekIzniVeren", fields: [verenUserId], references: [id], onDelete: Restrict)
  geriAlan   User?           @relation("DestekIzniGeriAlan", fields: [geriAlanUserId], references: [id], onDelete: SetNull)
  oturumlar  DestekOturumu[]

  @@index([tenantId, bitis])
  @@map("destek_izinleri")
}

/// PLT-10: platform yöneticisinin izinli firmada açtığı salt okunur destek oturumu.
/// Platform yalnız SECURITY DEFINER işlevleriyle açar/kapatır.
model DestekOturumu {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  izinId                  String    @map("izin_id") @db.Uuid
  platformKullaniciId     String    @map("platform_kullanici_id") @db.Uuid
  platformKullaniciAdi    String    @map("platform_kullanici_adi")
  platformKullaniciEposta String    @map("platform_kullanici_eposta")
  acilis                  DateTime  @default(now())
  bitis                   DateTime
  kapanis                 DateTime?
  kapanisNedeni           String?   @map("kapanis_nedeni")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  izin   DestekIzni @relation(fields: [izinId], references: [id], onDelete: Cascade)

  @@index([tenantId, acilis])
  @@map("destek_oturumlari")
}

/// PLT-09: platformun elle işaretlediği abonelik ödemesi; dönem sonunu uzatır.
model AbonelikOdemesi {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  /// 1 | 3 | 6 | 12
  aySayisi            Int       @map("ay_sayisi")
  tutar               Decimal   @db.Decimal(14, 2)
  not                 String?   @db.VarChar(500)
  oncekiDonemSonu     DateTime? @map("onceki_donem_sonu")
  yeniDonemSonu       DateTime  @map("yeni_donem_sonu")
  /// Elle kayıtta platform kullanıcısı; sağlayıcıdan gelen ödemede boş.
  platformKullaniciId String?   @map("platform_kullanici_id") @db.Uuid
  /// PLT-13: "elle" (PLT-09) | "saglayici"
  kaynak              String    @default("elle") @db.VarChar(20)
  saglayici           String?   @db.VarChar(20)
  /// PLT-12: KDV hariç tutar ve KDV; elle kayıtta boş (yalnız toplam girilir).
  matrah              Decimal?  @db.Decimal(14, 2)
  kdv                 Decimal?  @db.Decimal(14, 2)
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  denemeler AbonelikOdemeDenemesi[]
  fatura    AbonelikFaturasi?

  @@index([tenantId, createdAt])
  @@map("abonelik_odemeleri")
}

/// PLT-13/14: abonelik ödeme girişimi (panel, e-posta bağlantısı ya da otomatik yenileme).
model AbonelikOdemeDenemesi {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  saglayici         String    @db.VarChar(20)
  ortam             String    @db.VarChar(10)
  /// panel | eposta | otomatik
  kaynak            String    @db.VarChar(20)
  planKodu          String    @map("plan_kodu")
  aySayisi          Int       @map("ay_sayisi")
  matrah            Decimal   @db.Decimal(14, 2)
  kdv               Decimal   @db.Decimal(14, 2)
  toplam            Decimal   @db.Decimal(14, 2)
  /// baslatildi | odendi | basarisiz
  durum             String    @default("baslatildi") @db.VarChar(20)
  saglayiciToken    String?   @map("saglayici_token") @db.VarChar(255)
  saglayiciOdemeId  String?   @map("saglayici_odeme_id") @db.VarChar(100)
  odemeSayfasiUrl   String?   @map("odeme_sayfasi_url")
  hataMesaji        String?   @map("hata_mesaji") @db.VarChar(500)
  kartKaydet        Boolean   @default(false) @map("kart_kaydet")
  odeyenIp          String?   @map("odeyen_ip") @db.VarChar(45)
  baslatanUserId    String?   @map("baslatan_user_id") @db.Uuid
  abonelikOdemesiId String?   @map("abonelik_odemesi_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  sonuclandiAt      DateTime? @map("sonuclandi_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  abonelikOdemesi AbonelikOdemesi? @relation(fields: [abonelikOdemesiId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([saglayici, saglayiciOdemeId], map: "abonelik_odeme_denemeleri_saglayici_odeme_key")
  @@index([tenantId, createdAt])
  @@map("abonelik_odeme_denemeleri")
}

/// PLT-14: otomatik yenileme kartı (firma başına bir). Kart sağlayıcıda
/// saklanır; burada yalnız sağlayıcının kart anahtarları (şifreli) ve son 4 hane durur.
model AbonelikKarti {
  tenantId          String    @id @map("tenant_id") @db.Uuid
  saglayici         String    @db.VarChar(20)
  ortam             String    @db.VarChar(10)
  /// iyzico: { cardUserKey, cardToken } · PayTR: { utoken, ctoken }
  sifreliAnahtarlar String    @map("sifreli_anahtarlar")
  son4              String?   @db.VarChar(4)
  kartMarkasi       String?   @map("kart_markasi") @db.VarChar(40)
  otomatikYenileme  Boolean   @default(true) @map("otomatik_yenileme")
  aySayisi          Int       @map("ay_sayisi")
  odeyenIp          String?   @map("odeyen_ip") @db.VarChar(45)
  kaydedenUserId    String?   @map("kaydeden_user_id") @db.Uuid
  yenilemeDonemSonu DateTime? @map("yenileme_donem_sonu")
  denemeSayisi      Int       @default(0) @map("deneme_sayisi")
  sonDenemeAt       DateTime? @map("son_deneme_at")
  sonHata           String?   @map("son_hata") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("abonelik_kartlari")
}

/// PLT-11: abonelik ödeme sağlayıcısının erişim bilgileri. Platform tablosu:
/// uygulama rolünün yetkisi yoktur, yalnız platform bağlantısı okur/yazar.
model AbonelikSaglayiciAyari {
  /// iyzico | paytr
  saglayici     String             @id @db.VarChar(20)
  /// test | canli
  ortam         String             @default("test") @db.VarChar(10)
  sifreliConfig String             @map("sifreli_config")
  etkin         Boolean            @default(false)
  guncelleyenId String?            @map("guncelleyen_id") @db.Uuid
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  guncelleyen   PlatformKullanici? @relation(fields: [guncelleyenId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("abonelik_saglayici_ayarlari")
}

model User {
  tahsilatSorumluluklari TahsilatTakibi[]
  verdigiDestekIzinleri    DestekIzni[]    @relation("DestekIzniVeren")
  geriAldigiDestekIzinleri DestekIzni[]    @relation("DestekIzniGeriAlan")
  olusturduguMahsuplar     CariMahsup[]    @relation("MahsupOlusturan")
  geriAldigiMahsuplar      CariMahsup[]    @relation("MahsupGeriAlan")
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  eposta                 String
  parolaHash             String           @map("parola_hash")
  adSoyad                String           @map("ad_soyad")
  rol                    Rol
  /// KLN-20: özel rol; `rol` şablon rolüdür, özel rol yalnız kutu kapatır.
  ozelRolId              String?          @map("ozel_rol_id") @db.Uuid
  ozelRol                OzelRol?         @relation(fields: [ozelRolId], references: [id], onDelete: Restrict)
  aktif                  Boolean          @default(true)
  epostaDogrulandi       Boolean          @default(false) @map("eposta_dogrulandi")
  /// TOTP gizli anahtarı AES-256-GCM ile şifreli saklanır (KLN-05)
  totpSecretSifreli      String?          @map("totp_secret_sifreli")
  totpAktif              Boolean          @default(false) @map("totp_aktif")
  /// Yönetim P1-1: tek kullanımlık 2FA kurtarma kodlarının sha256 özetleri.
  totpKurtarmaOzetleri   String[]         @default([]) @map("totp_kurtarma_ozetleri")
  /// Yönetim P1-2: parola/2FA değişince artar; eski erişim token'ları reddedilir.
  oturumSurumu           Int              @default(0) @map("oturum_surumu")
  /// Yönetim P2-4: son başarılı giriş (oturum yenileme sayılmaz).
  sonGirisAt             DateTime?        @map("son_giris_at")
  maksIskontoYuzdesi     Decimal?         @map("maks_iskonto_yuzdesi") @db.Decimal(5, 2)
  bayiCariId             String?          @map("bayi_cari_id") @db.Uuid
  /// PRS-21: çalışan rolünün bağlı olduğu personel kartı.
  personelId             String?          @unique @map("personel_id") @db.Uuid
  /// PRS-21: self-servis davetinin anahtar özeti (sha256); parola belirlenince silinir.
  davetAnahtarOzeti      String?          @map("davet_anahtar_ozeti")
  davetSonGecerlilik     DateTime?        @map("davet_son_gecerlilik")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  tenant                       Tenant                  @relation(fields: [tenantId], references: [id])
  temsilciCariler              CariHesap[]             @relation("CariTemsilci")
  bayiCari                     CariHesap?              @relation("BayiKullaniciCari", fields: [bayiCariId], references: [id], onDelete: SetNull)
  personel                     Personel?               @relation("PersonelKullanici", fields: [personelId], references: [id], onDelete: SetNull)
  crmGorevleri                 CrmGorev[]              @relation("CrmGorevAtanan")
  crmKayitlari                 CrmEtkilesim[]
  crmFirsatlari                CrmFirsat[]             @relation("CrmFirsatSorumlu")
  olusturduguOdemeTalimatlari  BankaOdemeTalimati[]    @relation("TalimatOlusturan")
  onayladigiOdemeTalimatlari   BankaOdemeTalimati[]    @relation("TalimatOnaylayan")
  uretimOperasyonlari          UretimEmriOperasyonu[]  @relation("UretimOperatoru")
  olusturduguUretimDuruslari   UretimDurus[]           @relation("UretimDurusOlusturan")
  kapattigiUretimDonemleri     UretimDonemKilidi[]     @relation("UretimDonemKapatan")
  maliDonemOlaylari            MaliDonemOlayi[]        @relation("MaliDonemOlayKullanicisi")
  onaylananButceler            Butce[]                 @relation("ButceOnaylayan")
  butceOlaylari                ButceOlayi[]            @relation("ButceOlayKullanicisi")
  satinAlmaTalepleri           SatinAlmaTalebi[]       @relation("SatinAlmaTalepEden")
  onayladigiSatinAlmaTalepleri SatinAlmaTalebi[]       @relation("SatinAlmaTalepOnaylayan")
  satinAlmaTalepOlaylari       SatinAlmaTalepOlayi[]
  elleKurlari                  ElleKur[]               @relation("ElleKurKullanicisi")
  elleKurOlaylari              ElleKurOlayi[]          @relation("ElleKurOlayKullanicisi")
  bildirimTeslimatlari         BildirimTeslimati[]
  bildirimTercihleri           BildirimTercihi[]
  bildirimAyari                BildirimKullaniciAyari?
  sorumluProjeler              Proje[]                 @relation("ProjeSorumlu")
  projeNotlari                 ProjeNot[]
  atananDuzeltmeKayitlari      DuzeltmeKaydi[]         @relation("DuzeltmeAtanan")
  cozduguDuzeltmeKayitlari     DuzeltmeKaydi[]         @relation("DuzeltmeCozen")
  duzeltmeOlaylari             DuzeltmeOlayi[]
  ajanOturumlari               AjanOturumu[]
  aiOnayTalepleri              AiOnayTalebi[]
  aiMcpAnahtarlari             AiMcpAnahtari[]

  @@unique([tenantId, eposta])
  @@index([tenantId])
  @@index([tenantId, bayiCariId])
  @@index([ozelRolId])
  @@map("users")
}

model PazaryeriSiparis {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  baglantiId     String                 @map("baglanti_id") @db.Uuid
  hariciId       String                 @map("harici_id")
  siparisNo      String                 @map("siparis_no")
  durum          PazaryeriSiparisDurumu @default(yeni)
  hariciDurum    String?                @map("harici_durum")
  siparisTarihi  DateTime               @map("siparis_tarihi")
  musteriUnvani  String                 @map("musteri_unvani")
  musteriEposta  String?                @map("musteri_eposta")
  musteriTelefon String?                @map("musteri_telefon")
  vknTckn        String?                @map("vkn_tckn")
  dovizCinsi     DovizCinsi             @default(TRY) @map("doviz_cinsi")
  toplam         Decimal                @db.Decimal(15, 2)
  teslimatAdresi Json?                  @map("teslimat_adresi")
  hamVeri        Json?                  @map("ham_veri")
  cariId         String?                @map("cari_id") @db.Uuid
  faturaId       String?                @map("fatura_id") @db.Uuid
  hataMesaji     String?                @map("hata_mesaji")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglanti Baglanti                 @relation(fields: [baglantiId], references: [id], onDelete: Cascade)
  cari     CariHesap?               @relation(fields: [cariId], references: [id])
  fatura   Fatura?                  @relation(fields: [faturaId], references: [id])
  satirlar PazaryeriSiparisSatiri[]

  @@unique([tenantId, baglantiId, hariciId])
  @@index([tenantId, durum, siparisTarihi])
  @@map("pazaryeri_siparisleri")
}

model PazaryeriSiparisSatiri {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  siparisId     String   @map("siparis_id") @db.Uuid
  hariciSatirId String   @map("harici_satir_id")
  sku           String
  barkod        String?
  urunAdi       String   @map("urun_adi")
  miktar        Decimal  @db.Decimal(15, 4)
  birimFiyat    Decimal  @map("birim_fiyat") @db.Decimal(15, 6)
  kdvOrani      Decimal  @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  stokId        String?  @map("stok_id") @db.Uuid
  varyantId     String?  @map("varyant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  siparis PazaryeriSiparis @relation(fields: [siparisId], references: [id], onDelete: Cascade)
  stok    StokKart?        @relation(fields: [stokId], references: [id])
  varyant StokVaryant?     @relation(fields: [varyantId], references: [id])

  @@unique([siparisId, hariciSatirId])
  @@index([tenantId, stokId])
  @@map("pazaryeri_siparis_satirlari")
}

model PazaryeriKesinti {
  id         String                 @id @default(uuid()) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  baglantiId String                 @map("baglanti_id") @db.Uuid
  hariciId   String                 @map("harici_id")
  siparisNo  String?                @map("siparis_no")
  tur        String
  aciklama   String?
  tarih      DateTime               @db.Date
  tutar      Decimal                @db.Decimal(15, 2)
  dovizCinsi DovizCinsi             @default(TRY) @map("doviz_cinsi")
  durum      PazaryeriKesintiDurumu @default(bekliyor)
  hareketId  String?                @unique @map("hareket_id") @db.Uuid
  hamVeri    Json?                  @map("ham_veri")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglanti Baglanti          @relation(fields: [baglantiId], references: [id], onDelete: Cascade)
  hareket  KasaBankaHareket? @relation(fields: [hareketId], references: [id])

  @@unique([tenantId, baglantiId, hariciId])
  @@index([tenantId, durum, tarih])
  @@map("pazaryeri_kesintileri")
}

/// e-posta → (tenant, user) rehberi. BİLİNÇLİ OLARAK RLS'SİZ: oturum açma
/// anında kiracı bağlamı henüz yoktur. Parola içermez; e-posta sistem
/// genelinde tekildir (MIMARI §7).
model AuthKimlik {
  id        String   @id @default(uuid()) @db.Uuid
  eposta    String   @unique
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_kimlikler")
}

/// Refresh token oturumları (hash saklanır). RLS'siz: token yenileme
/// ön-kimlik aşamasında yapılır (MIMARI §7).
model Oturum {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  gecerlilikSonu   DateTime @map("gecerlilik_sonu")
  createdAt        DateTime @default(now()) @map("created_at")
  /// Yönetim P2-4: "Oturumlarım" listesi için; yenilemede taşınır.
  girisAt          DateTime @default(now()) @map("giris_at")
  ip               String?  @db.VarChar(64)
  tarayici         String?  @db.VarChar(200)

  @@index([userId])
  @@map("oturumlar")
}

/// e-posta doğrulama token'ları (KLN-09; hash saklanır, süreli). RLS'siz:
/// doğrulama linki oturum açılmadan tıklanır (MIMARI §7).
model EpostaDogrulama {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  gecerlilikSonu DateTime @map("gecerlilik_sonu")
  kullanildi     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("eposta_dogrulamalar")
}

/// KLN-12: "Şifremi unuttum" bağlantısı; kiracı bağlamı kurulmadan okunur (RLS bilinçli istisna).
model ParolaSifirlama {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  gecerlilikSonu DateTime @map("gecerlilik_sonu")
  kullanildi     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("parola_sifirlamalar")
}

/// KLN-23: e-posta (giriş adı) değişikliği bağlantıları. Bilinçli RLS
/// istisnası (parola_sifirlamalar gibi): bağlantı kiracı bağlamı kurulmadan
/// doğrulanır; yalnız token özeti saklanır.
model EpostaDegisimi {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  yeniEposta     String   @map("yeni_eposta")
  tokenHash      String   @unique @map("token_hash")
  gecerlilikSonu DateTime @map("gecerlilik_sonu")
  kullanildi     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("eposta_degisimleri")
}

model EpostaGonderim {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  alici      String
  konu       String
  tur        String   @default("genel")
  durum      String
  ekSayisi   Int      @default(0) @map("ek_sayisi")
  hataMesaji String?  @map("hata_mesaji")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("eposta_gonderimleri")
}

model GelenEposta {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  mesajId               String   @map("mesaj_id")
  uid                   Int?
  gonderenAdi           String?  @map("gonderen_adi")
  gonderenEposta        String   @map("gonderen_eposta")
  aliciEposta           String   @map("alici_eposta")
  konu                  String
  icerikMetin           String?  @map("icerik_metin") @db.Text
  icerikHtml            String?  @map("icerik_html") @db.Text
  tarih                 DateTime
  okundu                Boolean  @default(false)
  durum                 String   @default("yeni") // yeni, islendi, arsivlendi, hata
  cariId                String?  @map("cari_id") @db.Uuid
  crmFirsatId           String?  @map("crm_firsat_id") @db.Uuid
  faturaId              String?  @map("fatura_id") @db.Uuid
  masrafId              String?  @map("masraf_id") @db.Uuid
  /// AI-33: otomatik yanıt / bülten / teslim raporu (başlıklardan); teklif talebi olarak işlenmez.
  otomatik              Boolean  @default(false)
  /// AI-39: yanıtladığı iletilerin kimlikleri (In-Reply-To + References).
  yanitlananMesajIdleri String[] @default([]) @map("yanitlanan_mesaj_idleri")
  /// AI-39: yanıt olarak eşleştiği teklif.
  teklifBelgeId         String?  @map("teklif_belge_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cari         CariHesap?          @relation(fields: [cariId], references: [id], onDelete: SetNull)
  ekler        GelenEpostaEk[]
  teklifIslemi EpostaTeklifIslemi?
  teklifBelge  Belge?              @relation("TeklifYanitlari", fields: [teklifBelgeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, mesajId])
  @@index([tenantId, tarih])
  @@index([tenantId, gonderenEposta])
  @@index([tenantId, durum])
  @@map("gelen_epostalar")
}

/// AI-38…43: gönderilen teklifin takibi; teklif başına tek kayıt. Yeniden gönderim
/// kaydı tazeler (mesaj kimliği eklenir, hatırlatma yeniden kurulur).
model TeklifTakibi {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  belgeId             String    @unique @map("belge_id") @db.Uuid
  /// eposta | elle
  kaynak              String
  /// yanit_bekliyor | hatirlatildi | yanit_geldi | kapandi
  durum               String
  alici               String?
  mesajIdleri         String[]  @default([]) @map("mesaj_idleri")
  sorumluUserId       String?   @map("sorumlu_user_id") @db.Uuid
  gonderildiAt        DateTime  @map("gonderildi_at")
  gonderimSayisi      Int       @default(1) @map("gonderim_sayisi")
  hatirlatmaGunu      DateTime  @map("hatirlatma_gunu") @db.Date
  hatirlatildiAt      DateTime? @map("hatirlatildi_at")
  gecerlilikUyarisiAt DateTime? @map("gecerlilik_uyarisi_at")
  yanitEpostaId       String?   @map("yanit_eposta_id") @db.Uuid
  yanitAt             DateTime? @map("yanit_at")
  crmGorevId          String?   @map("crm_gorev_id") @db.Uuid
  kapanisNedeni       String?   @map("kapanis_nedeni")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  belge  Belge  @relation(fields: [belgeId], references: [id], onDelete: Cascade)

  @@index([tenantId, durum, hatirlatmaGunu])
  @@map("teklif_takipleri")
}

/// AI-32…37: gelen e-postadaki teklif talebinin işlenişi; e-posta başına tek kayıt.
/// Cari, belge, fırsat ve onay talebi kimlikleri veritabanında FK ile korunur.
model EpostaTeklifIslemi {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  gelenEpostaId    String    @unique @map("gelen_eposta_id") @db.Uuid
  calistiranUserId String?   @map("calistiran_user_id") @db.Uuid
  /// isleniyor | atlandi | teklif_degil | incelenmeli | cari_secimi | cari_onayi_bekliyor | cari_yok | taslak_hazir | sinirda | hata | kapatildi
  durum            String
  guven            Decimal?  @db.Decimal(4, 3)
  cikarim          Json?
  kalemler         Json      @default("[]")
  uyarilar         Json      @default("[]")
  /// AI-45: kullanıcıya seçtirilen yaklaşık cari adayları (gerekçeleriyle).
  cariAdaylari     Json      @default("[]") @map("cari_adaylari")
  cariId           String?   @map("cari_id") @db.Uuid
  belgeId          String?   @map("belge_id") @db.Uuid
  firsatId         String?   @map("firsat_id") @db.Uuid
  onayTalebiId     String?   @map("onay_talebi_id") @db.Uuid
  hata             String?   @db.Text
  deneme           Int       @default(1)
  sonrakiDenemeAt  DateTime? @map("sonraki_deneme_at")
  /// AI-61: taslak dışına çıkan teklifin son satırlarından öğrenme yapıldı (tek sefer).
  hafizaIslendiAt  DateTime? @map("hafiza_islendi_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gelenEposta GelenEposta @relation(fields: [gelenEpostaId], references: [id], onDelete: Cascade)

  @@index([tenantId, durum])
  @@map("eposta_teklif_islemleri")
}

/// AI-58…65: kiracıya ait ajan hafızası. Tutar/fiyat/bakiye saklanmaz; muhasebe verisi
/// her zaman güncel kayıttan okunur. Tekillik (tenant, tür, cari, anahtar) göçteki ifade indeksindedir.
model AiHafiza {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// urun_eslesme | cari_eslesme | musteri_tercihi | siniflandirma | susturma
  tur             String
  /// Normalize ifade / gönderen adresi / tercih metni / e-posta kimliği.
  anahtar         String
  cariId          String?   @map("cari_id") @db.Uuid
  stokId          String?   @map("stok_id") @db.Uuid
  varyantId       String?   @map("varyant_id") @db.Uuid
  /// Kullanıcıya gösterilen metin (asıl ifade, tercih, örnek e-posta özeti).
  metin           String?   @db.Text
  /// siniflandirma: teklif | teklif_degil
  etiket          String?
  /// kullanici | otomatik | ai_onerisi
  kaynak          String
  /// aktif | oneri | pasif
  durum           String    @default("aktif")
  olusturanUserId String?   @map("olusturan_user_id") @db.Uuid
  kaynakEpostaId  String?   @map("kaynak_eposta_id") @db.Uuid
  kullanimSayisi  Int       @default(0) @map("kullanim_sayisi")
  sonKullanimAt   DateTime? @map("son_kullanim_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tur, anahtar])
  @@index([tenantId, cariId])
  @@map("ai_hafiza")
}

/// AI-66…70: teklif iş kutusundan kaldırılan kayıt; önceki durumla geri alınabilir.
/// Kayıt başına tek açık kapanış (geri_alindi_at IS NULL) kısmi tekil indeksle göçte korunur.
model IsKutusuKapanisi {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// eposta (eposta_teklif_islemleri) | yanit (teklif_takipleri) | onay (ai_onay_talepleri)
  tur            String
  kayitId        String    @map("kayit_id") @db.Uuid
  /// elle_yapildi | iptal | teklif_degil
  neden          String
  notMetni       String?   @map("not_metni")
  bagliBelgeId   String?   @map("bagli_belge_id") @db.Uuid
  /// silindi | iptal_edildi — e-postadan açılmış taslağa yapılan
  taslakSonucu   String?   @map("taslak_sonucu")
  /// Geri alma için kaydın kapanıştan önceki alanları.
  onceki         Json      @default("{}")
  /// Kaydın sahibi (çalıştıran / sorumlu / talebi açan); "Benim işlerim" süzgeci.
  sahipUserId    String?   @map("sahip_user_id") @db.Uuid
  kapatanUserId  String?   @map("kapatan_user_id") @db.Uuid
  kapandiAt      DateTime  @default(now()) @map("kapandi_at")
  geriAlanUserId String?   @map("geri_alan_user_id") @db.Uuid
  geriAlindiAt   DateTime? @map("geri_alindi_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kapandiAt])
  @@map("is_kutusu_kapanislari")
}

model GelenEpostaEk {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  epostaId      String   @map("eposta_id") @db.Uuid
  dosyaAdi      String   @map("dosya_adi")
  mimeTuru      String   @map("mime_turu")
  boyut         Int
  minioAnahtari String   @map("minio_anahtari")
  cikarilanVeri Json?    @map("cikarilan_veri")
  createdAt     DateTime @default(now()) @map("created_at")

  eposta GelenEposta @relation(fields: [epostaId], references: [id], onDelete: Cascade)

  @@index([tenantId, epostaId])
  @@map("gelen_eposta_ekleri")
}

/// Modül başına ayarlar; zod şemasıyla doğrulanır (AYR-01/03, MIMARI §4.2).
model ModulAyar {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  modul     String
  ayarlar   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, modul])
  @@map("modul_ayarlari")
}

/// Dış bağlantılar: e-belge/pazaryeri/POS/banka (ENT-01, MIMARI §5).
/// sifreliConfig: AES-256-GCM ile şifrelenmiş erişim bilgileri (EBLG-01b).
model Baglanti {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  aile                 BaglantiAile
  saglayici            String
  sifreliConfig        String         @map("sifreli_config")
  durum                BaglantiDurumu @default(pasif)
  senkronImleci        String?        @map("senkron_imleci")
  kesintiSenkronImleci String?        @map("kesinti_senkron_imleci")
  sonSenkronTarihi     DateTime?      @map("son_senkron_tarihi")
  sonSenkronHatasi     String?        @map("son_senkron_hatasi")
  /// KSB-15: worker'ın otomatik çekim aralığı (dk); 0 = kapalı. Yalnız banka (Vomsis) bağlantısında kullanılır.
  otomatikSenkronDk    Int            @default(60) @map("otomatik_senkron_dk")
  /// KSB-15: son çekim denemesi (başarılı ya da değil); aralık buradan sayılır.
  sonSenkronDenemesi   DateTime?      @map("son_senkron_denemesi")
  /// KSB-15: üst üste başarısız çekim sayısı; 3 olunca bildirim üretilir.
  ardisikHata          Int            @default(0) @map("ardisik_hata")
  /// KSB-15: sağlayıcı kimlik bilgisini reddetti; otomatik çekim durdu.
  otomatikDurduNedeni  String?        @map("otomatik_durdu_nedeni")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  pazaryeriSiparises   PazaryeriSiparis[]
  pazaryeriKesintileri PazaryeriKesinti[]
  posHesaplari         PosHesap[]
  bankaHesapEslemeleri BankaBaglantiHesap[]

  @@index([tenantId, aile])
  @@map("baglantilar")
}

/// Denetim izi (KLN-04) — uygulamadan salt-ekleme; güncelleme/silme yok.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  islem     String
  varlik    String
  varlikId  String?  @map("varlik_id")
  detay     Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// Kayıtlı rapor görünümleri (RPR-06): adlandırılmış filtre setleri.
/// Kişiseldir; firmaGeneli=true ise firmadaki tüm kullanıcılara görünür.
model RaporGorunumu {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  raporKod    String   @map("rapor_kod")
  ad          String
  girdi       Json
  firmaGeneli Boolean  @default(false) @map("firma_geneli")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  abonelikler RaporAboneligi[]

  @@unique([tenantId, userId, raporKod, ad])
  @@index([tenantId, raporKod])
  @@map("rapor_gorunumleri")
}

/// RPR-24: kayıtlı görünümün zamanlanmış e-posta aboneliği. Saat ve gün
/// Türkiye saatiyle; alıcılar yalnız firma kullanıcıları (her gönderimde
/// rapor yetkisi yeniden denetlenir).
/// RPR-28: kullanıcının favori ve son çalıştırdığı raporlar (kod listesi, en yeni önde).
/// F02: Cari başına tek açık takip. İtiraz takip nedenidir; mali bakiye üretmez.
model TahsilatTakibi {
  sozBaglari         TahsilatSozBaglantisi[]
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  cariId             String                  @map("cari_id") @db.Uuid
  sorumluUserId      String                  @map("sorumlu_user_id") @db.Uuid
  olusturanUserId    String                  @map("olusturan_user_id") @db.Uuid
  konu               String                  @db.VarChar(200)
  neden              String                  @default("tahsilat")
  durum              String                  @default("acik")
  sonrakiIslemTarihi DateTime?               @map("sonraki_islem_tarihi") @db.Date
  sonrakiIslem       String?                 @map("sonraki_islem") @db.VarChar(200)
  sonIslemGerekcesi  String?                 @map("son_islem_gerekcesi") @db.VarChar(2000)
  surum              Int                     @default(1)
  istekAnahtari      String                  @map("istek_anahtari") @db.Uuid
  girdiOzeti         String                  @map("girdi_ozeti") @db.VarChar(64)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @map("updated_at")
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  cari               CariHesap               @relation(fields: [cariId], references: [id])
  sorumlu            User                    @relation(fields: [sorumluUserId], references: [id])
  gorusmeler         TahsilatGorusmesi[]

  @@unique([tenantId, istekAnahtari])
  @@index([tenantId, durum, sonrakiIslemTarihi, id], map: "tahsilat_takipleri_durum_tarih_idx")
  @@index([tenantId, cariId])
  @@index([tenantId, sorumluUserId, sonrakiIslemTarihi], map: "tahsilat_takipleri_sorumlu_tarih_idx")
  @@map("tahsilat_takipleri")
}

model TahsilatGorusmesi {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  takipId       String         @map("takip_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  kanal         String
  gorusmeTarihi DateTime       @map("gorusme_tarihi") @db.Date
  not           String         @db.VarChar(2000)
  istekAnahtari String         @map("istek_anahtari") @db.Uuid
  girdiOzeti    String         @map("girdi_ozeti") @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at")
  takip         TahsilatTakibi @relation(fields: [takipId], references: [id])

  @@unique([tenantId, istekAnahtari])
  @@index([tenantId, takipId, createdAt])
  @@map("tahsilat_gorusmeleri")
}

/// F02: Bir söz/bir satış faturası/aynı döviz. Gerçekleşme güncel kaynaktan
/// türetilir; kayitDurumu mali gerçekleşme durumu değildir. Aktif tekilliği
/// migration'daki kısmi unique index ile korunur. Silme servisi yoktur.
model OdemeSozu {
  hatirlatma        OdemeSozuHatirlatma?
  takipBaglantisi   TahsilatSozBaglantisi?
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  cariId            String                 @map("cari_id") @db.Uuid
  faturaId          String                 @map("fatura_id") @db.Uuid
  dovizCinsi        DovizCinsi             @map("doviz_cinsi")
  tutar             Decimal                @db.Decimal(15, 2)
  sozTarihi         DateTime               @map("soz_tarihi") @db.Date
  verildigiZaman    DateTime               @default(now()) @map("verildigi_zaman")
  olusturanUserId   String                 @map("olusturan_user_id") @db.Uuid
  aciklama          String                 @db.VarChar(2000)
  kayitDurumu       String                 @default("aktif") @map("kayit_durumu")
  sonlandirmaNedeni String?                @map("sonlandirma_nedeni") @db.VarChar(2000)
  surum             Int                    @default(1)
  oncekiSozId       String?                @unique @map("onceki_soz_id") @db.Uuid
  istekAnahtari     String                 @map("istek_anahtari") @db.Uuid
  girdiOzeti        String                 @map("girdi_ozeti") @db.VarChar(64)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  cari      CariHesap  @relation(fields: [cariId], references: [id])
  fatura    Fatura     @relation(fields: [faturaId], references: [id])
  oncekiSoz OdemeSozu? @relation("SozRevizyonu", fields: [oncekiSozId], references: [id])
  yeniSoz   OdemeSozu? @relation("SozRevizyonu")

  @@unique([tenantId, id])
  @@unique([tenantId, istekAnahtari])
  @@index([tenantId, cariId, verildigiZaman])
  @@index([tenantId, faturaId])
  @@map("odeme_sozleri")
}

/// CARI-49: satış faturası kesinleşirken (kaynak "kesinlesme") ya da geriye dönük
/// (kaynak "geriye_donuk") kaydedilen tahmini gecikme. Gerçekleşen saklanmaz.
model FaturaGecikmeTahmini {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  faturaId          String   @unique @map("fatura_id") @db.Uuid
  cariId            String   @map("cari_id") @db.Uuid
  tahminGun         Int?     @map("tahmin_gun")
  guven             String?
  kapananBorcSayisi Int      @default(0) @map("kapanan_borc_sayisi")
  kaynak            String
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  fatura Fatura    @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  cari   CariHesap @relation(fields: [cariId], references: [id])

  @@index([tenantId, cariId])
  @@map("fatura_gecikme_tahminleri")
}

/// F02: Her söz için tek otomatik iş üretimi; kapalı takip yeniden açılmaz.
model TahsilatSozBaglantisi {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  sozId     String         @unique @map("soz_id") @db.Uuid
  takipId   String         @map("takip_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kalan     Decimal        @db.Decimal(15, 2)
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  soz       OdemeSozu      @relation(fields: [sozId], references: [id])
  takip     TahsilatTakibi @relation(fields: [takipId], references: [id])

  @@index([tenantId, takipId, createdAt])
  @@map("tahsilat_soz_baglantilari")
}

/// KSB-16: ödeme (ya da iade faturası) ile fatura arasındaki kapama. Tutar
/// kapanan faturanın dövizindedir; tam olarak bir kaynak taşır (veritabanı
/// kısıtı). `otomatik` kayıtlar vadeye göre denkleştirmenin ürünüdür ve her
/// denkleştirmede yeniden hesaplanır; elle olanlar korunur.
model FirsatKapamaPayi {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  cariId          String   @map("cari_id") @db.Uuid
  firsatId        String   @map("firsat_id") @db.Uuid
  faturaId        String   @map("fatura_id") @db.Uuid
  kapamaId        String   @map("kapama_id") @db.Uuid
  surum           Int
  tutar           Decimal  @db.Decimal(15, 2)
  kaynakOzeti     String   @map("kaynak_ozeti") @db.VarChar(64)
  kanitOzeti      String   @map("kanit_ozeti") @db.VarChar(64)
  istekAnahtari   String   @map("istek_anahtari") @db.Uuid
  girdiOzeti      String   @map("girdi_ozeti") @db.VarChar(64)
  gerekce         String   @db.VarChar(500)
  olusturanUserId String   @map("olusturan_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, istekAnahtari])
  @@unique([tenantId, kapamaId, firsatId, surum])
  @@index([tenantId, faturaId])
  @@map("firsat_kapama_paylari")
}

model FirsatIadePayi {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  cariId          String   @map("cari_id") @db.Uuid
  firsatId        String   @map("firsat_id") @db.Uuid
  faturaId        String   @map("fatura_id") @db.Uuid
  iadeFaturaId    String   @map("iade_fatura_id") @db.Uuid
  surum           Int
  matrah          Decimal  @db.Decimal(15, 2)
  kanitOzeti      String   @map("kanit_ozeti") @db.VarChar(64)
  istekAnahtari   String   @map("istek_anahtari") @db.Uuid
  girdiOzeti      String   @map("girdi_ozeti") @db.VarChar(64)
  gerekce         String   @db.VarChar(500)
  olusturanUserId String   @map("olusturan_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, istekAnahtari])
  @@unique([tenantId, faturaId, iadeFaturaId, firsatId, surum])
  @@index([tenantId, faturaId])
  @@index([tenantId, iadeFaturaId])
  @@map("firsat_iade_paylari")
}

model FaturaKapama {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  cariId              String   @map("cari_id") @db.Uuid
  faturaId            String   @map("fatura_id") @db.Uuid
  tutar               Decimal  @db.Decimal(15, 2)
  otomatik            Boolean  @default(true)
  kasaBankaHareketId  String?  @map("kasa_banka_hareket_id") @db.Uuid
  krediKartiHareketId String?  @map("kredi_karti_hareket_id") @db.Uuid
  cekSenetId          String?  @map("cek_senet_id") @db.Uuid
  iadeFaturaId        String?  @map("iade_fatura_id") @db.Uuid
  /// KSB-20: farklı dövizli bağlamada ödemenin kendi dövizinde düşülen kısmı ve TL değeri; boşsa aynı döviz.
  kaynakTutari        Decimal? @map("kaynak_tutari") @db.Decimal(15, 2)
  kaynakTutariTry     Decimal? @map("kaynak_tutari_try") @db.Decimal(15, 2)
  /// KSB-22: elle bağlamanın kur farkı (fişe bağlı tek faturalı ödemede kasa hareketindeki alanlar kullanılır).
  kurFarkiFaturaId    String?  @map("kur_farki_fatura_id") @db.Uuid
  kurFarkiKapandi     Boolean  @default(false) @map("kur_farki_kapandi")
  /// KSB-25: alış–satış mahsubu kapaması (iki taraftaki faturaya ayrı satır).
  mahsupId            String?  @map("mahsup_id") @db.Uuid
  /// KSB-29: kur farkı faturasını kapatan "kur farkı karşılığı" cari hareketi.
  cariHareketId       String?  @map("cari_hareket_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  cari              CariHesap          @relation(fields: [cariId], references: [id], onDelete: Cascade)
  fatura            Fatura             @relation("KapananFatura", fields: [faturaId], references: [id], onDelete: Cascade)
  kasaBankaHareket  KasaBankaHareket?  @relation(fields: [kasaBankaHareketId], references: [id], onDelete: Cascade)
  krediKartiHareket KrediKartiHareket? @relation(fields: [krediKartiHareketId], references: [id], onDelete: Cascade)
  cekSenet          CekSenet?          @relation(fields: [cekSenetId], references: [id], onDelete: Cascade)
  iadeFatura        Fatura?            @relation("IadeKaynagi", fields: [iadeFaturaId], references: [id], onDelete: Cascade)
  mahsup            CariMahsup?        @relation(fields: [mahsupId], references: [id], onDelete: Cascade)
  cariHareket       CariHareket?       @relation(fields: [cariHareketId], references: [id], onDelete: Cascade)
  /// KSB-22/26: kalemin faturalandığı (biz) ya da eşleştiği (gelen) kur farkı faturası.
  kurFarkiFatura    Fatura?            @relation("KapamaKurFarkiFaturasi", fields: [kurFarkiFaturaId], references: [id], onDelete: SetNull)

  @@index([tenantId, faturaId])
  @@index([tenantId, cariId])
  @@index([kasaBankaHareketId])
  @@index([krediKartiHareketId])
  @@index([cekSenetId])
  @@index([iadeFaturaId])
  @@index([mahsupId])
  @@index([cariHareketId])
  @@map("fatura_kapamalari")
}

/// KSB-25: aynı carinin alış ve satış faturalarının birbirine karşı mahsubu. Geri alınan kayıt iz için kalır.
model CariMahsup {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  cariId          String    @map("cari_id") @db.Uuid
  tarih           DateTime  @db.Date
  dovizCinsi      String    @map("doviz_cinsi") @db.VarChar(3)
  tutar           Decimal   @db.Decimal(15, 2)
  aciklama        String?   @db.VarChar(500)
  otomatik        Boolean   @default(false)
  olusturanUserId String?   @map("olusturan_user_id") @db.Uuid
  geriAlindiAt    DateTime? @map("geri_alindi_at")
  geriAlanUserId  String?   @map("geri_alan_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cari      CariHesap      @relation(fields: [cariId], references: [id], onDelete: Cascade)
  olusturan User?          @relation("MahsupOlusturan", fields: [olusturanUserId], references: [id], onDelete: SetNull)
  geriAlan  User?          @relation("MahsupGeriAlan", fields: [geriAlanUserId], references: [id], onDelete: SetNull)
  kapamalar FaturaKapama[]

  @@index([tenantId, cariId, tarih])
  @@map("cari_mahsuplari")
}

model RaporTercihi {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  favoriler        String[]
  sonKullanilanlar String[] @map("son_kullanilanlar")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@map("rapor_tercihleri")
}

model RaporAboneligi {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Kuran kullanıcı; rapor onun rolüyle çalışır, yetkisini kaybederse abonelik duraklar.
  userId          String    @map("user_id") @db.Uuid
  gorunumId       String    @map("gorunum_id") @db.Uuid
  /// gunluk | haftalik | aylik
  siklik          String
  /// Haftalıkta 1 (Pazartesi)…7, aylıkta 1…28; günlükte boş.
  gun             Int?
  /// "HH:mm", Türkiye saati.
  saat            String
  /// dun | gecen_hafta | gecen_ay | bu_ay | bu_yil | gorunum (görünümdeki sabit dönem)
  donem           String
  /// excel | pdf | ikisi
  bicim           String
  bosGonder       Boolean   @default(false) @map("bos_gonder")
  aliciIdler      String[]  @map("alici_idler") @db.Uuid
  aktif           Boolean   @default(true)
  sonrakiGonderim DateTime  @map("sonraki_gonderim")
  sonGonderim     DateTime? @map("son_gonderim")
  /// gonderildi | bos_atlandi | basarisiz | duraklatildi
  sonDurum        String?   @map("son_durum")
  sonHata         String?   @map("son_hata")
  denemeSayisi    Int       @default(0) @map("deneme_sayisi")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  gorunum RaporGorunumu @relation(fields: [gorunumId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([aktif, sonrakiGonderim])
  @@map("rapor_abonelikleri")
}

// ─── 3. Aşama: Cari + Stok ───────────────────────────────────────────────

enum CariTip {
  musteri
  tedarikci
  her_ikisi
  personel
  ortak
  diger
}

enum UretimCiktiTip {
  yan_urun
  ortak_urun
}

/// Yan/ortak ürünün üretim maliyetinden alacağı pay; reçete sürümü başına seçilir.
enum YanUrunMaliyetYontemi {
  sifir
  sabit_deger
  satis_degeri
}

