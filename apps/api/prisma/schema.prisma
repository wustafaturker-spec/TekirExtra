  /// ENT-07: OT2026-000001; banka açıklamasına referans olarak yazılır.
  no                String?
  bankaHesapId      String                  @map("banka_hesap_id") @db.Uuid
  cariId            String?                 @map("cari_id") @db.Uuid
  cariBankaHesapId  String?                 @map("cari_banka_hesap_id") @db.Uuid
  /// İstenen ödeme (valör) tarihi.
  odemeTarihi       DateTime                @default(now()) @map("odeme_tarihi") @db.Date
  paketId           String?                 @map("paket_id") @db.Uuid
  gerceklesmeTarihi DateTime?               @map("gerceklesme_tarihi") @db.Date
  aliciUnvan        String                  @map("alici_unvan")
  aliciIban         String                  @map("alici_iban")
  tutar             Decimal                 @db.Decimal(15, 2)
  dovizCinsi        DovizCinsi              @map("doviz_cinsi")
  aciklama          String
  durum             BankaOdemeTalimatDurumu @default(onay_bekliyor)
  olusturanUserId   String                  @map("olusturan_user_id") @db.Uuid
  onaylayanUserId   String?                 @map("onaylayan_user_id") @db.Uuid
  onayZamani        DateTime?               @map("onay_zamani")
  saglayiciRef      String?                 @map("saglayici_ref")
  hataMesaji        String?                 @map("hata_mesaji")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankaHesap BankaHesap                 @relation(fields: [bankaHesapId], references: [id])
  olusturan  User                       @relation("TalimatOlusturan", fields: [olusturanUserId], references: [id])
  onaylayan  User?                      @relation("TalimatOnaylayan", fields: [onaylayanUserId], references: [id])
  cari       CariHesap?                 @relation(fields: [cariId], references: [id])
  paket      OdemePaketi?               @relation(fields: [paketId], references: [id])
  faturalar  BankaOdemeTalimatiFatura[]

  @@unique([tenantId, no])
  @@index([tenantId, durum, createdAt])
  @@map("banka_odeme_talimatlari")
