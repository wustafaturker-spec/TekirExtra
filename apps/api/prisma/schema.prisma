  odendi
  kismen_mahsup
  mahsup_edildi
  reddedildi
  iptal
}

enum PersonelIzinTalepDurum {
  talep
  onaylandi
  reddedildi
  iptal
}

enum PersonelIzinBakiyeHareketTipi {
  devir
  hak_edis
  kullanim
  iade
  duzeltme_artis
  duzeltme_azalis
}

enum PersonelBordroKalemTipi {
