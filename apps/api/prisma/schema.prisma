}

enum BankaOdemeTalimatDurumu {
  onay_bekliyor
  onaylandi
  gonderildi
  basarisiz
  iptal
}

model BankaOdemeTalimati {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  bankaHesapId    String                  @map("banka_hesap_id") @db.Uuid
