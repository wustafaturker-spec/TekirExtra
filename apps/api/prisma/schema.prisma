  cari CariHesap @relation(fields: [cariId], references: [id], onDelete: Cascade)

  @@index([tenantId, cariId])
  @@map("cari_banka_hesaplari")
}

/// Cari etiketleri (CARI-11): bayi, perakende, VIP vb.
model CariEtiket {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ad       String
  renk     String?

  atamalar CariEtiketAtama[]

  @@unique([tenantId, ad])
  @@map("cari_etiketleri")
}

model CariEtiketAtama {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  cariId   String @map("cari_id") @db.Uuid
  etiketId String @map("etiket_id") @db.Uuid

  cari   CariHesap  @relation(fields: [cariId], references: [id], onDelete: Cascade)
  etiket CariEtiket @relation(fields: [etiketId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cariId, etiketId])
  @@map("cari_etiket_atamalari")
}

/// Bakiye her zaman hareketlerden türetilir (MIMARI §7). Kaynak belge
/// bağlantısı kaynakTur+kaynakRef ile (fatura/kasa 4-5. aşamada bağlanır).
/// CARI-39: müşteriden alınan teminatlar. Geçerli olanlar (aktif, başlamış,
/// süresi dolmamış) güncel döviz satış kuruyla TL'ye çevrilip risk limitine eklenir.
model CariTeminat {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  cariId          String     @map("cari_id") @db.Uuid
  /// teminat_mektubu | ipotek | dbs | nakit | kefalet | diger
  tur             String
  tutar           Decimal    @db.Decimal(15, 2)
  dovizCinsi      DovizCinsi @default(TRY) @map("doviz_cinsi")
  /// Mektubu veren banka, DBS bankası ya da kefil adı.
  banka           String?
  /// Mektup no, tapu/ada-parsel, DBS sözleşme no vb.
  belgeNo         String?    @map("belge_no")
  baslangicTarihi DateTime?  @map("baslangic_tarihi") @db.Date
  /// Boşsa süresiz.
  bitisTarihi     DateTime?  @map("bitis_tarihi") @db.Date
  aciklama        String?
  /// aktif | iade_edildi
  durum           String     @default("aktif")
  iadeTarihi      DateTime?  @map("iade_tarihi") @db.Date
  userId          String?    @map("user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  cari CariHesap @relation(fields: [cariId], references: [id])

  @@index([tenantId, cariId])
  @@index([tenantId, durum, bitisTarihi])
  @@map("cari_teminatlari")
}

model CariHareket {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  cariId         String         @map("cari_id") @db.Uuid
  tip            CariHareketTip
  tutar          Decimal        @db.Decimal(15, 2)
  dovizCinsi     DovizCinsi     @default(TRY) @map("doviz_cinsi")
  kur            Decimal        @default(1) @db.Decimal(15, 6)
  tutarTry       Decimal        @map("tutar_try") @db.Decimal(15, 2)
  tarih          DateTime       @db.Date
  vadeTarihi     DateTime?      @map("vade_tarihi") @db.Date
  aciklama       String?
  kaynakTur      String         @default("manuel") @map("kaynak_tur")
  kaynakRef      String?        @map("kaynak_ref")
  /// CARI-28: elle düzeltmenin muhasebe karşı hesabı; boşsa 679/689 eşlemesi.
  karsiHesapKodu String?        @map("karsi_hesap_kodu")
  createdAt      DateTime       @default(now()) @map("created_at")

  kapamalar FaturaKapama[]
  cari CariHesap @relation(fields: [cariId], references: [id])

  @@index([tenantId, cariId, tarih])
  @@map("cari_hareketler")
}

model StokKategori {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ad       String
  ustId    String? @map("ust_id") @db.Uuid

  ust     StokKategori?  @relation("KategoriAgaci", fields: [ustId], references: [id])
  altlar  StokKategori[] @relation("KategoriAgaci")
  stoklar StokKart[]

  @@index([tenantId])
  @@map("stok_kategorileri")
}

/// mevcutMiktar/ortalamaMaliyet hareket servisinde transaction içinde
/// güncellenir (STK-08 ağırlıklı ortalama); hareketler değişmez kayıttır.
model StokKart {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  kod              String
  ad               String
  kisaAd           String?       @map("kisa_ad")
  aciklama         String?
  tip              StokTip       @default(urun)
  marka            String?
  model            String?
  mensei           String?
  gtipKodu         String?       @map("gtip_kodu")
  /// Elektrikli araç şarj faturası (EBLG-71): kart satıra düştüğünde belgenin
  /// tipi buradan türer — `sarj` (şarj hizmeti) ya da `sarjanlik` (ünite).
  sarjTuru         String?       @map("sarj_turu")
  ureticiUrunKodu  String?       @map("uretici_urun_kodu")
  /// STK-41: dil başına ürün adı/açıklaması ({ en: { ad, aciklama } }); belge o dilde basılırken kullanılır.
  yabanciAdlar     Json?         @map("yabanci_adlar")
  /// Veritabanının ürettiği aksansız arama kolonu (20260904200000_aksansiz_arama).
  /// GENERATED ALWAYS olduğu için yalnız okunur; Prisma ile yazılmaz.
  aramaNormal      String?       @map("arama_normal")
  barkod           String?
  kategoriId       String?       @map("kategori_id") @db.Uuid
  anaBirim         String        @default("adet") @map("ana_birim")
  kdvOrani         Decimal       @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  alisFiyati       Decimal?      @map("alis_fiyati") @db.Decimal(15, 4)
  satisFiyati      Decimal?      @map("satis_fiyati") @db.Decimal(15, 4)
  alisFiyatiDoviz  DovizCinsi    @default(TRY) @map("alis_fiyati_doviz")
  satisFiyatiDoviz DovizCinsi    @default(TRY) @map("satis_fiyati_doviz")
  kritikSeviye     Decimal?      @map("kritik_seviye") @db.Decimal(15, 3)
  minStok          Decimal?      @map("min_stok") @db.Decimal(15, 3)
  maksStok         Decimal?      @map("maks_stok") @db.Decimal(15, 3)
  guvenlikStogu    Decimal?      @map("guvenlik_stogu") @db.Decimal(15, 3)
  tedarikSuresiGun Int?          @map("tedarik_suresi_gun")
  gorselUrl        String?       @map("gorsel_url")
  mevcutMiktar     Decimal       @default(0) @map("mevcut_miktar") @db.Decimal(15, 3)
  /// FTR-12: açık satış siparişlerinin rezervi; kullanılabilir = mevcut − rezerve
  rezerveMiktar    Decimal       @default(0) @map("rezerve_miktar") @db.Decimal(15, 3)
  /// FTR-12: açık alış siparişlerinden beklenen (yoldaki) miktar
  yoldakiMiktar    Decimal       @default(0) @map("yoldaki_miktar") @db.Decimal(15, 3)
  ortalamaMaliyet  Decimal       @default(0) @map("ortalama_maliyet") @db.Decimal(15, 4)
  aktif            Boolean       @default(true)
  takipTipi        StokTakipTipi @default(yok) @map("takip_tipi")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  kategori                StokKategori?            @relation(fields: [kategoriId], references: [id])
  birimler                StokBirim[]
  depoBakiyeleri          StokDepoBakiye[]
  transferKalemleri       DepoTransferKalem[]
  barkodlar               StokBarkod[]
  tedarikciler            StokTedarikci[]
  hareketler              StokHareket[]
  fiyatlar                FiyatListesiKalem[]
  stokFiyatlari           StokFiyat[]
  faturaSatirs            FaturaSatir[]
  belgeSatirlari          BelgeSatir[]
  satinAlmaTalepKalemleri SatinAlmaTalepKalemi[]
  varyantlar              StokVaryant[]
  partiler                StokParti[]
  pazaryeriSatirlari      PazaryeriSiparisSatiri[]
  urunReceteleri          UrunRecetesi[]           @relation("MamulRecetesi")
  receteMalzemeleri       UrunRecetesiKalem[]      @relation("ReceteMalzemesi")
  uretimEmirleri          UretimEmri[]             @relation("UretilecekStok")
  uretimMalzemeleri       UretimEmriKalem[]        @relation("UretimMalzemesi")
  receteCiktilari         UrunRecetesiCikti[]      @relation("ReceteCiktiStok")
  uretimCiktiStoklari     UretimEmriCikti[]        @relation("UretimCiktiStok")

  maliyetDagitimPaylari MaliyetDagitimPayi[]

  ekVergiler StokEkVergi[]

  @@unique([tenantId, kod])
  @@index([tenantId, ad])
  @@map("stok_kartlari")
}

model StokFiyat {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  stokId     String     @map("stok_id") @db.Uuid
  varyantId  String?    @map("varyant_id") @db.Uuid
  tip        FiyatTipi
  dovizCinsi DovizCinsi @default(TRY) @map("doviz_cinsi")
  tutar      Decimal    @db.Decimal(15, 4)
  aktif      Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  stok       StokKart   @relation(fields: [stokId], references: [id], onDelete: Cascade)

  /// Bir ürün/varyant ve fiyat tipi için yalnızca tek para birimli fiyat vardır.
  @@unique([tenantId, stokId, varyantId, tip])
  @@index([tenantId, stokId, tip])
  @@map("stok_fiyatlari")
}

enum FiyatTipi {
  alis
  satis
}

enum StokTakipTipi {
  yok
  lot
  seri
}

model StokParti {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  stokId            String    @map("stok_id") @db.Uuid
  varyantId         String?   @map("varyant_id") @db.Uuid
  depoId            String    @map("depo_id") @db.Uuid
  lotNo             String    @map("lot_no")
  seriNo            String?   @map("seri_no")
  sonKullanmaTarihi DateTime? @map("son_kullanma_tarihi") @db.Date
  uretimTarihi      DateTime? @map("uretim_tarihi") @db.Date
  ilkMiktar         Decimal   @map("ilk_miktar") @db.Decimal(15, 3)
  kalanMiktar       Decimal   @map("kalan_miktar") @db.Decimal(15, 3)
  anahtar           String
  createdAt         DateTime  @default(now()) @map("created_at")

  stok       StokKart           @relation(fields: [stokId], references: [id], onDelete: Cascade)
  varyant    StokVaryant?       @relation(fields: [varyantId], references: [id])
  depo       Depo               @relation(fields: [depoId], references: [id])
  hareketler StokHareketParti[]

  @@unique([tenantId, anahtar])
  @@unique([tenantId, seriNo])
  @@index([tenantId, stokId, varyantId, depoId, sonKullanmaTarihi])
  @@map("stok_partileri")
}

model StokHareketParti {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  hareketId String  @map("hareket_id") @db.Uuid
  partiId   String  @map("parti_id") @db.Uuid
  miktar    Decimal @db.Decimal(15, 3)

  hareket StokHareket @relation(fields: [hareketId], references: [id], onDelete: Cascade)
  parti   StokParti   @relation(fields: [partiId], references: [id])

  @@index([tenantId, hareketId])
  @@map("stok_hareket_partileri")
}

model StokVaryant {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  stokId        String   @map("stok_id") @db.Uuid
  kod           String
  ad            String
  nitelikler    Json
  barkod        String?
  alisFiyati    Decimal? @map("alis_fiyati") @db.Decimal(15, 4)
  satisFiyati   Decimal? @map("satis_fiyati") @db.Decimal(15, 4)
  mevcutMiktar  Decimal  @default(0) @map("mevcut_miktar") @db.Decimal(15, 3)
  rezerveMiktar Decimal  @default(0) @map("rezerve_miktar") @db.Decimal(15, 3)
  yoldakiMiktar Decimal  @default(0) @map("yoldaki_miktar") @db.Decimal(15, 3)
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stok               StokKart                 @relation(fields: [stokId], references: [id], onDelete: Cascade)
  depoBakiyeleri     StokVaryantDepoBakiye[]
  hareketler         StokHareket[]
  faturaSatirlari    FaturaSatir[]
  belgeSatirlari     BelgeSatir[]
  partiler           StokParti[]
  transferKalemleri  DepoTransferKalem[]
  pazaryeriSatirlari PazaryeriSiparisSatiri[]
  receteMalzemeleri  UrunRecetesiKalem[]
  uretimMalzemeleri  UretimEmriKalem[]
  receteCiktilari    UrunRecetesiCikti[]
  uretimCiktilari    UretimEmriCikti[]
  uretimEmirleri     UretimEmri[]
  urunReceteleri     UrunRecetesi[]
  tedarikciKodlari   StokTedarikciVaryant[]
  sayimKalemleri     SayimKalem[]

  @@unique([tenantId, kod])
  @@unique([tenantId, barkod])
  @@index([tenantId, stokId])
  @@map("stok_varyantlari")
}

model StokVaryantDepoBakiye {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  varyantId     String  @map("varyant_id") @db.Uuid
  depoId        String  @map("depo_id") @db.Uuid
  mevcutMiktar  Decimal @default(0) @map("mevcut_miktar") @db.Decimal(15, 3)
  rezerveMiktar Decimal @default(0) @map("rezerve_miktar") @db.Decimal(15, 3)
  yoldakiMiktar Decimal @default(0) @map("yoldaki_miktar") @db.Decimal(15, 3)

  varyant StokVaryant @relation(fields: [varyantId], references: [id], onDelete: Cascade)
  depo    Depo        @relation(fields: [depoId], references: [id])

  @@unique([tenantId, varyantId, depoId])
  @@index([tenantId, depoId])
  @@map("stok_varyant_depo_bakiyeleri")
}

/// Çoklu barkod (STK-15): birim ve birime özgü satış fiyatı taşıyabilir.
model StokBarkod {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stokId      String   @map("stok_id") @db.Uuid
  barkod      String
  /// null = ana birim; dolu ise StokBirim adlarından biri
  birim       String?
  satisFiyati Decimal? @map("satis_fiyati") @db.Decimal(15, 4)

  stok StokKart @relation(fields: [stokId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barkod])
  @@index([tenantId, stokId])
  @@map("stok_barkodlari")
}

/// Ürün-tedarikçi ilişkisi (STK-18); sipariş önerisini besler (STK-16).
model StokTedarikci {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  stokId            String     @map("stok_id") @db.Uuid
  cariId            String     @map("cari_id") @db.Uuid
  tedarikciUrunKodu String?    @map("tedarikci_urun_kodu")
  alisFiyati        Decimal?   @map("alis_fiyati") @db.Decimal(15, 4)
  dovizCinsi        DovizCinsi @default(TRY) @map("doviz_cinsi")
  tedarikSuresiGun  Int?       @map("tedarik_suresi_gun")
  varsayilan        Boolean    @default(false)

  stok StokKart  @relation(fields: [stokId], references: [id], onDelete: Cascade)
  cari CariHesap @relation(fields: [cariId], references: [id])

  varyantKodlari StokTedarikciVaryant[]

  @@unique([tenantId, stokId, cariId])
  @@index([tenantId, cariId])
  @@map("stok_tedarikcileri")
}

/// Tedarikçinin varyant başına ürün kodu (STK-23). Fiyat ve tedarik süresi
/// tedarikçi satırında kalır; kod gelen belgede satırı doğrudan varyanta düşürür.
model StokTedarikciVaryant {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  stokTedarikciId   String @map("stok_tedarikci_id") @db.Uuid
  varyantId         String @map("varyant_id") @db.Uuid
  tedarikciUrunKodu String @map("tedarikci_urun_kodu")

  stokTedarikci StokTedarikci @relation(fields: [stokTedarikciId], references: [id], onDelete: Cascade)
  varyant       StokVaryant   @relation(fields: [varyantId], references: [id], onDelete: Cascade)

  @@unique([stokTedarikciId, varyantId])
  @@index([tenantId, tedarikciUrunKodu])
  @@map("stok_tedarikci_varyant_kodlari")
}

/// Ek birimler (STK-10): 1 <ad> = <katsayi> ana birim (ör. 1 koli = 12 adet).
model StokBirim {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  stokId   String  @map("stok_id") @db.Uuid
  ad       String
  katsayi  Decimal @db.Decimal(15, 6)

  stok StokKart @relation(fields: [stokId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stokId, ad])
  @@map("stok_birimleri")
}

model FiyatListesi {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  ad         String
  dovizCinsi DovizCinsi @default(TRY) @map("doviz_cinsi")
  aktif      Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")

  kalemler FiyatListesiKalem[]
  cariler  CariHesap[]

  @@unique([tenantId, ad])
  @@map("fiyat_listeleri")
}

model FiyatListesiKalem {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  listeId  String  @map("liste_id") @db.Uuid
  stokId   String  @map("stok_id") @db.Uuid
  fiyat    Decimal @db.Decimal(15, 4)

  liste FiyatListesi @relation(fields: [listeId], references: [id], onDelete: Cascade)
  stok  StokKart     @relation(fields: [stokId], references: [id])

  @@unique([tenantId, listeId, stokId])
  @@map("fiyat_listesi_kalemleri")
}

/// miktar her zaman ana birim cinsindendir; girilen birim/miktar ayrı saklanır.
/// maliyet: hareket anındaki birim maliyet (girişte alış fiyatı, çıkışta ortalama).
model StokHareket {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  stokId        String         @map("stok_id") @db.Uuid
  varyantId     String?        @map("varyant_id") @db.Uuid
  /// STK-07: hareketin gerçekleştiği depo
  depoId        String         @map("depo_id") @db.Uuid
  tip           StokHareketTip
  miktar        Decimal        @db.Decimal(15, 3)
  girilenBirim  String         @map("girilen_birim")
  girilenMiktar Decimal        @map("girilen_miktar") @db.Decimal(15, 3)
  maliyet       Decimal        @default(0) @db.Decimal(15, 4)
  tarih         DateTime       @db.Date
  aciklama      String?
  kaynakTur     String         @default("manuel") @map("kaynak_tur")
  kaynakRef     String?        @map("kaynak_ref")
  createdAt     DateTime       @default(now()) @map("created_at")

  stok                StokKart              @relation(fields: [stokId], references: [id])
  depo                Depo                  @relation(fields: [depoId], references: [id])
  varyant             StokVaryant?          @relation(fields: [varyantId], references: [id])
  partiler            StokHareketParti[]
  maliyetDuzeltmeleri StokMaliyetDuzeltme[]

  @@index([tenantId, stokId, tarih])
  @@index([tenantId, depoId, tarih])
  @@map("stok_hareketleri")
}

/// Stok sayımı (STK-06/20): taslak oluşturulur, onayda farklar
/// sayim_duzeltme hareketi olarak işlenir.
model Sayim {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  /// STK-07: bir sayım tek depoyu kapsar
  depoId          String     @map("depo_id") @db.Uuid
  tarih           DateTime   @db.Date
  aciklama        String?
  durum           SayimDurum @default(taslak)
  onaylayanUserId String?    @map("onaylayan_user_id") @db.Uuid
  onayZamani      DateTime?  @map("onay_zamani")
  createdAt       DateTime   @default(now()) @map("created_at")

  depo     Depo         @relation(fields: [depoId], references: [id])
  kalemler SayimKalem[]

  @@index([tenantId, depoId])
  @@map("sayimlar")
}

model SayimKalem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  sayimId      String  @map("sayim_id") @db.Uuid
  stokId       String  @map("stok_id") @db.Uuid
  /// STK-30: varyantlı kartta zorunlu.
  varyantId    String? @map("varyant_id") @db.Uuid
  sistemMiktar Decimal @map("sistem_miktar") @db.Decimal(15, 3)
  fiiliMiktar  Decimal @map("fiili_miktar") @db.Decimal(15, 3)
  /// STK-31: lot/seri takipli üründe parti satırları [{ lotNo, seriNo, sonKullanmaTarihi, sistemMiktar, fiiliMiktar }].
  partiler     Json?

  sayim   Sayim        @relation(fields: [sayimId], references: [id], onDelete: Cascade)
  varyant StokVaryant? @relation(fields: [varyantId], references: [id])

  @@map("sayim_kalemleri")
}

// ─── Çoklu depo (STK-07) ────────────────────────────────────────────────────

/// Kiracıda her zaman en az bir depo bulunur (göçte "Merkez Depo" açılır).
/// Tek depo varsa arayüz depo seçimini göstermez, varsayılan depo kullanılır.
model Depo {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  kod        String
  ad         String
  adres      String?
  /// EBLG-87: e-İrsaliyede boşaltma adresi olarak kullanılır; GİB il, ilçe
  /// ve posta kodunu ayrı alanlarda ister.
  il         String?
  ilce       String?
  postaKodu  String?  @map("posta_kodu")
  sorumlu    String?
  /// Depo seçilmeyen akışların (ve arayüzün) kullandığı depo; kiracıda tek olur
  varsayilan Boolean  @default(false)
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bakiyeler              StokDepoBakiye[]
  varyantBakiyeleri      StokVaryantDepoBakiye[]
  partiler               StokParti[]
  hareketler             StokHareket[]
  uretimRezervasyonlari  UretimMalzemeRezervasyon[]
  ihtiyacUretimTalepleri IhtiyacUretimTalebi[]
  sayimlar               Sayim[]
  faturalar              Fatura[]
  belgeler               Belge[]
  cikisTransferleri      DepoTransfer[]             @relation("TransferKaynak")
  girisTransferleri      DepoTransfer[]             @relation("TransferHedef")
  uretimEmirleri         UretimEmri[]
  kaliteKontrolleri      UretimKaliteKontrol[]
  uretimSarfDuzeltmeleri UretimSarfDuzeltme[]

  @@unique([tenantId, kod])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("depolar")
}

/// Depo bazlı miktarlar (STK-07). StokKart üzerindeki mevcut/rezerve/yoldaki
/// alanları bu satırların toplamıdır ve birlikte güncellenir.
/// Ortalama maliyet firma genelinde tek tutulur (S-01) — burada yer almaz.
model StokDepoBakiye {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  stokId        String  @map("stok_id") @db.Uuid
  depoId        String  @map("depo_id") @db.Uuid
  mevcutMiktar  Decimal @default(0) @map("mevcut_miktar") @db.Decimal(15, 3)
  rezerveMiktar Decimal @default(0) @map("rezerve_miktar") @db.Decimal(15, 3)
  yoldakiMiktar Decimal @default(0) @map("yoldaki_miktar") @db.Decimal(15, 3)

  stok StokKart @relation(fields: [stokId], references: [id], onDelete: Cascade)
  depo Depo     @relation(fields: [depoId], references: [id])

  @@unique([tenantId, stokId, depoId])
  @@index([tenantId, depoId])
  @@map("stok_depo_bakiyeleri")
}

/// Stok kartına bağlı, tanımlanması isteğe bağlı ürün reçetesi.
model UrunRecetesi {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  stokId                String                @map("stok_id") @db.Uuid
  surum                 Int                   @default(1)
  durum                 ReceteDurum           @default(taslak)
  ciktiMiktari          Decimal               @default(1) @map("cikti_miktari") @db.Decimal(15, 3)
  aciklama              String?
  aktif                 Boolean               @default(true)
  yururlukBaslangic     DateTime?             @map("yururluk_baslangic") @db.Date
  yururlukBitis         DateTime?             @map("yururluk_bitis") @db.Date
  onaylayanUserId       String?               @map("onaylayan_user_id") @db.Uuid
  onayZamani            DateTime?             @map("onay_zamani")
  degisiklikNedeni      String?               @map("degisiklik_nedeni")
  kaliteKontrolGerekli  Boolean               @default(false) @map("kalite_kontrol_gerekli")
  /// Sürümü kaydeden kullanıcı; kendi hazırladığı sürümü onaylayamaz.
  olusturanUserId       String?               @map("olusturan_user_id") @db.Uuid
  yanUrunMaliyetYontemi YanUrunMaliyetYontemi @default(sifir) @map("yan_urun_maliyet_yontemi")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  stok           StokKart            @relation("MamulRecetesi", fields: [stokId], references: [id], onDelete: Cascade)
  /// Boşsa genel reçete; doluysa yalnız bu varyantın üretiminde kullanılır.
  varyantId      String?             @map("varyant_id") @db.Uuid
  varyant        StokVaryant?        @relation(fields: [varyantId], references: [id])
  kalemler       UrunRecetesiKalem[]
  uretimEmirleri UretimEmri[]
  operasyonlar   ReceteOperasyonu[]
  ciktilar       UrunRecetesiCikti[]
  giderler       ReceteGider[]

  @@unique([tenantId, stokId, surum])
  @@index([tenantId, stokId, varyantId])
  @@index([tenantId])
  @@map("urun_receteleri")
}

model UrunRecetesiCikti {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  receteId      String            @map("recete_id") @db.Uuid
  stokId        String            @map("stok_id") @db.Uuid
  varyantId     String?           @map("varyant_id") @db.Uuid
  tip           UretimCiktiTip
  miktar        Decimal           @db.Decimal(15, 3)
  /// Sabit değer yönteminde çıktının birim maliyeti; ana ürün maliyetinden düşülür.
  birimMaliyet  Decimal?          @map("birim_maliyet") @db.Decimal(15, 4)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recete        UrunRecetesi      @relation(fields: [receteId], references: [id], onDelete: Cascade)
  stok          StokKart          @relation("ReceteCiktiStok", fields: [stokId], references: [id])
  varyant       StokVaryant?      @relation(fields: [varyantId], references: [id])
  emirCiktilari UretimEmriCikti[]

  @@unique([receteId, stokId, varyantId])
  @@index([tenantId, stokId])
  @@map("urun_recetesi_ciktilari")
}

model UrunRecetesiKalem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  receteId         String   @map("recete_id") @db.Uuid
  malzemeStokId    String   @map("malzeme_stok_id") @db.Uuid
  malzemeVaryantId String?  @map("malzeme_varyant_id") @db.Uuid
  /// Ana birim karşılığı; ton kartına mg girilebildiği için 12 basamak.
  miktar           Decimal  @db.Decimal(24, 12)
  /// Girilen birim (kartın ek birimi ya da aynı ölçü ailesinden, ör. kg kartında mg); boşsa ana birim.
  birim            String?
  /// `birim` cinsinden girilen miktar; ekranda bu gösterilir.
  girilenMiktar    Decimal? @map("girilen_miktar") @db.Decimal(20, 8)
  fireOrani        Decimal  @default(0) @map("fire_orani") @db.Decimal(10, 6)

  recete         UrunRecetesi @relation(fields: [receteId], references: [id], onDelete: Cascade)
  malzeme        StokKart     @relation("ReceteMalzemesi", fields: [malzemeStokId], references: [id])
  malzemeVaryant StokVaryant? @relation(fields: [malzemeVaryantId], references: [id])

  @@unique([receteId, malzemeStokId, malzemeVaryantId])
  @@index([tenantId, malzemeStokId])
  @@map("urun_recetesi_kalemleri")
}

model IsMerkezi {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  kod                  String
  ad                   String
  gunlukKapasiteDakika Int      @default(480) @map("gunluk_kapasite_dakika")
  verimlilikYuzdesi    Decimal  @default(100) @map("verimlilik_yuzdesi") @db.Decimal(5, 2)
  /// İşçilik + makine + genel gider; operasyon maliyeti bununla hesaplanır.
  saatlikMaliyet       Decimal  @default(0) @map("saatlik_maliyet") @db.Decimal(15, 4)
  iscilikSaatlik       Decimal  @default(0) @map("iscilik_saatlik") @db.Decimal(15, 4)
  makineSaatlik        Decimal  @default(0) @map("makine_saatlik") @db.Decimal(15, 4)
  genelGiderSaatlik    Decimal  @default(0) @map("genel_gider_saatlik") @db.Decimal(15, 4)
  aktif                Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receteOperasyonlari ReceteOperasyonu[]
  emirOperasyonlari   UretimEmriOperasyonu[]

  @@unique([tenantId, kod])
  @@index([tenantId, aktif])
  @@map("is_merkezleri")
}

model ReceteOperasyonu {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  receteId       String  @map("recete_id") @db.Uuid
  isMerkeziId    String  @map("is_merkezi_id") @db.Uuid
  sira           Int
  operasyonKodu  String  @map("operasyon_kodu")
  operasyonAdi   String  @map("operasyon_adi")
  hazirlikDakika Decimal @default(0) @map("hazirlik_dakika") @db.Decimal(10, 2)
  cevrimDakika   Decimal @default(0) @map("cevrim_dakika") @db.Decimal(10, 4)

  recete    UrunRecetesi @relation(fields: [receteId], references: [id], onDelete: Cascade)
  isMerkezi IsMerkezi    @relation(fields: [isMerkeziId], references: [id])

  @@unique([receteId, sira])
  @@index([tenantId, isMerkeziId])
  @@map("recete_operasyonlari")
}

model UretimEmri {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  no                   String
  stokId               String          @map("stok_id") @db.Uuid
  receteId             String?         @map("recete_id") @db.Uuid
  hedefDepoId          String          @map("hedef_depo_id") @db.Uuid
  planlananMiktar      Decimal         @map("planlanan_miktar") @db.Decimal(15, 3)
  uretilenMiktar       Decimal         @default(0) @map("uretilen_miktar") @db.Decimal(15, 3)
  hurdaMiktari         Decimal         @default(0) @map("hurda_miktari") @db.Decimal(15, 3)
  yenidenIslemeMiktari Decimal         @default(0) @map("yeniden_isleme_miktari") @db.Decimal(15, 3)
  toplamMaliyet        Decimal         @default(0) @map("toplam_maliyet") @db.Decimal(15, 4)
  planlananMaliyet     Decimal         @default(0) @map("planlanan_maliyet") @db.Decimal(15, 4)
  tarih                DateTime        @db.Date
  /// Emrin bitmesi gereken gün; gecikme bu tarihe göre ölçülür.
  planlananBitis       DateTime?       @map("planlanan_bitis") @db.Date
  aciklama             String?
  durum                UretimEmriDurum @default(taslak)
  tamamlanmaTarihi     DateTime?       @map("tamamlanma_tarihi")
  kaliteKontrolGerekli Boolean         @default(false) @map("kalite_kontrol_gerekli")
  satisSiparisSatirId  String?         @map("satis_siparis_satir_id") @db.Uuid
  /// Emir kalan miktar üretilmeden kapatıldıysa nedeni; boşsa emir tam üretildi.
  kapanisNedeni        String?         @map("kapanis_nedeni")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  stok               StokKart               @relation("UretilecekStok", fields: [stokId], references: [id])
  varyantId          String?                @map("varyant_id") @db.Uuid
  varyant            StokVaryant?           @relation(fields: [varyantId], references: [id])
  recete             UrunRecetesi?          @relation(fields: [receteId], references: [id], onDelete: Restrict)
  hedefDepo          Depo                   @relation(fields: [hedefDepoId], references: [id])
  kalemler           UretimEmriKalem[]
  bildirimler        UretimBildirimi[]
  operasyonlar       UretimEmriOperasyonu[]
  kaliteKontrolleri  UretimKaliteKontrol[]
  sarfDuzeltmeleri   UretimSarfDuzeltme[]
  satisSiparisSatiri BelgeSatir?            @relation(fields: [satisSiparisSatirId], references: [id], onDelete: SetNull)
  ciktilar           UretimEmriCikti[]
  giderler           UretimEmriGider[]

  @@unique([tenantId, no])
  @@index([tenantId, varyantId])
  @@index([tenantId, tarih])
  @@index([tenantId, receteId])
  @@index([tenantId, satisSiparisSatirId])
  @@map("uretim_emirleri")
}

model UretimEmriCikti {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  uretimEmriId    String            @map("uretim_emri_id") @db.Uuid
  receteCiktiId   String            @map("recete_cikti_id") @db.Uuid
  stokId          String            @map("stok_id") @db.Uuid
  varyantId       String?           @map("varyant_id") @db.Uuid
  tip             UretimCiktiTip
  planlananMiktar Decimal           @map("planlanan_miktar") @db.Decimal(15, 3)
  uretilenMiktar  Decimal           @default(0) @map("uretilen_miktar") @db.Decimal(15, 3)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uretimEmri      UretimEmri        @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  receteCikti     UrunRecetesiCikti @relation(fields: [receteCiktiId], references: [id])
  stok            StokKart          @relation("UretimCiktiStok", fields: [stokId], references: [id])
  varyant         StokVaryant?      @relation(fields: [varyantId], references: [id])

  @@unique([uretimEmriId, receteCiktiId])
  @@index([tenantId, stokId])
  @@map("uretim_emri_ciktilari")
}

model UretimEmriOperasyonu {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  uretimEmriId       String               @map("uretim_emri_id") @db.Uuid
  isMerkeziId        String               @map("is_merkezi_id") @db.Uuid
  sira               Int
  operasyonKodu      String               @map("operasyon_kodu")
  operasyonAdi       String               @map("operasyon_adi")
  planlananDakika    Decimal              @map("planlanan_dakika") @db.Decimal(12, 2)
  gerceklesenDakika  Decimal              @default(0) @map("gerceklesen_dakika") @db.Decimal(12, 2)
  saatlikMaliyet     Decimal              @default(0) @map("saatlik_maliyet") @db.Decimal(15, 4)
  /// Emir açılırken iş merkezinden kopyalanan kırılım (toplamı saatlikMaliyet).
  iscilikSaatlik     Decimal              @default(0) @map("iscilik_saatlik") @db.Decimal(15, 4)
  makineSaatlik      Decimal              @default(0) @map("makine_saatlik") @db.Decimal(15, 4)
  genelGiderSaatlik  Decimal              @default(0) @map("genel_gider_saatlik") @db.Decimal(15, 4)
  planlananBaslangic DateTime             @map("planlanan_baslangic")
  planlananBitis     DateTime             @map("planlanan_bitis")
  fiiliBaslangic     DateTime?            @map("fiili_baslangic")
  fiiliBitis         DateTime?            @map("fiili_bitis")
  durum              UretimOperasyonDurum @default(planlandi)
  vardiyaId          String?              @map("vardiya_id") @db.Uuid
  operatorId         String?              @map("operator_id") @db.Uuid

  uretimEmri UretimEmri     @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  isMerkezi  IsMerkezi      @relation(fields: [isMerkeziId], references: [id])
  vardiya    UretimVardiya? @relation(fields: [vardiyaId], references: [id])
  operator   User?          @relation("UretimOperatoru", fields: [operatorId], references: [id])
  duruslar   UretimDurus[]

  @@unique([uretimEmriId, sira])
  @@index([tenantId, isMerkeziId, planlananBaslangic])
  @@index([tenantId, vardiyaId, operatorId])
  @@map("uretim_emri_operasyonlari")
}

model UretimVardiya {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  kod            String
  ad             String
  baslangicSaati String   @map("baslangic_saati")
  bitisSaati     String   @map("bitis_saati")
  aktif          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operasyonlar UretimEmriOperasyonu[]

  @@unique([tenantId, kod])
  @@index([tenantId, aktif])
  @@map("uretim_vardiyalari")
}

model UretimDurus {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  operasyonId     String    @map("operasyon_id") @db.Uuid
  nedenKodu       String    @map("neden_kodu")
  aciklama        String?
  planli          Boolean   @default(false)
  baslangic       DateTime  @default(now())
  bitis           DateTime?
  sureDakika      Decimal   @default(0) @map("sure_dakika") @db.Decimal(12, 2)
  olusturanUserId String    @map("olusturan_user_id") @db.Uuid

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operasyon UretimEmriOperasyonu @relation(fields: [operasyonId], references: [id], onDelete: Cascade)
  olusturan User                 @relation("UretimDurusOlusturan", fields: [olusturanUserId], references: [id])

  @@index([tenantId, operasyonId, baslangic])
  @@map("uretim_duruslari")
}

model UretimDonemKilidi {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  yil           Int
  ay            Int
  aciklama      String?
  kapatanUserId String   @map("kapatan_user_id") @db.Uuid
  kapatildiAt   DateTime @default(now()) @map("kapatildi_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kapatan User   @relation("UretimDonemKapatan", fields: [kapatanUserId], references: [id])

  @@unique([tenantId, yil, ay])
  @@index([tenantId, yil, ay])
  @@map("uretim_donem_kilitleri")
}

enum MaliDonemDurumu {
  acik
  kapali
}

enum MaliDonemOlayTuru {
  kapatildi
  yeniden_acildi
}

/// Bütçe revizyonunun yaşamı (BUT-06): onaylanan revizyon öncekini
/// `yerine_gecildi` yapar; aynı yıl için aynı anda tek taslak olur.
enum ButceDurumu {
  taslak
  onayli
  yerine_gecildi
}

enum ButceOlayTuru {
  olusturuldu
  onaylandi
  revizyon_acildi
}

model MaliDonem {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  yil         Int
  ay          Int
  durum       MaliDonemDurumu @default(acik)
  kapatildiAt DateTime?       @map("kapatildi_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kontroller DonemKontrolu[]
  olaylar    MaliDonemOlayi[]

  @@unique([tenantId, yil, ay])
  @@index([tenantId, durum, yil, ay])
  @@map("mali_donemler")
}

model DonemKontrolu {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  maliDonemId String   @map("mali_donem_id") @db.Uuid
  kod         String
  basarili    Boolean
  aciklama    String
  detay       Json?
  kontrolAt   DateTime @default(now()) @map("kontrol_at")

  maliDonem MaliDonem @relation(fields: [maliDonemId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([maliDonemId, kod])
  @@index([tenantId, maliDonemId])
  @@map("donem_kontrolleri")
}

model MaliDonemOlayi {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  maliDonemId String            @map("mali_donem_id") @db.Uuid
  tur         MaliDonemOlayTuru
  gerekce     String
  userId      String            @map("user_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maliDonem MaliDonem @relation(fields: [maliDonemId], references: [id], onDelete: Cascade)
  kullanici User      @relation("MaliDonemOlayKullanicisi", fields: [userId], references: [id])

  @@index([tenantId, maliDonemId, createdAt])
  @@map("mali_donem_olaylari")
}

/// Yıllık bütçenin bir revizyonu (BUT-05, BUT-06). Aynı yıl için tek taslak
/// kuralı göçteki kısmi tekil indeksle de korunur.
model Butce {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  yil             Int
  revizyon        Int
  durum           ButceDurumu @default(taslak)
  /// Revizyon açılırken istenen gerekçe; ilk revizyonda boş.
  gerekce         String?
  onaylayanUserId String?     @map("onaylayan_user_id") @db.Uuid
  onayTarihi      DateTime?   @map("onay_tarihi")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onaylayan User?         @relation("ButceOnaylayan", fields: [onaylayanUserId], references: [id])
  satirlar  ButceSatiri[]
  olaylar   ButceOlayi[]

  @@unique([tenantId, yil, revizyon])
  @@index([tenantId, yil])
  @@map("butceler")
}

/// Bütçenin bir kalemi için bir ayın tutarı (TL). `anahtar` tahakkuk kalemi
/// anahtarıdır (rapor/tahakkuk.ts): gerçekleşen aynı anahtarla eşleşir.
model ButceSatiri {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  butceId  String  @map("butce_id") @db.Uuid
  anahtar  String
  ay       Int
  tutar    Decimal @db.Decimal(15, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  butce  Butce  @relation(fields: [butceId], references: [id], onDelete: Cascade)

  @@unique([butceId, anahtar, ay])
  @@map("butce_satirlari")
}

model ButceOlayi {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  butceId   String        @map("butce_id") @db.Uuid
  tur       ButceOlayTuru
  gerekce   String?
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  butce     Butce  @relation(fields: [butceId], references: [id], onDelete: Cascade)
  kullanici User   @relation("ButceOlayKullanicisi", fields: [userId], references: [id])

  @@index([tenantId, butceId, createdAt])
  @@map("butce_olaylari")
}

/// Tenant ve yıl bazında çakışmasız üretim emri numarası üretir.
model UretimSayac {
  tenantId String @map("tenant_id") @db.Uuid
  yil      Int
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, yil])
  @@map("uretim_sayaclari")
}

model UretimEmriKalem {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @map("tenant_id") @db.Uuid
  uretimEmriId          String  @map("uretim_emri_id") @db.Uuid
  malzemeStokId         String  @map("malzeme_stok_id") @db.Uuid
  malzemeVaryantId      String? @map("malzeme_varyant_id") @db.Uuid
  planlananMiktar       Decimal @map("planlanan_miktar") @db.Decimal(15, 3)
  ekIhtiyacMiktari      Decimal @default(0) @map("ek_ihtiyac_miktari") @db.Decimal(15, 3)
  sarfEdilenMiktar      Decimal @default(0) @map("sarf_edilen_miktar") @db.Decimal(15, 3)
  birimMaliyet          Decimal @default(0) @map("birim_maliyet") @db.Decimal(15, 4)
  planlananBirimMaliyet Decimal @default(0) @map("planlanan_birim_maliyet") @db.Decimal(15, 4)

  uretimEmri       UretimEmri                 @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  malzeme          StokKart                   @relation("UretimMalzemesi", fields: [malzemeStokId], references: [id])
  malzemeVaryant   StokVaryant?               @relation(fields: [malzemeVaryantId], references: [id])
  rezervasyonlar   UretimMalzemeRezervasyon[]
  bildirimSarflari UretimBildirimiSarf[]
  sarfDuzeltmeleri UretimSarfDuzeltme[]
  ihtiyacTalebi    IhtiyacUretimTalebi?

  @@unique([tenantId, id])
  @@index([tenantId, uretimEmriId])
  @@map("uretim_emri_kalemleri")
}

/// Rezerv dışı üretim kaleminin kullanıcı tarafından seçilmiş hammadde deposu/günü.
model IhtiyacUretimTalebi {
  tenantId      String          @map("tenant_id") @db.Uuid
  kalemId       String          @map("kalem_id") @db.Uuid
  depoId        String          @map("depo_id") @db.Uuid
  ihtiyacTarihi DateTime        @map("ihtiyac_tarihi") @db.Date
  aktif         Boolean         @default(true)
  surum         Int             @default(1)
  kaynakOzeti   String          @map("kaynak_ozeti") @db.VarChar(64)
  gerekce       String          @db.VarChar(1000)
  userId        String          @map("user_id") @db.Uuid
  guncellendiAt DateTime        @default(now()) @map("guncellendi_at") @db.Timestamp(3)
  kalem         UretimEmriKalem @relation(fields: [tenantId, kalemId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  depo          Depo            @relation(fields: [tenantId, depoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tenantId, kalemId])
  @@unique([kalemId])
  @@index([tenantId, depoId])
  @@map("ihtiyac_uretim_talepleri")
}

/// Salt okunur tarihli hesabın değişmez, kullanıcı isteğiyle saklanan sürüm 1 görüntüsü.
model IhtiyacPlani {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  istekAnahtari    String                 @map("istek_anahtari") @db.Uuid
  istekOzeti       String                 @map("istek_ozeti") @db.VarChar(64)
  sonucKaniti      String                 @map("sonuc_kaniti") @db.VarChar(64)
  surum            Int                    @default(1)
  girdi            Json
  snapshot         Json
  createdAt        DateTime               @default(now()) @map("created_at")
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  satinAlmaBagi    IhtiyacSatinAlmaBagi?
  karsilamaBaglari IhtiyacKarsilamaBagi[]

  @@unique([tenantId, id])
  @@unique([tenantId, istekAnahtari])
  @@index([tenantId, createdAt])
  @@map("ihtiyac_planlari")
}

/// Tarihsel kanıt bağıdır; stok rezervi veya planlar arası kapasite tahsisi değildir.
model IhtiyacKarsilamaBagi {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  planId   String       @map("plan_id") @db.Uuid
  tur      String       @db.VarChar(20)
  kaynakId String       @map("kaynak_id") @db.VarChar(200)
  miktar   Decimal      @db.Decimal(15, 3)
  plan     IhtiyacPlani @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, planId, tur, kaynakId])
  @@map("ihtiyac_karsilama_baglari")
}

/// Bir üretim emri malzemesinin hangi depodaki stoktan ayrıldığını izler.
/// Aktif rezerv = rezerveMiktar - sarfEdilenMiktar - cozulenMiktar.
model UretimMalzemeRezervasyon {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  uretimEmriKalemId String   @map("uretim_emri_kalem_id") @db.Uuid
  depoId            String   @map("depo_id") @db.Uuid
  rezerveMiktar     Decimal  @map("rezerve_miktar") @db.Decimal(15, 3)
  sarfEdilenMiktar  Decimal  @default(0) @map("sarf_edilen_miktar") @db.Decimal(15, 3)
  cozulenMiktar     Decimal  @default(0) @map("cozulen_miktar") @db.Decimal(15, 3)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  uretimEmriKalem UretimEmriKalem @relation(fields: [uretimEmriKalemId], references: [id], onDelete: Cascade)
  depo            Depo            @relation(fields: [depoId], references: [id])

  @@unique([tenantId, uretimEmriKalemId, depoId])
  @@index([tenantId, depoId])
  @@map("uretim_malzeme_rezervasyonlari")
}

/// Kısmi veya nihai mamul üretimi. Idempotency anahtarı aynı bildirimin
/// istemci yeniden denemelerinde ikinci kez stok hareketi oluşturmasını önler.
model UretimBildirimi {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  uretimEmriId         String   @map("uretim_emri_id") @db.Uuid
  idempotencyAnahtari  String   @map("idempotency_anahtari")
  uretilenMiktar       Decimal  @map("uretilen_miktar") @db.Decimal(15, 3)
  hurdaMiktari         Decimal  @default(0) @map("hurda_miktari") @db.Decimal(15, 3)
  hurdaNedeni          String?  @map("hurda_nedeni")
  yenidenIslemeMiktari Decimal  @default(0) @map("yeniden_isleme_miktari") @db.Decimal(15, 3)
  yenidenIslemeNedeni  String?  @map("yeniden_isleme_nedeni")
  /// Bu bildirimde sarf edilen malzemenin maliyeti.
  toplamMaliyet        Decimal  @default(0) @map("toplam_maliyet") @db.Decimal(15, 4)
  /// Planlanan operasyon maliyetinin bu bildirime düşen payı (standart maliyet).
  operasyonMaliyeti    Decimal  @default(0) @map("operasyon_maliyeti") @db.Decimal(15, 4)
  /// Reçete ek giderlerinin bu bildirime düşen payı.
  ekGiderMaliyeti      Decimal  @default(0) @map("ek_gider_maliyeti") @db.Decimal(15, 4)
  /// Ana ürünün stoğa girdiği birim maliyet (yan ürün payı düşülmüş).
  mamulBirimMaliyeti   Decimal? @map("mamul_birim_maliyeti") @db.Decimal(15, 4)
  bildirimTarihi       DateTime @map("bildirim_tarihi")
  aciklama             String?
  createdAt            DateTime @default(now()) @map("created_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uretimEmri    UretimEmri            @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  sarflar       UretimBildirimiSarf[]
  kaliteKontrol UretimKaliteKontrol?

  @@unique([tenantId, idempotencyAnahtari])
  @@index([tenantId, uretimEmriId, bildirimTarihi])
  @@map("uretim_bildirimleri")
}

model UretimBildirimiSarf {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  uretimBildirimiId String  @map("uretim_bildirimi_id") @db.Uuid
  uretimEmriKalemId String  @map("uretim_emri_kalem_id") @db.Uuid
  miktar            Decimal @db.Decimal(15, 3)
  birimMaliyet      Decimal @map("birim_maliyet") @db.Decimal(15, 4)

  bildirim        UretimBildirimi @relation(fields: [uretimBildirimiId], references: [id], onDelete: Cascade)
  uretimEmriKalem UretimEmriKalem @relation(fields: [uretimEmriKalemId], references: [id], onDelete: Restrict)

  @@unique([uretimBildirimiId, uretimEmriKalemId])
  @@index([tenantId, uretimEmriKalemId])
  @@map("uretim_bildirimi_sarflari")
}

model UretimSarfDuzeltme {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  uretimEmriId        String                @map("uretim_emri_id") @db.Uuid
  uretimEmriKalemId   String                @map("uretim_emri_kalem_id") @db.Uuid
  depoId              String                @map("depo_id") @db.Uuid
  tip                 UretimSarfDuzeltmeTip
  miktar              Decimal               @db.Decimal(15, 3)
  birimMaliyet        Decimal               @map("birim_maliyet") @db.Decimal(15, 4)
  neden               String
  idempotencyAnahtari String                @map("idempotency_anahtari")
  partiBilgileri      Json?                 @map("parti_bilgileri")
  createdAt           DateTime              @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uretimEmri      UretimEmri      @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  uretimEmriKalem UretimEmriKalem @relation(fields: [uretimEmriKalemId], references: [id], onDelete: Restrict)
  depo            Depo            @relation(fields: [depoId], references: [id])

  @@unique([tenantId, idempotencyAnahtari])
  @@index([tenantId, uretimEmriId, createdAt])
  @@map("uretim_sarf_duzeltmeleri")
}

model UretimKaliteKontrol {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  uretimEmriId           String             @map("uretim_emri_id") @db.Uuid
  uretimBildirimiId      String             @unique @map("uretim_bildirimi_id") @db.Uuid
  karantinaDepoId        String             @map("karantina_depo_id") @db.Uuid
  miktar                 Decimal            @db.Decimal(15, 3)
  durum                  KaliteKontrolDurum @default(bekliyor)
  kontrolNotu            String?            @map("kontrol_notu")
  olcumler               Json?
  kontrolEdenUserId      String?            @map("kontrol_eden_user_id") @db.Uuid
  kontrolZamani          DateTime?          @map("kontrol_zamani")
  yenidenIslemeSayisi    Int                @default(0) @map("yeniden_isleme_sayisi")
  yenidenIslemeBaslangic DateTime?          @map("yeniden_isleme_baslangic")
  yenidenIslemeBitis     DateTime?          @map("yeniden_isleme_bitis")
  createdAt              DateTime           @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uretimEmri      UretimEmri      @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)
  uretimBildirimi UretimBildirimi @relation(fields: [uretimBildirimiId], references: [id], onDelete: Cascade)
  karantinaDepo   Depo            @relation(fields: [karantinaDepoId], references: [id])

  @@index([tenantId, durum, createdAt])
  @@index([tenantId, uretimEmriId])
  @@map("uretim_kalite_kontrolleri")
}

/// Depolar arası transfer fişi (STK-07): onayda kaynak depoda transfer_cikis,
/// hedef depoda transfer_giris hareketi yazılır. Ortalama maliyet değişmez.
model DepoTransfer {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  no              String
  tarih           DateTime      @db.Date
  kaynakDepoId    String        @map("kaynak_depo_id") @db.Uuid
  hedefDepoId     String        @map("hedef_depo_id") @db.Uuid
  aciklama        String?
  durum           TransferDurum @default(taslak)
  onaylayanUserId String?       @map("onaylayan_user_id") @db.Uuid
  onayZamani      DateTime?     @map("onay_zamani")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  kaynakDepo Depo                @relation("TransferKaynak", fields: [kaynakDepoId], references: [id])
  hedefDepo  Depo                @relation("TransferHedef", fields: [hedefDepoId], references: [id])
  kalemler   DepoTransferKalem[]

  @@unique([tenantId, no])
  @@index([tenantId, durum])
  @@map("depo_transferleri")
}

model DepoTransferKalem {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  transferId    String  @map("transfer_id") @db.Uuid
  stokId        String  @map("stok_id") @db.Uuid
  varyantId     String? @map("varyant_id") @db.Uuid
  /// ana birim cinsinden; girilen birim/miktar stok hareketindeki gibi ayrı saklanır
  miktar        Decimal @db.Decimal(15, 3)
  girilenBirim  String  @map("girilen_birim")
  girilenMiktar Decimal @map("girilen_miktar") @db.Decimal(15, 3)

  transfer DepoTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stok     StokKart     @relation(fields: [stokId], references: [id])
  varyant  StokVaryant? @relation(fields: [varyantId], references: [id])

  @@index([tenantId, transferId])
  @@map("depo_transfer_kalemleri")
}

/// Transfer fişi numarası sayacı (yıl bazlı, BelgeSayac deseniyle aynı)
model TransferSayac {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  yil      Int
  sonSira  Int    @default(0) @map("son_sira")

  @@unique([tenantId, yil])
  @@map("transfer_sayaclari")
}

/// Faturanın GİB senaryosu (FTR-16). `FaturaTip`ten ayrıdır: tip bizim iç
/// sınıflandırmamız (satis/alis/proforma), senaryo ise UBL'e yazılan
/// `InvoiceTypeCode`tur ve satırlardan türetilir.
enum FaturaSenaryo {
  satis
  iade
  tevkifat
  tevkifatiade
  istisna
  ihrackayitli
  ozelmatrah
  sgk
  sarj
  sarjanlik
  /// EBLG-127: konaklama vergili satış.
  konaklamavergisi
}

/// e-Fatura profili (FTR-19). TICARIFATURA alıcıya 8 gün içinde kabul/ret
/// yükümlülüğü getirir; kabul/ret takibi (EBLG-13) yalnız bu profilde işler.
enum EfaturaProfili {
  temel
  ticari
}

/// e-Arşiv faturanın alıcıya nasıl teslim edildiği; UBL'e SEND_TYPE olarak
/// yazılır (EBLG-26).
enum EarsivGonderimSekli {
  elektronik
  kagit
}

enum FaturaTip {
  satis
  alis
  satis_iade
  alis_iade
  proforma
}

enum FaturaGelirTuru {
  ticari_satis
  kira_geliri
  varlik_satisi
  yansitma
  hizmet_diger
}

enum FaturaDurum {
  taslak
  kesin
  iptal
}

enum EbelgeTur {
  efatura
  earsiv
}

model Fatura {
  odemeSozleri          OdemeSozu[]
  gecikmeTahmini        FaturaGecikmeTahmini?
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  tip                   FaturaTip
  gelirTuru             FaturaGelirTuru       @default(ticari_satis) @map("gelir_turu")
  durum                 FaturaDurum           @default(taslak)
  no                    String?
  seri                  String?
  sira                  Int?
  /// Veritabanının ürettiği aksansız arama kolonu (20260904200000_aksansiz_arama).
  /// GENERATED ALWAYS olduğu için yalnız okunur; Prisma ile yazılmaz.
  aramaNormal           String?               @map("arama_normal")
  tarih                 DateTime              @db.Date
  vadeTarihi            DateTime?             @map("vade_tarihi") @db.Date
  siparisNo             String?               @map("siparis_no")
  siparisTarihi         DateTime?             @map("siparis_tarihi") @db.Date
  /// FTR-31: müşterinin talep referansı; zincirden gelir ya da elle girilir.
  talepNo               String?               @map("talep_no")
  talepTarihi           DateTime?             @map("talep_tarihi") @db.Date
  /// FTR-32: müşteri tarafında ilgili kişi; zincirden gelir ya da elle girilir.
  ilgiliKisi            String?               @map("ilgili_kisi")
  ilgiliKisiGorevi      String?               @map("ilgili_kisi_gorevi")
  /// EBLG-78: yatırım teşvik belge numarası ve tarihi. Numara doluysa fatura
  /// YATIRIMTESVIK profiliyle gider (e-Arşiv'de tip YTB önekli olur).
  ytbNo                 String?               @map("ytb_no")
  ytbTarihi             DateTime?             @map("ytb_tarihi") @db.Date
  /// EBLG-76: sevkiyatın nasıl belgelendiği. `irsaliye` seçilen e-İrsaliyelere
  /// bağlanır, `fatura_once` sonradan kesilecek irsaliyeyi bekler,
  /// `irsaliye_yerine` mal fatura beraberinde sevk edildiği için hiç irsaliye
  /// düzenlenmediğini söyler. Boş: firma e-İrsaliye mükellefi değil ya da
  /// sevkiyat hiç sorulmadı (yalnız hizmet satırı).
  sevkiyatYontemi       String?               @map("sevkiyat_yontemi")
  /// EBLG-76: irsaliye yerine geçen faturada malın fiilen sevk edildiği an;
  /// belgeye `cac:Delivery/cac:Despatch` olarak yazılır.
  fiiliSevkZamani       DateTime?             @map("fiili_sevk_zamani")
  /// FTR-30: malın teslim edildiği yer. e-İrsaliyeden faturalanırsa irsaliyeye
  /// fiilen yazılan adres gelir; yoksa cari adreslerinden seçilir ya da elle
  /// girilir. Belgeye `cac:Delivery/cac:DeliveryAddress` olarak yazılır.
  teslimatAdres         String?               @map("teslimat_adres")
  teslimatIl            String?               @map("teslimat_il")
  teslimatIlce          String?               @map("teslimat_ilce")
  teslimatPostaKodu     String?               @map("teslimat_posta_kodu")
  cariId                String                @map("cari_id") @db.Uuid
  /// STK-07: stok hareketlerinin işleneceği depo; boşsa varsayılan depo
  depoId                String?               @map("depo_id") @db.Uuid
  dovizCinsi            DovizCinsi            @default(TRY) @map("doviz_cinsi")
  kur                   Decimal               @default(1) @db.Decimal(15, 6)
  genelIskontoYuzdesi   Decimal               @default(0) @map("genel_iskonto_yuzdesi") @db.Decimal(5, 2)
  genelIskontoTutari    Decimal               @default(0) @map("genel_iskonto_tutari") @db.Decimal(15, 2)
  toplamBrut            Decimal               @map("toplam_brut") @db.Decimal(15, 2)
  toplamSatirIskontosu  Decimal               @map("toplam_satir_iskontosu") @db.Decimal(15, 2)
  genelIskontoToplam    Decimal               @map("genel_iskonto_toplam") @db.Decimal(15, 2)
  toplamMatrah          Decimal               @map("toplam_matrah") @db.Decimal(15, 2)
  toplamKdv             Decimal               @map("toplam_kdv") @db.Decimal(15, 2)
  toplamTevkifat        Decimal               @map("toplam_tevkifat") @db.Decimal(15, 2)
  /// Satırlardan türetilen GİB senaryosu; UBL'e InvoiceTypeCode olarak yazılır.
  senaryo               FaturaSenaryo         @default(satis)
  /// UBL'e ProfileID olarak yazılır; varsayılanı cari kartından gelir.
  efaturaProfili        EfaturaProfili        @default(temel) @map("efatura_profili")
  /// Belge e-Arşiv olarak düzenlenirse teslim şekli (EBLG-26); varsayılanı cari
  /// kartından gelir. e-Fatura kanalında kullanılmaz.
  earsivGonderimSekli   EarsivGonderimSekli   @default(elektronik) @map("earsiv_gonderim_sekli")
  /// EBLG-53: fiili ihracat tarihi; UBL'e `cac:Delivery/cbc:ActualDeliveryDate`
  /// olarak yazılır ve ihracat faturasında zorunludur.
  ihracatTeslimTarihi   DateTime?             @map("ihracat_teslim_tarihi") @db.Date
  /// EBLG-53: Incoterms teslim şartı (EXW, FOB, CIF…).
  ihracatTeslimSarti    String?               @map("ihracat_teslim_sarti")
  /// FTR-40: kendi bastığımız fatura/proforma çıktısının dili (e-Belge görünümünü etkilemez).
  belgeDili             String                @default("tr") @map("belge_dili")
  ciftDil               Boolean               @default(false) @map("cift_dil")
  /// EBLG-53: UN/ECE Rec. 19 taşıma şekli kodu (1 deniz, 3 kara…).
  ihracatTasimaSekli    String?               @map("ihracat_tasima_sekli")
  /// EBLG-54: gümrük beyanname numarası; gümrük kapandıktan sonra girilir ve
  /// yalnız kayda işlenir, gönderilmiş belge GİB'e yeniden gönderilmez.
  gumrukBeyannameNo     String?               @map("gumruk_beyanname_no")
  gumrukBeyannameTarihi DateTime?             @map("gumruk_beyanname_tarihi") @db.Date
  /// EBLG-56: satış internet üzerinden yapıldı mı; işaret e-Belge sihirbazında
  /// konur ve alan grubu yalnız e-Arşiv kanalında belgeye yazılır.
  internetSatisi        Boolean               @default(false) @map("internet_satisi")
  internetWebAdresi     String?               @map("internet_web_adresi")
  internetOdemeSekli    String?               @map("internet_odeme_sekli")
  internetOdemeTarihi   DateTime?             @map("internet_odeme_tarihi") @db.Date
  internetOdemeAracisi  String?               @map("internet_odeme_aracisi")
  internetTasiyiciUnvan String?               @map("internet_tasiyici_unvan")
  internetTasiyiciVkn   String?               @map("internet_tasiyici_vkn")
  internetGonderiTarihi DateTime?             @map("internet_gonderi_tarihi") @db.Date
  /// EBLG-60: ihraç kayıtlı satış kodu (701/702). Doluysa KDV hesaplanır ama
  /// tahsil edilmez; belge IHRACKAYITLI tipinde gider.
  ihracKayitliKodu      String?               @map("ihrac_kayitli_kodu")
  /// KAMU senaryosu: ödemeyi yapacak harcama birimi ve ödemenin yapılacağı IBAN.
  kamuHarcamaBirimiVkn  String?               @map("kamu_harcama_birimi_vkn")
  kamuHarcamaBirimiAdi  String?               @map("kamu_harcama_birimi_adi")
  kamuIban              String?               @map("kamu_iban")
  /// Özel matrah (KDV K. 23): kod, KDV'nin hesaplandığı matrah ve oranı.
  /// Satırlar KDV'siz durur; KDV yalnız belge düzeyinde bildirilir.
  ozelMatrahKodu        String?               @map("ozel_matrah_kodu")
  ozelMatrahTutari      Decimal?              @map("ozel_matrah_tutari") @db.Decimal(15, 2)
  ozelMatrahOrani       Decimal?              @map("ozel_matrah_orani") @db.Decimal(5, 2)
  /// Şarj faturası (EBLG-71): şarj edilen aracın plakası, şarjın başlangıç ve
  /// bitiş anı, ESU rapor kimlikleri (`[{raporId, tarih}]`).
  sarjPlaka             String?               @map("sarj_plaka")
  sarjBaslangic         DateTime?             @map("sarj_baslangic")
  sarjBitis             DateTime?             @map("sarj_bitis")
  sarjEsuRaporlari      Json?                 @map("sarj_esu_raporlari")
  /// İDİS (EBLG-72): Darphane bildiriminden dönen sevkiyat numarası; doluysa
  /// belge IDIS profiliyle gider.
  idisSevkiyatNo        String?               @map("idis_sevkiyat_no")
  /// SGK faturası: ilave fatura tipi, Kurum'daki kod/ad, dosya no ve dönem.
  /// Alıcının VKN'si SGK'nınki olduğunda sihirbazda toplanır.
  sgkIlaveFaturaTipi    String?               @map("sgk_ilave_fatura_tipi")
  sgkMukellefKodu       String?               @map("sgk_mukellef_kodu")
  sgkMukellefAdi        String?               @map("sgk_mukellef_adi")
  sgkDosyaNo            String?               @map("sgk_dosya_no")
  sgkDonemBaslangic     DateTime?             @map("sgk_donem_baslangic") @db.Date
  sgkDonemBitis         DateTime?             @map("sgk_donem_bitis") @db.Date
  /// Yolcu beraberi (tax-free): yolcu ve aracı kurum bilgisi; boşsa değildir.
  /// Biçim `YolcuBeraberiBilgisi` (packages/shared/src/yolcu-beraberi.ts).
  yolcuBeraberi         Json?                 @map("yolcu_beraberi")
  toplamNetKdv          Decimal               @map("toplam_net_kdv") @db.Decimal(15, 2)
  /// EBLG-120: bedele eklenen KDV dışı vergiler ve kesilen stopaj toplamı (belge dövizi).
  toplamEkVergi         Decimal               @default(0) @map("toplam_ek_vergi") @db.Decimal(15, 2)
  toplamStopaj          Decimal               @default(0) @map("toplam_stopaj") @db.Decimal(15, 2)
  genelToplam           Decimal               @map("genel_toplam") @db.Decimal(15, 2)
  aciklama              String?
  notlar                String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  cari                  CariHesap                  @relation(fields: [cariId], references: [id])
  depo                  Depo?                      @relation(fields: [depoId], references: [id])
  satirlar              FaturaSatir[]
  ebelge                EbelgeKayit?
  gelenEbelge           GelenEbelge?
  kasaBankaHarekets     KasaBankaHareket[]         @relation("HareketFaturasi")
  /// KSB-07: bu kur farkı faturasının kapattığı ödeme kur farkları.
  kurFarkiOdemeleri     KasaBankaHareket[]         @relation("KurFarkiFaturasi")
  kurFarkiKapamalari    FaturaKapama[]             @relation("KapamaKurFarkiFaturasi")
  zincirBelgeleri       Belge[]
  ekstreSatirlari       BankaEkstreSatir[]
  tekrarlayanSablon     TekrarlayanFatura[]        @relation("TekrarlayanFaturaSablon")
  tekrarlayanPlan       TekrarlayanFatura?         @relation("TekrarlayanFaturaUretim", fields: [tekrarlayanPlanId], references: [id])
  tekrarlayanPlanId     String?                    @map("tekrarlayan_plan_id") @db.Uuid
  planlananTarih        DateTime?                  @map("planlanan_tarih") @db.Date
  pazaryeriSiparisleri  PazaryeriSiparis[]
  posTahsilatlari       PosTahsilat[]
  krediKartiHareketleri KrediKartiHareket[]
  iadeReferanslari      FaturaIadeReferansi[]      @relation("IadeReferanslari")
  iadeEdildigiFaturalar FaturaIadeReferansi[]      @relation("IadeKaynagi")
  odemeTalimatiBaglari  BankaOdemeTalimatiFatura[]

  maliyetDagitimPaylari MaliyetDagitimPayi[]

  /// KSB-16: bu faturayı kapatan kapamalar; iade faturasının kaynak olduğu kapamalar ayrıca.
  kapamalar      FaturaKapama[] @relation("KapananFatura")
  iadeKapamalari FaturaKapama[] @relation("IadeKaynagi")

  @@unique([tenantId, seri, sira])
  @@unique([tekrarlayanPlanId, planlananTarih])
  @@index([tenantId, tarih])
  @@map("faturalar")
}

/// EBLG-58: iade faturasının iade edilen faturalara referansı. GİB, iade
/// edilen her fatura için 16 haneli numara ve tarih ister; fatura sistemde
/// kayıtlıysa `kaynakFaturaId` onu gösterir, değilse numara elle girilir.
model FaturaIadeReferansi {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  faturaId       String   @map("fatura_id") @db.Uuid
  kaynakFaturaId String?  @map("kaynak_fatura_id") @db.Uuid
  sira           Int
  belgeNo        String   @map("belge_no")
  tarih          DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  fatura       Fatura  @relation("IadeReferanslari", fields: [faturaId], references: [id], onDelete: Cascade)
  kaynakFatura Fatura? @relation("IadeKaynagi", fields: [kaynakFaturaId], references: [id], onDelete: SetNull)

  @@unique([faturaId, belgeNo])
  @@index([tenantId, kaynakFaturaId])
  @@map("fatura_iade_referanslari")
}

enum TekrarSikligi {
  haftalik
  aylik
  yillik
}

model TekrarlayanFatura {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  ad              String
  sablonFaturaId  String        @map("sablon_fatura_id") @db.Uuid
  siklik          TekrarSikligi
  aralik          Int           @default(1)
  sonrakiTarih    DateTime      @map("sonraki_tarih") @db.Date
  bitisTarihi     DateTime?     @map("bitis_tarihi") @db.Date
  aktif           Boolean       @default(true)
  sonUretimTarihi DateTime?     @map("son_uretim_tarihi") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sablonFatura Fatura   @relation("TekrarlayanFaturaSablon", fields: [sablonFaturaId], references: [id], onDelete: Restrict)
  uretilenler  Fatura[] @relation("TekrarlayanFaturaUretim")

  @@index([tenantId, aktif, sonrakiTarih])
  @@map("tekrarlayan_faturalar")
}

model FaturaSatir {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  faturaId           String  @map("fatura_id") @db.Uuid
  /// F03: yalnız belge dönüşümünde taşınır; eski/elle yazılmış satırda bilinmez.
  kaynakBelgeSatirId String? @map("kaynak_belge_satir_id") @db.Uuid
  stokId             String  @map("stok_id") @db.Uuid
  varyantId          String? @map("varyant_id") @db.Uuid
  partiBilgileri     Json?   @map("parti_bilgileri")
  miktar             Decimal @db.Decimal(15, 3)
  birim              String  @default("adet")
  birimFiyat         Decimal @map("birim_fiyat") @db.Decimal(15, 4)
  iskontoOrani       Decimal @default(0) @map("iskonto_orani") @db.Decimal(5, 2)
  iskontoTutari      Decimal @default(0) @map("iskonto_tutari") @db.Decimal(15, 2)
  genelIskontoPayi   Decimal @default(0) @map("genel_iskonto_payi") @db.Decimal(15, 2)
  matrah             Decimal @db.Decimal(15, 2)
  kdvOrani           Decimal @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  kdvTutari          Decimal @map("kdv_tutari") @db.Decimal(15, 2)
  /// GİB tevkifat kodu (FTR-18); oran bu koddan türer, pay/payda türetilmiş
  /// değerlerdir ve doğrudan girilmez.
  tevkifatKodu       String? @map("tevkifat_kodu")
  tevkifatPay        Int?    @map("tevkifat_pay")
  tevkifatPayda      Int?    @map("tevkifat_payda")
  tevkifatTutari     Decimal @default(0) @map("tevkifat_tutari") @db.Decimal(15, 2)
  netKdvTutari       Decimal @map("net_kdv_tutari") @db.Decimal(15, 2)
  /// EBLG-120: KDV dışı vergiler [{kod, ad, oran, matrah, tutar, stopaj, kdvMatrahinaDahil}]; davranış kodun merkezdeki kaydından.
  ekVergiler         Json?   @map("ek_vergiler")
  ekVergiTutari      Decimal @default(0) @map("ek_vergi_tutari") @db.Decimal(15, 2)
  stopajTutari       Decimal @default(0) @map("stopaj_tutari") @db.Decimal(15, 2)
  toplamTutar        Decimal @map("toplam_tutar") @db.Decimal(15, 2)
  gibIstisnaKodu     String? @map("gib_istisna_kodu")
  /// İDİS etiket numarası (EBLG-72): 2 harf + 7 rakam, her satırda zorunlu.
  idisEtiketNo       String? @map("idis_etiket_no")
  /// SARJANLIK faturasında satırdaki şarj ünitesinin seri numarası (EBLG-71).
  sarjUniteSeriNo    String? @map("sarj_unite_seri_no")
  /// EBLG-78: yatırım teşvik harcama tipi (01–04) ve makine-teçhizat (01)
  /// satırında Darphane değil E-TUYS listesinden gelen makine kimlikleri.
  ytbHarcamaTipi     String? @map("ytb_harcama_tipi")
  ytbMakineAdi       String? @map("ytb_makine_adi")
  ytbMakineId        String? @map("ytb_makine_id")
  ytbMakineSiraNo    String? @map("ytb_makine_sira_no")
  /// EBLG-103: ihracat faturasında kalemin kabı (cinsi UN/ECE Rec. 21 kodu,
  /// numarası ve adedi); sihirbazda girilir, UBL'e ActualPackage olarak gider.
  ihracatKapCinsi    String? @map("ihracat_kap_cinsi")
  ihracatKapNo       String? @map("ihracat_kap_no")
  ihracatKapAdet     Int?    @map("ihracat_kap_adet")
  projeId            String? @map("proje_id") @db.Uuid
  projeAltKirilimId  String? @map("proje_alt_kirilim_id") @db.Uuid

  fatura          Fatura           @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  stok            StokKart         @relation(fields: [stokId], references: [id])
  varyant         StokVaryant?     @relation(fields: [varyantId], references: [id])
  proje           Proje?           @relation(fields: [projeId], references: [id])
  projeAltKirilim ProjeAltKirilim? @relation(fields: [projeAltKirilimId], references: [id])

  maliyetDagitimlari    MaliyetDagitimi[]
  maliyetDagitimPaylari MaliyetDagitimPayi[]

  @@index([tenantId, faturaId])
  @@index([tenantId, projeId])
  @@map("fatura_satirlari")
}

/// KSB-09: makbuz serisi; tür (tahsilat/tediye) ve yıl başına bir sayaç.
/// Sayaç tetikleyiciyle artar ve geri sarılmaz (geri alınan fişin numarası yanar).
model MakbuzSeri {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tur      String
  yil      Int
  onek     String
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tur, yil])
  @@map("makbuz_serileri")
}

model FaturaSeri {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  seri     String
  yil      Int
  sonSira  Int    @default(0) @map("son_sira")

  @@unique([tenantId, seri, yil])
  @@map("fatura_serileri")
}

model EbelgeKayit {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  faturaId         String      @unique @map("fatura_id") @db.Uuid
  tur              EbelgeTur
  /// Zarfın GİB durumu. Alıcının kabul/ret kararı ayrı eksendir (EBLG-13),
  /// bu alana yazılmaz — "zarf kabul edildi" ile "alıcı kabul etti" farklıdır.
  durum            BelgeDurum  @default(kuyrukta)
  entegratorRef    String?     @map("entegrator_ref")
  hataMesaji       String?     @map("hata_mesaji")
  /// Zarf durumunun en son sorgulandığı an; aynı zarf 2 saat dolmadan tekrar
  /// sorgulanmaz (EBLG-14).
  sonDurumSorguAt  DateTime?   @map("son_durum_sorgu_at")
  /// Entegratörün ham durum adı. `iletildi` temel faturanın GİB'de alıcıya
  /// teslimi bekleyip beklemediği (NES 1200) yalnız bundan anlaşılır.
  entegratorDurumu String?     @map("entegrator_durumu")
  /// Alıcının bizim kestiğimiz ticari faturaya verdiği yanıt (EBLG-13).
  aliciYaniti      AliciYanit? @map("alici_yaniti")
  aliciYanitZamani DateTime?   @map("alici_yanit_zamani")
  aliciYanitNotu   String?     @map("alici_yanit_notu")
  /// Yanıt belgesinin UUID'si; aynı yanıt ikinci kez işlenmesin diye.
  aliciYanitRef    String?     @map("alici_yanit_ref")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  fatura Fatura       @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  arsiv  EbelgeArsiv?

  @@index([tenantId, durum, sonDurumSorguAt])
  @@map("ebelge_kayitlari")
}

enum AliciYanit {
  kabul
  ret
}

/// GİB kayıt listesinin belge türü; e-Arşiv'in GİB kaydı yoktur, bu yüzden
/// EbelgeTur'dan ayrı bir kümedir.
enum GibBelgeTuru {
  efatura
  eirsaliye
}

/// GİB'e kayıtlı e-Fatura kullanıcıları (EBLG-10). Liste kamuya açıktır ve her
/// kiracı için aynıdır; kiracı başına kopyalamak aynı veriyi N kez saklamak
/// olurdu, bu yüzden tablo global tutulur ve RLS uygulanmaz. Bir VKN'nin birden
/// çok posta kutusu etiketi olabildiğinden teklik (vkn, etiket) çiftindedir.
model GibMukellef {
  vknTckn         String       @map("vkn_tckn")
  /// e-Fatura ve e-İrsaliye kayıtları GİB'de ayrıdır; bir firma e-Fatura
  /// mükellefi olup e-İrsaliye kullanmıyor olabilir.
  belgeTuru       GibBelgeTuru @map("belge_turu")
  postaKutusu     String       @map("posta_kutusu")
  unvan           String?
  /// Listedeki `<Type>`: "KAMU" ya da "OZEL". KAMU alıcıya belge KAMU
  /// senaryosuyla gider; listeyi bu alanı taşımayan entegratörde boş kalır.
  tur             String?
  /// Mükellefin bu belge türüne GİB'deki ilk kaydı (`FirstCreationTime`);
  /// cari kartında "e-Fatura mükellefi · GİB kaydı" olarak görünür (CARI-23).
  ilkKayitZamani  DateTime?    @map("ilk_kayit_zamani")
  /// Bu posta kutusunun GİB kayıt zamanı (`Alias/CreationTime`); kutu
  /// seçiminde en yeni kaydı ayırt eder (EBLG-86).
  kutuKayitZamani DateTime?    @map("kutu_kayit_zamani")
  guncellendi     DateTime     @default(now())

  @@id([vknTckn, belgeTuru, postaKutusu])
  @@index([vknTckn, belgeTuru])
  @@map("gib_mukellefler")
}

/// Mükellef listesi senkronunun durumu; gönderim yolunun tazelik kontrolü
/// (EBLG-10) buradan okunur. Tek satırlıdır.
model GibMukellefSenkron {
  id           String    @id
  sonSenkronAt DateTime? @map("son_senkron_at")
  kayitSayisi  Int       @default(0) @map("kayit_sayisi")
  durum        String    @default("beklemede")
  hataMesaji   String?   @map("hata_mesaji")
  saglayici    String?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("gib_mukellef_senkron")
}

/// Gelen belge çekiminin tarih kursörü (EBLG-11). Bu ana kadarki aralık bir
/// daha sorgulanmaz; elle tazelemenin saatlik sınırı da bu satırdan okunur.
model EbelgeGelenKursor {
  tenantId           String    @id @map("tenant_id") @db.Uuid
  sonCekimAt         DateTime  @map("son_cekim_at")
  sonTetiklemeAt     DateTime? @map("son_tetikleme_at")
  /// EBLG-109: gelen e-İrsaliye taramasının son başarılı çalıştığı an; planlayıcı
  /// taramayı `EBLG_GELEN_ARALIK_MS` dolmadan yeniden açmaz. Pencere bundan değil,
  /// son gelen kayıttan türetilir (`EirsaliyeService.gelenleriCek`).
  irsaliyeSonCekimAt DateTime? @map("irsaliye_son_cekim_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("ebelge_gelen_kursor")
}

model EbelgeArsiv {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ebelgeId    String   @unique @map("ebelge_id") @db.Uuid
  xmlIcerik   String   @map("xml_icerik")
  pdfDosyaUrl String?  @map("pdf_dosya_url")
  createdAt   DateTime @default(now()) @map("created_at")

  ebelge EbelgeKayit @relation(fields: [ebelgeId], references: [id], onDelete: Cascade)

  @@map("ebelge_arsiv")
}

enum GelenEbelgeDurum {
  beklemede
  islendi
  reddedildi
}

enum GelenEbelgeYanit {
  kabul
  ret
}

/// EBLG-05: entegratörden çekilen gelen e-Faturalar. Çekim anında yalnızca
/// burada durur; alış faturasına yalnızca kullanıcı onayıyla dönüşür.
model GelenEbelge {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  /// Entegratördeki belge UUID'si — tekrar çekimde yinelenmemesi için anahtar.
  uuid               String
  belgeNo            String            @map("belge_no")
  gonderenVkn        String            @map("gonderen_vkn")
  gonderenUnvan      String            @map("gonderen_unvan")
  tarih              DateTime          @db.Date
  profilId           String?           @map("profil_id")
  xmlIcerik          String            @map("xml_icerik")
  durum              GelenEbelgeDurum  @default(beklemede)
  faturaId           String?           @unique @map("fatura_id") @db.Uuid
  /// EBLG-06: TICARIFATURA profilinde gönderilen kabul/ret yanıtı.
  yanit              GelenEbelgeYanit?
  yanitGerekce       String?           @map("yanit_gerekce")
  yanitZamani        DateTime?         @map("yanit_zamani")
  /// Listenin özeti; belge kaydedilirken XML'den yazılır, liste XML okumaz.
  /// NULL: henüz hesaplanmadı (liste ilk açılışta tamamlar).
  satirSayisi        Int?              @map("satir_sayisi")
  genelToplam        Decimal?          @map("genel_toplam") @db.Decimal(18, 2)
  dovizCinsi         String?           @map("doviz_cinsi")
  okunabilir         Boolean?
  /// EBLG-144: gelen alış denetçisinin son sonucu (OnDenetimBulgusu[]); NULL: hesaplanmadı.
  denetimBulgulari   Json?             @map("denetim_bulgulari")
  denetimUyariSayisi Int?              @map("denetim_uyari_sayisi")
  denetimAt          DateTime?         @map("denetim_at")
  /// EBLG-147: belgedeki IBAN'lar (boşluksuz büyük harf); kayıtta XML'den yazılır.
  odemeHesaplari     String[]          @map("odeme_hesaplari")
  /// AI-72: yapay zekâ kontrolünün son başarılı sonucu {imza, sonuc}; imza satır eşleştirmesidir.
  aiDenetim          Json?             @map("ai_denetim")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  fatura             Fatura?           @relation(fields: [faturaId], references: [id])
  onDenetimKararlari OnDenetimKarari[]

  @@unique([tenantId, uuid])
  @@index([tenantId, durum])
  @@map("gelen_ebelgeler")
}

enum KasaBankaHareketTip {
  tahsilat
  tediye
  virman_gidis
  virman_gelis
}

enum CekSenetTur {
  cek
  senet
}

/// Alınan = müşteri çeki (portföyümüzde, varlık); verilen = kendi kestiğimiz
/// çek (borcumuz). Cari ve para etkileri ters yönlüdür (KSB-05).
enum CekSenetYon {
  alinan
  verilen
}

/// portfoyde/ciro_edildi/tahsil_edildi yalnız ALINAN, verildi/odendi yalnız
/// VERİLEN yönünde kullanılır; karsiliksiz ve iade_edildi ortaktır.
enum CekSenetDurum {
  portfoyde
  tahsile_verildi
  teminata_verildi
  ciro_edildi
  tahsil_edildi
  karsiliksiz
  iade_edildi
  verildi
  odendi
}

model Kasa {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  /// MUH-03: muhasebe alt hesap kodu; boşsa aktarımda varsayılan üretilir.
  muhasebeKodu String?    @map("muhasebe_kodu")
  ad           String
  dovizCinsi   DovizCinsi @default(TRY) @map("doviz_cinsi")
  aktif        Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  hareketler      KasaBankaHareket[]
  masraflar       Masraf[]
  masrafOdemeleri MasrafOdeme[]
  gelirKayitlari  GelirKaydi[]

  @@unique([tenantId, ad])
  @@map("kasalar")
}

model BankaHesap {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  /// MUH-03: muhasebe alt hesap kodu; boşsa aktarımda varsayılan üretilir.
  muhasebeKodu   String?    @map("muhasebe_kodu")
  ad             String
  bankaAdi       String     @map("banka_adi")
  sube           String?
  hesapNo        String?    @map("hesap_no")
  iban           String?
  /// EBLG-101: firma tasarımındaki banka tablosunda basılır.
  swift          String?
  /// EBLG-101: hesap firma tasarımının banka tablosunda gösterilir; iç hesaplar faturaya çıkmaz.
  faturadaGoster Boolean    @default(false) @map("faturada_goster")
  dovizCinsi     DovizCinsi @default(TRY) @map("doviz_cinsi")
  aktif          Boolean    @default(true)
  /// KSB-06: bu hesabın ekstre dosyasındaki sütun eşlemesi. Bir kez kurulur,
  /// sonraki yüklemelerde kullanıcıya sorulmaz. Bkz. EkstreSutunEslemesi.
  ekstreEslemesi Json?      @map("ekstre_eslemesi")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  hareketler         KasaBankaHareket[]
  ekstreler          BankaEkstre[]
  ekstreSatirlari    BankaEkstreSatir[]
  posHesaplari       PosHesap[]           @relation("PosVarsayilanBanka")
  baglantiEslemeleri BankaBaglantiHesap[]
  odemeTalimatlari   BankaOdemeTalimati[]
  odemePaketleri     OdemePaketi[]
  /// ENT-07: toplu ödeme dosyası profili (xlsx/csv sütunları ya da pain.001).
  odemeDosyaProfili  Json?                @map("odeme_dosya_profili")
  masraflar          Masraf[]
  masrafOdemeleri    MasrafOdeme[]
  gelirKayitlari     GelirKaydi[]
  krediKartlari      KrediKarti[]
  /// KSB-11: bu hesapta tahsilde/teminatta duran çekler.
  bankadakiCekler    CekSenet[]
  cekBordrolari      CekSenetBordro[]

  @@unique([tenantId, ad])
  @@map("banka_hesaplari")
}

enum KrediKartiHareketTipi {
  harcama
  iade
  odeme
  faiz
  aidat
}

model KrediKarti {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  /// MUH-03: muhasebe alt hesap kodu; boşsa aktarımda varsayılan üretilir.
  muhasebeKodu      String?             @map("muhasebe_kodu")
  ad                String
  bankaAdi          String              @map("banka_adi")
  sonDortHane       String              @map("son_dort_hane")
  kartSahibi        String?             @map("kart_sahibi")
  limit             Decimal             @db.Decimal(15, 2)
  dovizCinsi        DovizCinsi          @default(TRY) @map("doviz_cinsi")
  hesapKesimGunu    Int                 @map("hesap_kesim_gunu")
  sonOdemeGunu      Int                 @map("son_odeme_gunu")
  bagliBankaHesapId String?             @map("bagli_banka_hesap_id") @db.Uuid
  /// KSB-10: asgari ödeme oranı (%). Boşsa limite göre: 50.000'e kadar %20, üstü %40.
  asgariOdemeOrani  Decimal?            @map("asgari_odeme_orani") @db.Decimal(5, 2)
  renk              String              @default("lacivert")
  aktif             Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bagliBankaHesap   BankaHesap?         @relation(fields: [bagliBankaHesapId], references: [id])
  hareketler        KrediKartiHareket[]
  masrafOdemeleri   MasrafOdeme[]
  ekstreler         KrediKartiEkstre[]

  @@unique([tenantId, ad])
  @@index([tenantId, aktif])
  @@map("kredi_kartlari")
}

model KrediKartiHareket {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  krediKartiId        String                @map("kredi_karti_id") @db.Uuid
  tip                 KrediKartiHareketTipi
  tarih               DateTime              @db.Date
  aciklama            String
  tutar               Decimal               @db.Decimal(15, 2)
  /// Karttan çekilen toplamın cari borca uygulanan bölümü.
  cariOdemeTutari     Decimal?              @map("cari_odeme_tutari") @db.Decimal(15, 2)
  /// KSB-07: cari ödemenin bağlı faturaya mahsup edilen kısmı (en fazla kalan).
  faturaMahsubu       Decimal?              @map("fatura_mahsubu") @db.Decimal(15, 2)
  komisyonTutari      Decimal               @default(0) @map("komisyon_tutari") @db.Decimal(15, 2)
  taksitSayisi        Int                   @default(1) @map("taksit_sayisi")
  ilkTaksitTarihi     DateTime?             @map("ilk_taksit_tarihi") @db.Date
  belgeNo             String?               @map("belge_no")
  cariId              String?               @map("cari_id") @db.Uuid
  faturaId            String?               @map("fatura_id") @db.Uuid
  bankaHareketId      String?               @unique @map("banka_hareket_id") @db.Uuid
  /// KSB-08: bu kayıt, kapalı dönemdeki bir hareketin ters kaydıdır.
  geriAlinanHareketId String?               @unique @map("geri_alinan_hareket_id") @db.Uuid
  /// KSB-10: taksitsiz kalemin (faiz, aidat, iade, ters kayıt) girdiği kesinleşmiş ekstre.
  ekstreId            String?               @map("ekstre_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  krediKarti          KrediKarti            @relation(fields: [krediKartiId], references: [id], onDelete: Cascade)
  cari                CariHesap?            @relation(fields: [cariId], references: [id])
  fatura              Fatura?               @relation(fields: [faturaId], references: [id])
  bankaHareket        KasaBankaHareket?     @relation(fields: [bankaHareketId], references: [id])
  taksitler           KrediKartiTaksit[]
  masrafOdemesi       MasrafOdeme?
  ekstre              KrediKartiEkstre?     @relation(fields: [ekstreId], references: [id], onDelete: SetNull)

  kapamalar FaturaKapama[]

  @@index([tenantId, krediKartiId, tarih])
  @@index([tenantId, cariId])
  @@index([tenantId, faturaId])
  @@map("kredi_karti_hareketleri")
}

/// KSB-10: bankanın kestiği, kullanıcının banka tutarıyla kesinleştirdiği
/// dönem ekstresi. Kesinleşen ekstrenin kalemleri damgalanır; sonradan
/// geçmiş tarihe girilen kalem bir sonraki açık döneme düşer.
model KrediKartiEkstre {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  krediKartiId      String              @map("kredi_karti_id") @db.Uuid
  kesimTarihi       DateTime            @map("kesim_tarihi") @db.Date
  sonOdemeTarihi    DateTime            @map("son_odeme_tarihi") @db.Date
  /// Kesinleştirme anında hesaplanan dönem borcu (devreden dahil).
  hesaplananTutar   Decimal             @map("hesaplanan_tutar") @db.Decimal(15, 2)
  /// Bankanın ekstresindeki dönem borcu; bundan sonra borç bu tutardan yürür.
  bankaTutari       Decimal             @map("banka_tutari") @db.Decimal(15, 2)
  bankaAsgariTutari Decimal?            @map("banka_asgari_tutari") @db.Decimal(15, 2)
  userId            String?             @map("user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  krediKarti        KrediKarti          @relation(fields: [krediKartiId], references: [id], onDelete: Cascade)
  taksitler         KrediKartiTaksit[]
  hareketler        KrediKartiHareket[]

  @@unique([krediKartiId, kesimTarihi])
  @@index([tenantId, krediKartiId])
  @@map("kredi_karti_ekstreleri")
}

model KrediKartiTaksit {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  hareketId  String            @map("hareket_id") @db.Uuid
  sira       Int
  vadeTarihi DateTime          @map("vade_tarihi") @db.Date
  tutar      Decimal           @db.Decimal(15, 2)
  /// KSB-10: taksitin girdiği kesinleşmiş ekstre.
  ekstreId   String?           @map("ekstre_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hareket    KrediKartiHareket @relation(fields: [hareketId], references: [id], onDelete: Cascade)
  ekstre     KrediKartiEkstre? @relation(fields: [ekstreId], references: [id], onDelete: SetNull)

  @@unique([hareketId, sira])
  @@index([tenantId, vadeTarihi])
  @@map("kredi_karti_taksitleri")
}

enum BankaOdemeTalimatDurumu {
  onay_bekliyor
  onaylandi
  gonderildi
  /// ENT-07: bankada gerçekleşti; tediye fişi yazıldı.
  gerceklesti
