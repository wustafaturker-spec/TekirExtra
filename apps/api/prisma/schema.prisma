// ─── Tenant AI Özelleştirme & Görevler (BYOK & Kurallar & Otomasyon) ─────

model TenantAiAyari {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @unique @map("tenant_id") @db.Uuid
  saglayici                String    @default("varsayilan") @map("saglayici") // "varsayilan", "gemini", "openai", "anthropic", "ollama"
  apiKey                   String?   @map("api_key")
  modelAdi                 String?   @map("model_adi")
  ekonomikModelAdi         String?   @map("ekonomik_model_adi") @db.VarChar(120)
  gucluModelAdi            String?   @map("guclu_model_adi") @db.VarChar(120)
  /// AI-81: isteğe bağlı güçlü sağlayıcı ("Derin analiz"); null = yok, gucluModelAdi ana sağlayıcının modelidir.
  gucluSaglayici           String?   @map("guclu_saglayici")
  /// AI-81: güçlü sağlayıcının şifreli anahtarı (enc:).
  gucluApiKey              String?   @map("guclu_api_key")
  gucluBaseUrl             String?   @map("guclu_base_url")
  gucluGirisTokenMilyonUsd Decimal?  @map("guclu_giris_token_milyon_usd") @db.Decimal(12, 6)
  gucluCikisTokenMilyonUsd Decimal?  @map("guclu_cikis_token_milyon_usd") @db.Decimal(12, 6)
  /// AI-81: güçlü sağlayıcının ayrı yurt dışı aktarım onayı.
  gucluOnayAt              DateTime? @map("guclu_onay_at")
  gucluOnayUserId          String?   @map("guclu_onay_user_id") @db.Uuid
  gucluOnaySaglayici       String?   @map("guclu_onay_saglayici")
  gucluOnayModel           String?   @map("guclu_onay_model")
  gucluOnayPolitika        String?   @map("guclu_onay_politika")
  baseUrl                  String?   @map("base_url")
  ozelTalimatlar           String?   @map("ozel_talimatlar") @db.Text // "Şunları asla yapma", "Şu durumlarda dikkatli ol"
  guvenlikKurallari        Json?     @map("guvenlik_kurallari")
  /// AI-14: yurt dışındaki sağlayıcıya veri aktarımı için yönetici onayı; null = onay yok.
  yurtDisiOnayAt           DateTime? @map("yurt_disi_onay_at")
  yurtDisiOnayUserId       String?   @map("yurt_disi_onay_user_id") @db.Uuid
  yurtDisiOnaySaglayici    String?   @map("yurt_disi_onay_saglayici")
  yurtDisiOnayModel        String?   @map("yurt_disi_onay_model")
  yurtDisiOnayPolitika     String?   @map("yurt_disi_onay_politika")
  /// AI-15: kiracı başına günlük model çağrısı sınırı.
  gunlukCagriSiniri        Int       @default(1000) @map("gunluk_cagri_siniri")
  girisTokenMilyonUsd      Decimal?  @map("giris_token_milyon_usd") @db.Decimal(12, 6)
  cikisTokenMilyonUsd      Decimal?  @map("cikis_token_milyon_usd") @db.Decimal(12, 6)
  aylikMaliyetButcesiUsd   Decimal?  @map("aylik_maliyet_butcesi_usd") @db.Decimal(12, 2)
  ozelliklerEtkin          Boolean   @default(true) @map("ozellikler_etkin")
  telemetriSaklamaGun      Int       @default(90) @map("telemetri_saklama_gun")
  sohbetSaklamaGun         Int?      @map("sohbet_saklama_gun")
  telemetriHataEsigiYuzde  Int       @default(20) @map("telemetri_hata_esigi_yuzde")
  telemetriGecikmeEsigiMs  Int       @default(10000) @map("telemetri_gecikme_esigi_ms")
  guncellendiAt            DateTime  @updatedAt @map("guncellendi_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_ayarlari")
}

model AiVeriAktarimOnayi {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  olay           String   @db.VarChar(24)
  saglayici      String   @db.VarChar(40)
  model          String?  @db.VarChar(120)
  politikaSurumu String   @map("politika_surumu") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_veri_aktarim_onaylari")
}

model TenantAiGorev {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ad            String    @map("ad")
  tetikleyici   String    @map("tetikleyici") // "ZAMANLANMIS", "VADE_GECIKMESI", "KASA_KRITIK"
  /// AI-23/AI-83: "ASISTAN" (talimat dil modeline gider) | "NAKIT_TAHSILAT" (deterministik analiz, model yok) | "BRIFING" (günlük brifing).
  tur           String    @default("ASISTAN") @map("tur")
  zamanlamaCron String?   @map("zamanlama_cron") // Örn: "09:00" veya "0 9 * * *"
  gorevTalimati String    @map("gorev_talimati") @db.Text
  kanal         String    @default("PANEL") @map("kanal") // AI-16: kullanılmıyor; sonuç bildirim olarak gelir
  hedefKimlik   String?   @map("hedef_kimlik")
  aktif         Boolean   @default(true) @map("aktif")
  sonCalisma    DateTime? @map("son_calisma")
  sonSonuc      String?   @map("son_sonuc") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  /// AI-16: görev bu kullanıcının kimliği ve güncel rolüyle çalışır; sonuç ona bildirilir.
  userId        String?   @map("user_id") @db.Uuid
  /// AI-16: çalışacağı günler (1 = Pazartesi … 7 = Pazar); boş = her gün. Saat `zamanlamaCron` ("HH:MM").
  gunler        Int[]     @default([]) @map("gunler")
  /// AI-16: KASA_KRITIK eşiği (TL); nakit varlıklar bunun altına inince çalışır.
  esikTutar     Decimal?  @map("esik_tutar") @db.Decimal(15, 2)
  /// AI-16: aynı gün ikinci kez çalışmasın.
  sonTetikGunu  DateTime? @map("son_tetik_gunu") @db.Date

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calismalar TenantAiGorevCalisma[]
  icgoruler  AiIcgoru[]

  @@index([tenantId, aktif])
  @@map("tenant_ai_gorevleri")
}

/// AI-24: deterministik nakit/tahsilat analizinin sonucu. Görev başına günde tek kayıt
/// (`tekilAnahtar`); elle çalıştırma `elle:<gün>` anahtarını kullanır. 90 gün saklanır.
model AiIcgoru {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  gorevId      String?  @map("gorev_id") @db.Uuid
  /// Analizi kimin kimliği ve rolüyle hesaplandı.
  userId       String   @map("user_id") @db.Uuid
  tekilAnahtar String   @map("tekil_anahtar") @db.VarChar(120)
  onem         String   @map("onem") // kritik | uyari | bilgi
  durum        String   @default("yeni") @map("durum") // yeni | goruldu | cozuldu
  baslik       String   @db.VarChar(200)
  ozet         String   @db.Text
  metrikler    Json     @default("{}")
  bulgular     Json     @default("[]")
  kanitlar     Json     @default("[]")
  varsayimlar  Json     @default("[]")
  uyarilar     Json     @default("[]")
  hesaplandiAt DateTime @map("hesaplandi_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gorev  TenantAiGorev? @relation(fields: [gorevId], references: [id], onDelete: SetNull)

  @@unique([tenantId, tekilAnahtar])
  @@index([tenantId, durum, hesaplandiAt])
  @@map("ai_icgoruler")
}

enum AiGorevCalismaDurumu {
  calisiyor
  basarili
  hata
  kosul_saglanmadi
}

/// Her zamanlama penceresi için tek kayıt; benzersiz anahtar çoklu worker'ın
/// aynı görevi iki kez çalıştırmasını önler ve yeniden denemeleri denetlenebilir kılar.
model TenantAiGorevCalisma {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  gorevId          String               @map("gorev_id") @db.Uuid
  tetikGunu        DateTime             @map("tetik_gunu") @db.Date
  durum            AiGorevCalismaDurumu
  deneme           Int                  @default(1)
  sahiplikAnahtari String               @map("sahiplik_anahtari") @db.Uuid
  sonrakiDenemeAt  DateTime?            @map("sonraki_deneme_at")
  basladiAt        DateTime             @default(now()) @map("basladi_at")
  bittiAt          DateTime?            @map("bitti_at")
  sonuc            String?              @db.Text
  hata             String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  guncellendiAt    DateTime             @updatedAt @map("guncellendi_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gorev  TenantAiGorev @relation(fields: [gorevId], references: [id], onDelete: Cascade)

  @@unique([gorevId, tetikGunu])
  @@index([tenantId, durum, sonrakiDenemeAt])
  @@map("tenant_ai_gorev_calismalari")
}

// Söz kimliği değişmeden ikinci e-posta çıkmaz. Belirsiz SMTP sonucu otomatik tekrarlanmaz.
model OdemeSozuHatirlatma {
  tenantId        String    @map("tenant_id") @db.Uuid
  sozId           String    @map("soz_id") @db.Uuid
  durum           String    @default("gonderiliyor")
  deneme          Int       @default(1)
  alici           String    @db.VarChar(255)
  konu            String    @db.VarChar(255)
  messageId       String?   @map("message_id") @db.VarChar(255)
  hataMesaji      String?   @map("hata_mesaji") @db.VarChar(1000)
  baslangicAt     DateTime  @default(now()) @map("baslangic_at")
  gonderildiAt    DateTime? @map("gonderildi_at")
  sonrakiDenemeAt DateTime? @map("sonraki_deneme_at")
  soz             OdemeSozu @relation(fields: [tenantId, sozId], references: [tenantId, id])

  @@id([tenantId, sozId])
  @@map("odeme_sozu_hatirlatmalari")
}

/// EBLG-141: ön denetim uyarıları geçilerek yapılan gönderim kararı.
model OnDenetimKarari {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Giden: gönderilen fatura; gelen (EBLG-150): işlenen gelen belge. İkisinden yalnız biri dolu.
  faturaId      String?  @map("fatura_id") @db.Uuid
  gelenEbelgeId String?  @map("gelen_ebelge_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  /// Geçilen uyarılar: [{kod, satir, mesaj}]
  bulgular      Json
  gerekce       String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gelenEbelge GelenEbelge? @relation(fields: [gelenEbelgeId], references: [id], onDelete: Cascade)

  @@index([tenantId, faturaId])
  @@index([tenantId, gelenEbelgeId])
  @@index([tenantId, createdAt])
  @@map("on_denetim_kararlari")
}

/// CARI-57: "aynı değil" işareti; çift (cari_a_id < cari_b_id) mükerrer raporunda çıkmaz.
model CariMukerrerIstisna {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cariAId   String   @map("cari_a_id") @db.Uuid
  cariBId   String   @map("cari_b_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cariAId, cariBId])
  @@map("cari_mukerrer_istisnalari")
}

/// CARI-62: cari birleştirme izi. Geri alma yoktur; tablo başına taşınan satır sayısı ve doldurulan kart alanları saklanır.
model CariBirlestirme {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  anaCariId     String   @map("ana_cari_id") @db.Uuid
  tasinanCariId String   @map("tasinan_cari_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  /// { tablo.sutun: taşınan satır }, { tablo: düşen kopya satır }
  tasinanlar    Json
  dusenler      Json
  /// Ana kartta boşken taşınan karttan doldurulan alanlar: { alan: değer }
  doldurulanlar Json
  /// Onay anında gösterilen uyarılar.
  uyarilar      Json
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, anaCariId])
  @@index([tenantId, tasinanCariId])
  @@map("cari_birlestirmeleri")
}

/// EBLG-141: cari başına "bu kuralı gösterme".
model OnDenetimSusturma {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cariId    String   @map("cari_id") @db.Uuid
  kod       String
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cariId, kod])
  @@map("on_denetim_susturmalari")
}

// ─── Demirbaş ve Sabit Kıymet (DMR, §3.20) ─────────────────────────────────

/// DMR-01: sabit kıymet kartı. Bedel TL'dir (dövizli alışta döviz tutarı ve kur
/// bilgi için saklanır). Açılış kartı (DMR-11) muhasebe fişi üretmez; birikmiş
/// amortismanı `acilisSonYil` dahil o güne kadar ayrılmış tutardır.
model Demirbas {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  kod                String
  ad                 String
  /// bina | tesis_makine | tasit | demirbas | hak | ozel_maliyet
  sinif              String
  /// Boşsa sınıfın Muhasebe Aktarımı ayarındaki hesabı.
  hesapKodu          String?    @map("hesap_kodu")
  /// Boşsa amortisman gider hesabı ayarı (770).
  giderHesapKodu     String?    @map("gider_hesap_kodu")
  /// VUK amortisman listesindeki sıra no (ör. "4.1"); listede yoksa boş.
  listeKodu          String?    @map("liste_kodu")
  faydaliOmur        Int        @map("faydali_omur")
  /// normal | azalan
  yontem             String     @default("normal")
  /// DMR-04: azalan bakiyelerden normale geçilen yıl.
  normaleGecisYili   Int?       @map("normale_gecis_yili")
  binekOto           Boolean    @default(false) @map("binek_oto")
  /// DMR-06: ÖTV/KDV maliyete eklendi ya da ikinci el (yüksek sınır).
  binekVergili       Boolean    @default(false) @map("binek_vergili")
  /// DMR-06: binek oto kiralama/işletme faaliyeti — sınır uygulanmaz.
  binekSinirYok      Boolean    @default(false) @map("binek_sinir_yok")
  edinmeTarihi       DateTime   @map("edinme_tarihi") @db.Date
  edinmeBedeli       Decimal    @map("edinme_bedeli") @db.Decimal(15, 2)
  dovizCinsi         DovizCinsi @default(TRY) @map("doviz_cinsi")
  dovizTutari        Decimal?   @map("doviz_tutari") @db.Decimal(15, 2)
  kur                Decimal?   @db.Decimal(15, 6)
  tedarikciCariId    String?    @map("tedarikci_cari_id") @db.Uuid
  /// DMR-02: kaynağı olan alış faturası satırı (adet başına bölünmüş kartlar aynı satırı gösterir).
  faturaSatirId      String?    @map("fatura_satir_id") @db.Uuid
  seriNo             String?    @map("seri_no")
  konum              String?
  aciklama           String?
  /// kullanimda | elden_cikti
  durum              String     @default("kullanimda")
  acilis             Boolean    @default(false)
  acilisBirikmis     Decimal    @default(0) @map("acilis_birikmis") @db.Decimal(15, 2)
  acilisSonYil       Int?       @map("acilis_son_yil")
  /// DMR-08: satis | hurda | kayip | bagis
  cikisTuru          String?    @map("cikis_turu")
  cikisTarihi        DateTime?  @map("cikis_tarihi") @db.Date
  cikisBedeli        Decimal?   @map("cikis_bedeli") @db.Decimal(15, 2)
  cikisFaturaSatirId String?    @map("cikis_fatura_satir_id") @db.Uuid
  cikisGerekcesi     String?    @map("cikis_gerekcesi")
  /// Çıkış anındaki birikmiş amortisman (açılış + kesin satırlar).
  cikisBirikmis      Decimal?   @map("cikis_birikmis") @db.Decimal(15, 2)
  cikisUserId        String?    @map("cikis_user_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")

  ilaveBedeller DemirbasIlaveBedel[]
  amortismanlar AmortismanSatiri[]
  zimmetler     DemirbasZimmet[]

  @@unique([tenantId, kod])
  @@index([tenantId, durum])
  @@index([tenantId, faturaSatirId])
  @@map("demirbaslar")
}

/// DMR-02: edinme bedeline eklenen nakliye, montaj vb.; ilk amortisman kesinleşmeden önce.
model DemirbasIlaveBedel {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  demirbasId    String   @map("demirbas_id") @db.Uuid
  tarih         DateTime @db.Date
  tutar         Decimal  @db.Decimal(15, 2)
  faturaSatirId String?  @map("fatura_satir_id") @db.Uuid
  aciklama      String
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  demirbas      Demirbas @relation(fields: [demirbasId], references: [id], onDelete: Cascade)

  @@index([tenantId, demirbasId])
  @@index([tenantId, faturaSatirId])
  @@map("demirbas_ilave_bedelleri")
}

/// DMR-07: yıl sonu amortisman çalıştırması. Bir yılın yalnız bir kesin kaydı olur;
/// geri alınan kayıt iz olarak kalır.
model AmortismanDonemi {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  yil                 Int
  /// kesin | geri_alindi
  durum               String             @default("kesin")
  toplam              Decimal            @db.Decimal(15, 2)
  toplamKkeg          Decimal            @default(0) @map("toplam_kkeg") @db.Decimal(15, 2)
  kesinlestirenUserId String?            @map("kesinlestiren_user_id") @db.Uuid
  kesinlesmeAt        DateTime           @default(now()) @map("kesinlesme_at")
  geriAlanUserId      String?            @map("geri_alan_user_id") @db.Uuid
  geriAlmaAt          DateTime?          @map("geri_alma_at")
  geriAlmaGerekcesi   String?            @map("geri_alma_gerekcesi")
  satirlar            AmortismanSatiri[]

  @@index([tenantId, yil])
  @@map("amortisman_donemleri")
}

model AmortismanSatiri {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  donemId      String           @map("donem_id") @db.Uuid
  demirbasId   String           @map("demirbas_id") @db.Uuid
  yil          Int
  tutar        Decimal          @db.Decimal(15, 2)
  /// DMR-06: binek oto sınırını aşan kısım (kanunen kabul edilmeyen gider).
  kkeg         Decimal          @default(0) @db.Decimal(15, 2)
  birikmisOnce Decimal          @map("birikmis_once") @db.Decimal(15, 2)
  donem        AmortismanDonemi @relation(fields: [donemId], references: [id], onDelete: Cascade)
  demirbas     Demirbas         @relation(fields: [demirbasId], references: [id], onDelete: Cascade)

  @@unique([donemId, demirbasId])
  @@index([tenantId, demirbasId, yil])
  @@map("amortisman_satirlari")
}

/// DMR-10: zimmet geçmişi; açık zimmetin bitişi boştur.
model DemirbasZimmet {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  demirbasId String    @map("demirbas_id") @db.Uuid
  personelId String?   @map("personel_id") @db.Uuid
  konum      String?
  baslangic  DateTime  @db.Date
  bitis      DateTime? @db.Date
  aciklama   String?
  userId     String?   @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  demirbas   Demirbas  @relation(fields: [demirbasId], references: [id], onDelete: Cascade)

  @@index([tenantId, demirbasId])
  @@index([tenantId, personelId])
  @@map("demirbas_zimmetleri")
}

// ─── Araç Takibi (ARC, §3.21) ──────────────────────────────────────────────

/// ARC-03: muayene, sigorta, kasko, MTV…; yenileme yeni kayıttır, türün son kaydı geçerlidir.
model AracYukumluluk {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  aracId    String    @map("arac_id") @db.Uuid
  tur       String
  baslangic DateTime? @db.Date
  bitis     DateTime  @db.Date
  belgeNo   String?   @map("belge_no")
  tutar     Decimal?  @db.Decimal(15, 2)
  aciklama  String?
  userId    String?   @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  arac      Arac      @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, aracId, tur])
  @@map("arac_yukumlulukleri")
}

/// ARC-05: onaylı masraf ya da kesin alış faturası satırının araca bağı (raporlama; muhasebe değişmez).
model AracGider {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  aracId        String   @map("arac_id") @db.Uuid
  masrafId      String?  @map("masraf_id") @db.Uuid
  faturaSatirId String?  @map("fatura_satir_id") @db.Uuid
  kategori      String
  tarih         DateTime @db.Date
  /// KDV hariç TL tutar (belge kuruyla).
  tutarTry      Decimal  @map("tutar_try") @db.Decimal(15, 2)
  litre         Decimal? @db.Decimal(10, 2)
  km            Int?
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  arac          Arac     @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, aracId, tarih])
  @@map("arac_giderleri")
}

/// ARC-08: km geçmişi (elle, gider ya da bakım).
model AracKmKaydi {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  aracId    String   @map("arac_id") @db.Uuid
  tarih     DateTime @db.Date
  km        Int
  kaynak    String
  kaynakId  String?  @map("kaynak_id") @db.Uuid
  gerekce   String?
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  arac      Arac     @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, aracId, tarih])
  @@map("arac_km_kayitlari")
}

/// ARC-07: yapılan bakım; planı ilerletir.
model AracBakim {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  aracId      String   @map("arac_id") @db.Uuid
  tarih       DateTime @db.Date
  km          Int?
  aciklama    String
  aracGiderId String?  @map("arac_gider_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  arac        Arac     @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, aracId, tarih])
  @@map("arac_bakimlari")
}

/// ARC-09: trafik cezası; sürücü o tarihteki sorumlu personeldir.
model AracCeza {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  aracId      String   @map("arac_id") @db.Uuid
  tarih       DateTime @db.Date
  tutar       Decimal  @db.Decimal(15, 2)
  ihlal       String
  yer         String?
  personelId  String?  @map("personel_id") @db.Uuid
  tahsilNotu  String?  @map("tahsil_notu")
  aracGiderId String?  @map("arac_gider_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  arac        Arac     @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, aracId, tarih])
  @@map("arac_cezalari")
}

/// PLT-16: zamanlayıcı/iş başına son durum (kiracı verisi taşımaz).
model SistemIsi {
  isAdi         String    @id @map("is_adi") @db.VarChar(80)
  sonBaslangic  DateTime? @map("son_baslangic")
  sonBitis      DateTime? @map("son_bitis")
  sonSureMs     Int?      @map("son_sure_ms")
  sonBasariAt   DateTime? @map("son_basari_at")
  sonHata       String?   @map("son_hata") @db.VarChar(1000)
  sonHataAt     DateTime? @map("son_hata_at")
  ardisikHata   Int       @default(0) @map("ardisik_hata")
  calismaSayisi BigInt    @default(0) @map("calisma_sayisi")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  @@map("sistem_isleri")
}

/// PLT-16: süreç açılışı + nabız; worker yeniden başlamaları buradan sayılır.
model SistemSureci {
  id          String   @id @db.Uuid
  tur         String   @db.VarChar(20)
  makine      String?  @db.VarChar(120)
  pid         Int?
  basladiAt   DateTime @default(now()) @map("basladi_at")
  sonNabizAt  DateTime @default(now()) @map("son_nabiz_at")
  rssMb       Int?     @map("rss_mb")
  heapMb      Int?     @map("heap_mb")
  heapSinirMb Int?     @map("heap_sinir_mb")

  @@index([tur, basladiAt(sort: Desc)], map: "sistem_surecleri_tur_basladi_idx")
  @@map("sistem_surecleri")
}

/// PLT-19: alarm durumu; e-posta tekilliği ve "düzeldi" bildirimi buradan.
model SistemAlarmi {
  anahtar       String    @id @db.VarChar(160)
  tur           String    @db.VarChar(40)
  acik          Boolean   @default(true)
  ozet          String    @db.VarChar(1000)
  ilkAt         DateTime  @default(now()) @map("ilk_at")
  sonGorulmeAt  DateTime  @default(now()) @map("son_gorulme_at")
  sonBildirimAt DateTime? @map("son_bildirim_at")
  kapandiAt     DateTime? @map("kapandi_at")

  @@map("sistem_alarmlari")
}

/// PLT-20: abonelik faturasını kesen firma (TekirExtra'nın kendi kiracısı) ve
/// tahsilat hesapları. Tek satır; yalnız platform yazar.
model AbonelikFaturaAyari {
  id                  Int                @id @default(1) @db.SmallInt
  faturalayanTenantId String?            @map("faturalayan_tenant_id") @db.Uuid
  kartHesapTur        String?            @map("kart_hesap_tur") @db.VarChar(10)
  kartHesapId         String?            @map("kart_hesap_id") @db.Uuid
  elleHesapTur        String?            @map("elle_hesap_tur") @db.VarChar(10)
  elleHesapId         String?            @map("elle_hesap_id") @db.Uuid
  /// Bu andan önceki ödemeler faturalanmaz.
  baslangicAt         DateTime?          @map("baslangic_at")
  guncelleyenId       String?            @map("guncelleyen_id") @db.Uuid
  updatedAt           DateTime           @default(now()) @map("updated_at")
  faturalayan         Tenant?            @relation(fields: [faturalayanTenantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  guncelleyen         PlatformKullanici? @relation(fields: [guncelleyenId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("abonelik_fatura_ayari")
}

/// PLT-21…23: ödeme başına tek abonelik faturası ve tahsilatı (iki kiracıyı bağlar).
model AbonelikFaturasi {
  odemeId             String          @id @map("odeme_id") @db.Uuid
  odeyenTenantId      String          @map("odeyen_tenant_id") @db.Uuid
  faturalayanTenantId String          @map("faturalayan_tenant_id") @db.Uuid
  faturaId            String?         @map("fatura_id") @db.Uuid
  faturaNo            String?         @map("fatura_no") @db.VarChar(40)
  /// bekliyor | taslak | kesinlesti | tahsil_edildi | hata
  durum               String          @default("bekliyor") @db.VarChar(20)
  hata                String?         @db.VarChar(500)
  tahsilatHareketId   String?         @map("tahsilat_hareket_id") @db.Uuid
  deneme              Int             @default(0)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @map("updated_at")
  odeme               AbonelikOdemesi @relation(fields: [odemeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  odeyen              Tenant          @relation("AbonelikFaturasiOdeyen", fields: [odeyenTenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  faturalayan         Tenant          @relation("AbonelikFaturasiFaturalayan", fields: [faturalayanTenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([odeyenTenantId], map: "abonelik_faturalari_odeyen_idx")
  @@map("abonelik_faturalari")
}

enum PlatformGorevKapsami {
  mevzuat
  platform
}

enum PlatformGorevDurumu {
  acik
  devam_ediyor
  tamamlandi
  iptal
}

enum PlatformGorevOnceligi {
  dusuk
  normal
  yuksek
}

/// Platform ekibinin kalıcı görevleri. Kiracı bağlantısına açılmaz.
model PlatformGorev {
  id String @id @default(uuid()) @db.Uuid
  baslik String @db.VarChar(200)
  aciklama String? @db.VarChar(4000)
  kapsam PlatformGorevKapsami @default(mevzuat)
  durum PlatformGorevDurumu @default(acik)
  oncelik PlatformGorevOnceligi @default(normal)
  sonTarih DateTime? @map("son_tarih") @db.Date
  sorumluId String? @map("sorumlu_id") @db.Uuid
  olusturanId String @map("olusturan_id") @db.Uuid
  degisiklikId String? @map("degisiklik_id") @db.Uuid
  surum Int @default(1)
  kapanisAt DateTime? @map("kapanis_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sorumlu PlatformKullanici? @relation("GorevSorumlusu", fields: [sorumluId], references: [id], onDelete: SetNull)
  olusturan PlatformKullanici @relation("GoreviOlusturan", fields: [olusturanId], references: [id], onDelete: Restrict)
  degisiklik MevzuatDegisiklik? @relation(fields: [degisiklikId], references: [id], onDelete: SetNull)

  @@index([kapsam, durum, sonTarih])
  @@index([sorumluId, durum])
  @@map("platform_gorevleri")
}
