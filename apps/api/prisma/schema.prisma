  notlar          String?
  aktif           Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cari                 CariHesap?         @relation(fields: [cariId], references: [id])
  sorumlu              User?              @relation("ProjeSorumlu", fields: [sorumluUserId], references: [id])
  asamalar             ProjeAsama[]
  altKirilimlar        ProjeAltKirilim[]
  notlarListesi        ProjeNot[]
  faturaSatirlari      FaturaSatir[]
  masraflar            Masraf[]
  gelirKayitlari       GelirKaydi[]
  kasaBankaHareketleri KasaBankaHareket[]

  @@unique([tenantId, kod])
  @@index([tenantId, durum])
  @@index([tenantId, cariId])
  @@map("projeler")
}

model ProjeAsama {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  projeId          String    @map("proje_id") @db.Uuid
  sira             Int       @default(0)
  ad               String
  aciklama         String?
  baslangicTarihi  DateTime? @map("baslangic_tarihi") @db.Date
  bitisTarihi      DateTime? @map("bitis_tarihi") @db.Date
  tamamlandi       Boolean   @default(false)
  tamamlanmaTarihi DateTime? @map("tamamlanma_tarihi")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proje  Proje  @relation(fields: [projeId], references: [id], onDelete: Cascade)

  @@index([tenantId, projeId, sira])
  @@map("proje_asamalari")
}

model ProjeAltKirilim {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  projeId     String              @map("proje_id") @db.Uuid
  kod         String
  ad          String
  tip         ProjeAltKirilimTipi @default(gider)
  butceTutari Decimal             @default(0) @map("butce_tutari") @db.Decimal(15, 2)
  aciklama    String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proje                Proje              @relation(fields: [projeId], references: [id], onDelete: Cascade)
  faturaSatirlari      FaturaSatir[]
  masraflar            Masraf[]
  gelirKayitlari       GelirKaydi[]
  kasaBankaHareketleri KasaBankaHareket[]

  @@unique([tenantId, projeId, kod])
  @@index([tenantId, projeId])
  @@map("proje_alt_kirilimlari")
}

model ProjeNot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projeId   String   @map("proje_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  icerik    String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proje  Proje  @relation(fields: [projeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, projeId, createdAt])
  @@map("proje_notlari")
}

model DuzeltmeKaydi {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  tur              DuzeltmeTuru
  onem             DuzeltmeOnemi  @default(uyari)
  durum            DuzeltmeDurumu @default(acik)
  kaynakTur        String         @map("kaynak_tur")
  kaynakRef        String         @map("kaynak_ref")
  nedenKodu        String         @map("neden_kodu")
  tekillikAnahtari String?        @map("tekillik_anahtari")
  aciklama         String
  onerilenEylem    String?        @map("onerilen_eylem")
  atananUserId     String?        @map("atanan_user_id") @db.Uuid
  sonTarih         DateTime?      @map("son_tarih")
  cozenUserId      String?        @map("cozen_user_id") @db.Uuid
  cozulmeTarihi    DateTime?      @map("cozulme_tarihi")
  sonTespitTarihi  DateTime       @default(now()) @map("son_tespit_tarihi")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  atanan  User?           @relation("DuzeltmeAtanan", fields: [atananUserId], references: [id])
  cozen   User?           @relation("DuzeltmeCozen", fields: [cozenUserId], references: [id])
  olaylar DuzeltmeOlayi[]

  @@unique([tenantId, tekillikAnahtari])
  @@index([tenantId, durum, onem, createdAt])
  @@index([tenantId, atananUserId, durum])
  @@index([tenantId, tur, durum])
  @@map("duzeltme_kayitlari")
}

model DuzeltmeOlayi {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  duzeltmeKaydiId String          @map("duzeltme_kaydi_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  oncekiDurum     DuzeltmeDurumu? @map("onceki_durum")
  yeniDurum       DuzeltmeDurumu? @map("yeni_durum")
  olayTuru        String          @map("olay_turu")
  aciklama        String?
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  duzeltmeKaydi DuzeltmeKaydi @relation(fields: [duzeltmeKaydiId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([tenantId, duzeltmeKaydiId, createdAt])
  @@map("duzeltme_olaylari")
}

enum BildirimTuru {
  duzeltme
  ebelge
  vade
  cek_senet
  stok
  donem
  entegrasyon
  satin_alma
  /// PRS-15 (P2-2): özlük belgesi süresi, onay bekleyen İK işleri.
  personel
  /// MVZ-07: platform ekibinin yayınladığı mevzuat değişikliği.
  mevzuat
  /// AI-04: kullanıcının onayını bekleyen yapay zekâ işlemi.
  yapay_zeka
  /// AI-40/41: gönderilen teklife yanıt yok, geçerlilik bitiyor.
  teklif
}

enum BildirimOnemi {
  bilgi
  uyari
  kritik
}

/// Teslimatın kullanıcı bazındaki durumu. `okundu` ile `aksiyon_alindi` bilerek
/// ayrıdır: bildirimi görmek onu sahiplenmek değildir (BLD-02).
enum BildirimTeslimatDurumu {
  yeni
  okundu
  ustlenildi
  aksiyon_alindi
  yoksayildi
}

enum BildirimKanalDurumu {
  beklemede
  gonderildi
  hata
  kapali
}

/// Bir olayın kalıcı kaydı. Aynı kaynak kayıt için ikinci bildirim üretilmez;
/// olay sürdükçe `sonTespitTarihi` güncellenir, çözüldüğünde `kapandiAt` dolar.
model Bildirim {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tur              BildirimTuru
  onem             BildirimOnemi @default(uyari)
  baslik           String
  aciklama         String
  kaynakTur        String?       @map("kaynak_tur")
  kaynakRef        String?       @map("kaynak_ref")
  hedefYol         String?       @map("hedef_yol")
  birlesimAnahtari String        @map("birlesim_anahtari")
  sonTarih         DateTime?     @map("son_tarih")
  yukseltildiAt    DateTime?     @map("yukseltildi_at")
  kapandiAt        DateTime?     @map("kapandi_at")
  sonTespitTarihi  DateTime      @default(now()) @map("son_tespit_tarihi")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teslimatlar BildirimTeslimati[]

  @@unique([tenantId, birlesimAnahtari])
  @@index([tenantId, kapandiAt, onem, createdAt])
  @@index([tenantId, tur, kapandiAt])
  @@map("bildirimler")
}

/// Bildirimin tek bir kullanıcıya teslimi. E-posta kanalının durumu da burada
/// tutulur; kritik olayın teslim edildiği ancak bu kayıtla kanıtlanabilir.
model BildirimTeslimati {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  bildirimId         String                 @map("bildirim_id") @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  durum              BildirimTeslimatDurumu @default(yeni)
  okunduAt           DateTime?              @map("okundu_at")
  ustlenildiAt       DateTime?              @map("ustlenildi_at")
  aksiyonAt          DateTime?              @map("aksiyon_at")
  aksiyonNotu        String?                @map("aksiyon_notu")
  epostaDurumu       BildirimKanalDurumu    @default(beklemede) @map("eposta_durumu")
  epostaGonderildiAt DateTime?              @map("eposta_gonderildi_at")
  epostaDenemeSayisi Int                    @default(0) @map("eposta_deneme_sayisi")
  epostaHatasi       String?                @map("eposta_hatasi")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bildirim  Bildirim @relation(fields: [bildirimId], references: [id], onDelete: Cascade)
  kullanici User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bildirimId, userId])
  @@index([tenantId, userId, durum])
  @@index([tenantId, epostaDurumu])
  @@map("bildirim_teslimatlari")
}

/// Kullanıcının olay türü bazında kanal tercihi. Satır yoksa iki kanal da açıktır.
model BildirimTercihi {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  tur         BildirimTuru
  uygulamaIci Boolean      @default(true) @map("uygulama_ici")
  eposta      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullanici User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, tur])
  @@map("bildirim_tercihleri")
}

/// Sessiz saat kullanıcı geneli tutulur; tür bazında olması kullanıcıya anlam
/// ifade etmeyen bir ayar karmaşası yaratırdı.
model BildirimKullaniciAyari {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  sessizBaslangic String?  @map("sessiz_baslangic")
  sessizBitis     String?  @map("sessiz_bitis")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullanici User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("bildirim_kullanici_ayarlari")
}

/// Reçetenin süreye bağlı olmayan ek gideri (enerji, ambalaj, genel gider payı…).
model ReceteGider {
  id       String             @id @default(uuid()) @db.Uuid
  tenantId String             @map("tenant_id") @db.Uuid
  receteId String             @map("recete_id") @db.Uuid
  sira     Int
  ad       String
  yontem   ReceteGiderYontemi
  /// Yüzde ya da TL (yönteme göre).
  deger    Decimal            @db.Decimal(15, 4)

  recete UrunRecetesi @relation(fields: [receteId], references: [id], onDelete: Cascade)

  @@unique([receteId, sira])
  @@index([tenantId])
  @@map("recete_giderleri")
}

/// Emir açılırken reçeteden kopyalanan ek gider; plan ve gerçekleşen ayrı izlenir.
model UretimEmriGider {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  uretimEmriId     String             @map("uretim_emri_id") @db.Uuid
  sira             Int
  ad               String
  yontem           ReceteGiderYontemi
  deger            Decimal            @db.Decimal(15, 4)
  planlananTutar   Decimal            @default(0) @map("planlanan_tutar") @db.Decimal(15, 4)
  gerceklesenTutar Decimal            @default(0) @map("gerceklesen_tutar") @db.Decimal(15, 4)

  uretimEmri UretimEmri @relation(fields: [uretimEmriId], references: [id], onDelete: Cascade)

  @@unique([uretimEmriId, sira])
  @@index([tenantId])
  @@map("uretim_emri_giderleri")
}

/// MUH-02/06: firmanın hesap kodu düzeltmeleri ve aktarım dosyası profili.
model MuhasebeAyari {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  hesapKodlari   Json     @default("{}") @map("hesap_kodlari")
  aktarimProfili Json?    @map("aktarim_profili")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("muhasebe_ayarlari")
}

/// MUH-07: yapılan muhasebe aktarımı; parmak izi sonradan değişikliği yakalar.
model MuhasebeAktarimi {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  baslangic   DateTime @db.Date
  bitis       DateTime @db.Date
  bicim       String
  fisSayisi   Int      @map("fis_sayisi")
  satirSayisi Int      @map("satir_sayisi")
  borcToplami Decimal  @map("borc_toplami") @db.Decimal(18, 2)
  parmakIzi   String   @map("parmak_izi")
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("muhasebe_aktarimlari")
}

/// KRD-01: banka kredisi. Rotatifte anapara limittir.
model BankaKredisi {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  bankaHesapId    String              @map("banka_hesap_id") @db.Uuid
  ad              String
  tur             String
  planTuru        String?             @map("plan_turu")
  dovizCinsi      DovizCinsi          @default(TRY) @map("doviz_cinsi")
  anapara         Decimal             @db.Decimal(15, 2)
  aylikFaiz       Decimal             @map("aylik_faiz") @db.Decimal(9, 4)
  bsmvOrani       Decimal             @default(5) @map("bsmv_orani") @db.Decimal(5, 2)
  kkdfOrani       Decimal             @default(0) @map("kkdf_orani") @db.Decimal(5, 2)
  kullanimTarihi  DateTime            @map("kullanim_tarihi") @db.Date
  taksitSayisi    Int?                @map("taksit_sayisi")
  ilkTaksitTarihi DateTime?           @map("ilk_taksit_tarihi") @db.Date
  vadeTarihi      DateTime?           @map("vade_tarihi") @db.Date
  tahsisUcreti    Decimal             @default(0) @map("tahsis_ucreti") @db.Decimal(15, 2)
  /// KRD-08 / MUH-03: kredinin alt hesap kodu; boşsa 300.01.<sıra>.
  muhasebeKodu    String?             @map("muhasebe_kodu")
  durum           String              @default("aktif")
  aciklama        String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at")
  taksitler       BankaKrediTaksiti[]
  islemler        BankaKrediIslemi[]

  @@index([tenantId, durum])
  @@map("banka_kredileri")
}

/// KRD-03/04: kullanım, taksit ödemesi, rotatif geri ödeme ve faiz tahsili; her biri tek banka hareketi.
model BankaKrediIslemi {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  krediId           String             @map("kredi_id") @db.Uuid
  tip               String
  tarih             DateTime           @db.Date
  anapara           Decimal            @default(0) @db.Decimal(15, 2)
  faiz              Decimal            @default(0) @db.Decimal(15, 2)
  bsmv              Decimal            @default(0) @db.Decimal(15, 2)
  kkdf              Decimal            @default(0) @db.Decimal(15, 2)
  masraf            Decimal            @default(0) @db.Decimal(15, 2)
  /// KRD-08: kullanımda vadesi 12 aydan sonraki anapara (400'e yazılır).
  uzunVadeliAnapara Decimal            @default(0) @map("uzun_vadeli_anapara") @db.Decimal(15, 2)
  hareketId         String             @unique @map("hareket_id") @db.Uuid
  masrafId          String?            @unique @map("masraf_id") @db.Uuid
  aciklama          String?
  userId            String?            @map("user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  kredi             BankaKredisi       @relation(fields: [krediId], references: [id], onDelete: Cascade)
  taksit            BankaKrediTaksiti?

  @@index([krediId])
  @@map("banka_kredi_islemleri")
}

/// KRD-02: ödeme planı satırı; ödenince işleme bağlanır.
model BankaKrediTaksiti {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  krediId    String            @map("kredi_id") @db.Uuid
  sira       Int
  vadeTarihi DateTime          @map("vade_tarihi") @db.Date
  anapara    Decimal           @db.Decimal(15, 2)
  faiz       Decimal           @db.Decimal(15, 2)
  bsmv       Decimal           @db.Decimal(15, 2)
  kkdf       Decimal           @db.Decimal(15, 2)
  islemId    String?           @unique @map("islem_id") @db.Uuid
  kredi      BankaKredisi      @relation(fields: [krediId], references: [id], onDelete: Cascade)
  islem      BankaKrediIslemi? @relation(fields: [islemId], references: [id], onDelete: SetNull)

  @@unique([krediId, sira])
  @@index([tenantId, vadeTarihi])
  @@map("banka_kredi_taksitleri")
}

/// STK-28: maliyeti yeniden hesaplamanın değiştirdiği hareket maliyetleri;
/// yalnız eklenir (hareketin eski değeri kaybolmasın).
model StokMaliyetDuzeltme {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  hareketId   String   @map("hareket_id") @db.Uuid
  calismaId   String   @map("calisma_id") @db.Uuid
  eskiMaliyet Decimal  @map("eski_maliyet") @db.Decimal(15, 4)
  yeniMaliyet Decimal  @map("yeni_maliyet") @db.Decimal(15, 4)
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hareket StokHareket @relation(fields: [hareketId], references: [id], onDelete: Cascade)

  @@index([tenantId, hareketId])
  @@index([tenantId, calismaId])
  @@map("stok_maliyet_duzeltmeleri")
}

// ─── Mevzuat Merkezi (MVZ, 2026-10-09) ─────────────────────────────────────
// Kiracıya ait olmayan tablolar: RLS yoktur. Uygulama rolü (tekir_app)
// mevzuat kayıtlarını ve yayınlanan değişiklikleri yalnız okur; yazma
// platform rolüyle (tekir_platform, DATABASE_URL_PLATFORM) yapılır (MVZ-16).

/// PLT-06: platform ekibi rolleri.
enum PlatformRol {
  yonetici
  mevzuat_editoru
}

/// MVZ-04: platform ekibi kullanıcısı; kiracı kullanıcılarından ayrıdır, hiçbir kiracı verisine erişmez.
model PlatformKullanici {
  id                 String      @id @default(uuid()) @db.Uuid
  eposta             String      @unique
  adSoyad            String      @map("ad_soyad")
  parolaHash         String      @map("parola_hash")
  /// İki adımlı doğrulama zorunludur; gizli anahtar şifreli saklanır.
  totpSecretSifreli  String      @map("totp_secret_sifreli")
  /// PLT-06: yönetici her şeyi yapar; mevzuat editörü yalnız Mevzuat Merkezi'nde çalışır.
  rol                PlatformRol @default(yonetici)
  aktif              Boolean     @default(true)
  sonGiris           DateTime?   @map("son_giris")
  /// PLT-07: bekleyen kurulum — "hesap" (parola + 2FA) ya da "iki_adim" (yalnız 2FA). Doluyken giriş yapılamaz.
  davetTuru          String?     @map("davet_turu")
  davetAnahtarOzeti  String?     @unique @map("davet_anahtar_ozeti")
  davetSonGecerlilik DateTime?   @map("davet_son_gecerlilik")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  olusturulanGorevler PlatformGorev[] @relation("GoreviOlusturan")
  sorumluGorevler PlatformGorev[] @relation("GorevSorumlusu")
  hazirlanan  MevzuatDegisiklik[] @relation("Hazirlayan")
  aiTavanlari                PlatformAiTavani[]
  abonelikSaglayiciAyarlari  AbonelikSaglayiciAyari[]
  abonelikFaturaAyarlari     AbonelikFaturaAyari[]
  yayinlanan  MevzuatDegisiklik[] @relation("Yayinlayan")

  @@map("platform_kullanicilari")
}

/// AI-31: platform anahtarıyla çalışan kiracının aylık yapay zekâ tavanı (USD).
/// Satır yoksa ortam varsayılanı (AI_PLATFORM_AYLIK_TAVAN_USD) geçerlidir.
/// Yalnız platform ekibi yazar; kiracı kendi satırını okur.
model PlatformAiTavani {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  aylikTavanUsd Decimal  @map("aylik_tavan_usd") @db.Decimal(12, 2)
  guncelleyenId String?  @map("guncelleyen_id") @db.Uuid
  guncellendiAt DateTime @default(now()) @map("guncellendi_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guncelleyen PlatformKullanici? @relation(fields: [guncelleyenId], references: [id])

  @@map("platform_ai_tavanlari")
}

enum MevzuatDegisiklikDurum {
  taslak
  onay_bekliyor
  yayinlandi
}

enum MevzuatIslem {
  ekle
  degistir
  kaldir
}

/// MVZ-05: bir mevzuat düzenlemesi (ör. bir tebliğ); birden çok kalemi aynı yürürlükle değiştirir.
model MevzuatDegisiklik {
  id                  String                 @id @default(uuid()) @db.Uuid
  no                  Int                    @unique @default(autoincrement())
  baslik              String
  /// Mevzuat dayanağı: tebliğ/kılavuz adı, sayısı, tarihi (zorunlu).
  dayanak             String
  aciklama            String?
  yururlukBaslangic   DateTime               @map("yururluk_baslangic") @db.Date
  durum               MevzuatDegisiklikDurum @default(taslak)
  hazirlayanId        String                 @map("hazirlayan_id") @db.Uuid
  yayinlayanId        String?                @map("yayinlayan_id") @db.Uuid
  onayaGonderimZamani DateTime?              @map("onaya_gonderim_zamani")
  yayinZamani         DateTime?              @map("yayin_zamani")
  /// Son geri çevirmenin gerekçesi; değişiklik taslağa döner.
  retGerekcesi        String?                @map("ret_gerekcesi")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  hazirlayan       PlatformKullanici         @relation("Hazirlayan", fields: [hazirlayanId], references: [id])
  yayinlayan       PlatformKullanici?        @relation("Yayinlayan", fields: [yayinlayanId], references: [id])
  satirlar         MevzuatDegisiklikSatiri[]
  kayitlar         MevzuatKayit[]
  olaylar          MevzuatOlay[]
  kabulSenaryolari MevzuatKabulSenaryosu[]
  gorevler PlatformGorev[]

  @@index([durum, yayinZamani])
  @@map("mevzuat_degisiklikleri")
}

model MevzuatDegisiklikSatiri {
  id           String       @id @default(uuid()) @db.Uuid
  degisiklikId String       @map("degisiklik_id") @db.Uuid
  sira         Int
  tur          String
  anahtar      String
  islem        MevzuatIslem
  /// Kaldırmada boş.
  deger        Json?

  degisiklik MevzuatDegisiklik @relation(fields: [degisiklikId], references: [id], onDelete: Cascade)

  @@unique([degisiklikId, tur, anahtar])
  @@map("mevzuat_degisiklik_satirlari")
}

/// MVZ-01/02: yürürlükteki ve geçmiş değerler; belge kendi tarihindeki kaydı kullanır.
model MevzuatKayit {
  id                String    @id @default(uuid()) @db.Uuid
  tur               String
  anahtar           String
  deger             Json
  yururlukBaslangic DateTime  @map("yururluk_baslangic") @db.Date
  yururlukBitis     DateTime? @map("yururluk_bitis") @db.Date
  /// Kaydı getiren değişiklik; ilk dolumda (tohum) boş.
  degisiklikId      String?   @map("degisiklik_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  degisiklik MevzuatDegisiklik? @relation(fields: [degisiklikId], references: [id])
  bordrolar  PersonelBordro[]

  @@index([tur, anahtar, yururlukBaslangic])
  @@map("mevzuat_kayitlari")
}

/// MVZ-14: bordro parametresi değişikliğinin kabul senaryosu. Onaya gönderirken
/// ve yayında sunucuda yeniden çalıştırılır; biri tutmazsa yayın yapılmaz.
model MevzuatKabulSenaryosu {
  id               String    @id @default(uuid()) @db.Uuid
  degisiklikId     String    @map("degisiklik_id") @db.Uuid
  sira             Int
  ad               String
  /// Bordro hesabı girdileri (brüt ücret, prim günü, önceki kümülatif matrah…).
  girdiler         Json
  /// Resmî kaynaktan beklenen sonuçlar (net ücret, GV, DV…).
  beklenen         Json
  tolerans         Decimal   @default(0.01) @db.Decimal(8, 2)
  sonSonuc         Json?     @map("son_sonuc")
  basarili         Boolean?
  sonCalistiranId  String?   @map("son_calistiran_id") @db.Uuid
  sonCalismaZamani DateTime? @map("son_calisma_zamani")

  degisiklik MevzuatDegisiklik @relation(fields: [degisiklikId], references: [id], onDelete: Cascade)

  @@index([degisiklikId, sira])
  @@map("mevzuat_kabul_senaryolari")
}

/// MVZ-08: denetim izi; yalnız eklenir, değiştirilmez ve silinmez.
model MevzuatOlay {
  id           String   @id @default(uuid()) @db.Uuid
  degisiklikId String?  @map("degisiklik_id") @db.Uuid
  kullaniciId  String?  @map("kullanici_id") @db.Uuid
  olay         String
  detay        Json?
  zaman        DateTime @default(now())

  degisiklik MevzuatDegisiklik? @relation(fields: [degisiklikId], references: [id])

  @@index([degisiklikId, zaman])
  @@index([zaman])
  @@map("mevzuat_olaylari")
}

enum MevzuatTalepKaynagi {
  kiraci_bildirimi
  bilinmeyen_kod
}

enum MevzuatTalepDurumu {
  acik
  cozuldu
  reddedildi
}

/// MVZ-09/10: kiracının "eksik/hatalı bildir" kaydı ve gelen belgede görülen bilinmeyen kod.
model MevzuatTalep {
  id            String              @id @default(uuid()) @db.Uuid
  kaynak        MevzuatTalepKaynagi
  /// Kiracı bildiriminde gönderen kiracı; bilinmeyen kodda boş (kiracı adı taşınmaz).
  tenantId      String?             @map("tenant_id") @db.Uuid
  tur           String?
  anahtar       String?
  aciklama      String
  gorulmeSayisi Int                 @default(1) @map("gorulme_sayisi")
  durum         MevzuatTalepDurumu  @default(acik)
  cozumNotu     String?             @map("cozum_notu")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([durum, createdAt])
  @@map("mevzuat_talepleri")
}

/// STK-40: nakliye, gümrük, sigorta gibi giderin (masraf ya da alış
/// faturasının hizmet satırı) seçilen alış faturalarının stok satırlarına
/// dağıtılması. Pay alış maliyetine eklenir; maliyet yeniden hesaplanır.
/// Kaynak başına tek aktif dağıtım (kısmi tekil dizin göçte).
model MaliyetDagitimi {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  /// "masraf" | "fatura_satiri"
  kaynakTur     String                @map("kaynak_tur")
  masrafId      String?               @map("masraf_id") @db.Uuid
  faturaSatirId String?               @map("fatura_satir_id") @db.Uuid
  /// Kaynağın tarihi; dağıtılan tutar KDV hariç TL.
  tarih         DateTime              @db.Date
  tutar         Decimal               @db.Decimal(15, 2)
  yontem        MaliyetDagitimYontemi
  durum         MaliyetDagitimDurum   @default(aktif)
  aciklama      String?
  userId        String?               @map("user_id") @db.Uuid
  iptalEdenId   String?               @map("iptal_eden_id") @db.Uuid
  iptalTarihi   DateTime?             @map("iptal_tarihi")
  createdAt     DateTime              @default(now()) @map("created_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masraf      Masraf?              @relation(fields: [masrafId], references: [id])
  faturaSatir FaturaSatir?         @relation(fields: [faturaSatirId], references: [id])
  paylar      MaliyetDagitimPayi[]

  @@index([tenantId, durum])
  @@map("maliyet_dagitimlari")
}

model MaliyetDagitimPayi {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  dagitimId     String  @map("dagitim_id") @db.Uuid
  faturaId      String  @map("fatura_id") @db.Uuid
  faturaSatirId String  @map("fatura_satir_id") @db.Uuid
  stokId        String  @map("stok_id") @db.Uuid
  varyantId     String? @map("varyant_id") @db.Uuid
  tutar         Decimal @db.Decimal(15, 2)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dagitim     MaliyetDagitimi @relation(fields: [dagitimId], references: [id], onDelete: Cascade)
  // Geri alınmış dağıtımın payı, faturası taslakta düzenlenip satırları silinince gider.
  fatura      Fatura          @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  faturaSatir FaturaSatir     @relation(fields: [faturaSatirId], references: [id], onDelete: Cascade)
  stok        StokKart        @relation(fields: [stokId], references: [id])

  @@index([tenantId, faturaId])
  @@index([tenantId, stokId])
  @@map("maliyet_dagitim_paylari")
}

enum MaliyetDagitimYontemi {
  tutar
  miktar
}

enum MaliyetDagitimDurum {
  aktif
  iptal
}

/// EBLG-125: ürün kartının KDV dışı vergileri (ÖTV, ÖİV, konaklama…). Ürün
/// faturaya eklenince satıra buradan gelir; davranış (stopaj, KDV matrahı)
/// kodun Mevzuat Merkezi'ndeki kaydından türer.
model StokEkVergi {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  stokId    String       @map("stok_id") @db.Uuid
  /// UBL vergi türü kodu (Mevzuat: vergi_turu_kodu).
  kod       String
  /// "oran": matrahın yüzdesi; "birim": satır miktarı başına tutar (maktu).
  hesap     EkVergiHesap
  deger     Decimal      @db.Decimal(15, 4)
  sira      Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stok   StokKart @relation(fields: [stokId], references: [id], onDelete: Cascade)

  @@unique([stokId, kod])
  @@index([tenantId, stokId])
  @@map("stok_ek_vergileri")
}

enum EkVergiHesap {
  oran
  birim
}

// ─── Yapay Zeka Dış Kanallar ve Oturum Modelleri (Faz 3) ───────────────────

model AjanOturumu {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kanal        String // "WHATSAPP", "TELEGRAM", "EMAIL", "WEB"
  kanalKimlik  String    @map("kanal_kimlik") // Telefon no veya e-posta
  sonEtkilesim DateTime  @default(now()) @map("son_etkilesim")
  baslik       String?   @db.VarChar(120)
  arsivlendiAt DateTime? @map("arsivlendi_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mesajlar      AjanMesajGecmisi[]
  onayTalepleri AiOnayTalebi[]

  @@unique([tenantId, kanal, kanalKimlik])
  @@index([tenantId, kanal])
  @@index([tenantId, userId, arsivlendiAt, sonEtkilesim])
  @@map("ajan_oturumlari")
}

model AjanMesajGecmisi {
  id               String    @id @default(uuid()) @db.Uuid
  oturumId         String    @map("oturum_id") @db.Uuid
  requestId        String?   @map("request_id") @db.Uuid
  rol              String // "user", "assistant", "system", "tool"
  icerik           String    @db.Text
  aracCagrisi      Json?     @map("arac_cagrisi")
  yanit            Json?
  saglayici        String?   @db.VarChar(40)
  model            String?   @db.VarChar(120)
  geriBildirim     String?   @map("geri_bildirim") @db.VarChar(12)
  geriBildirimNotu String?   @map("geri_bildirim_notu") @db.VarChar(500)
  geriBildirimAt   DateTime? @map("geri_bildirim_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  oturum AjanOturumu @relation(fields: [oturumId], references: [id], onDelete: Cascade)

  @@unique([oturumId, requestId])
  @@index([oturumId, createdAt])
  @@map("ajan_mesaj_gecmisi")
}

/// AI-04: asistanın ya da MCP'nin hazırladığı, kullanıcı onayı bekleyen
/// kesinleştirme işlemi. Araç adı ve parametreler onaydan sonra değişmez;
/// onayda işlem ekranın ucuyla, onaylayanın o anki rolüyle çalışır.
model AiOnayTalebi {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  oturumId       String?           @map("oturum_id") @db.Uuid
  kaynak         AiIslemKaynagi
  arac           String
  parametreler   Json
  ozet           String            @db.Text
  onizleme       Json?
  durum          AiOnayTalepDurumu @default(bekliyor)
  gecerlilikSonu DateTime          @map("gecerlilik_sonu")
  /// AI-27: talep açılırken hedef kaydın içerik özeti (SHA-256); onayda yeniden hesaplanır, farklıysa işlem yapılmaz.
  hedefOzeti     String?           @map("hedef_ozeti") @db.VarChar(64)
  kararAt        DateTime?         @map("karar_at")
  sonuc          Json?
  hata           String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oturum AjanOturumu? @relation(fields: [oturumId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, durum])
  @@map("ai_onay_talepleri")
}

/// AI-15: günlük model çağrısı sayacı (kullanıcı ve özellik bazında).
model AiKullanim {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  gun      DateTime @db.Date
  userId   String   @map("user_id") @db.Uuid
  ozellik  String
  cagri    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, gun, userId, ozellik])
  @@index([tenantId, gun])
  @@map("ai_kullanim")
}

/// İçerik tutmayan AI çağrı telemetry kaydı. Prompt, yanıt ve araç girdileri
/// özellikle saklanmaz; yalnız operasyon ve maliyet ölçümleri bulunur.
model AiCagriIz {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  ozellik        String
  saglayici      String
  model          String?
  islem          String
  sureMs         Int      @map("sure_ms")
  basarili       Boolean
  hataSinifi     String?  @map("hata_sinifi")
  girisToken     Int?     @map("giris_token")
  cikisToken     Int?     @map("cikis_token")
  maliyetUsd     Decimal? @map("maliyet_usd") @db.Decimal(12, 8)
  /// AI-30: sağlayıcı token sayısı döndürmediğinde maliyet metin uzunluğundan tahmin edildi.
  maliyetTahmini Boolean  @default(false) @map("maliyet_tahmini")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, ozellik, saglayici, basarili])
  @@map("ai_cagri_izleri")
}

/// İçerik tutmayan OCR denetim izi; belge ve çıkarılan alanlar kaydedilmez.
model AiOcrDenetim {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  mimeType     String    @map("mime_type")
  dosyaBayt    Int       @map("dosya_bayt")
  genislik     Int?
  yukseklik    Int?
  saglayici    String
  model        String?
  durum        String    @default("calisiyor")
  sureMs       Int?      @map("sure_ms")
  hataSinifi   String?   @map("hata_sinifi")
  createdAt    DateTime  @default(now()) @map("created_at")
  tamamlandiAt DateTime? @map("tamamlandi_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, durum, createdAt])
  @@map("ai_ocr_denetimleri")
}

/// AI-09: kullanıcının kendi adına oluşturduğu MCP erişim anahtarı. Anahtarın
/// kendisi saklanmaz (bir kez gösterilir); SHA-256 özeti ve görünen öneki tutulur.
/// Anahtar o kullanıcının kimliği ve güncel rolüyle çalışır; iptal silme değildir.
model AiMcpAnahtari {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  ad          String
  onEk        String    @map("on_ek")
  ozet        String    @unique
  sonKullanim DateTime? @map("son_kullanim")
  iptalAt     DateTime? @map("iptal_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("ai_mcp_anahtarlari")
}

/// MCP gibi doğrudan AI araç çağrılarında yan etkili isteğin yalnız bir kez
/// çalışmasını sağlar. İstek/yanıt içeriği yerine girdi özeti ve sonuç saklanır.
model AiAracIstegi {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  kaynak        String
  istekAnahtari String    @map("istek_anahtari") @db.VarChar(100)
  arac          String
  girdiOzeti    String    @map("girdi_ozeti") @db.VarChar(64)
  durum         String    @default("calisiyor")
  sonuc         Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  tamamlandiAt  DateTime? @map("tamamlandi_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, kaynak, istekAnahtari])
  @@index([tenantId, createdAt])
  @@map("ai_arac_istekleri")
}

enum AiIslemKaynagi {
  asistan
  mcp
  otomasyon
}

enum AiOnayTalepDurumu {
  bekliyor
  isleniyor
  onaylandi
  reddedildi
  suresi_doldu
  hata
  /// AI-27: talepten sonra hedef kayıt değişti; işlem yapılmadı.
  hedef_degisti
}

// ─── OCR ve Taranan Belgeler (Faz 1 / 3) ───────────────────────────────────

model BelgeOcrKaydi {
