  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @map("tenant_id") @db.Uuid
  /// MUH-03: muhasebe alt hesap kodu; boşsa aktarımda varsayılan üretilir.
  muhasebeKodu            String?                @map("muhasebe_kodu")
  kod                     String
  unvan                   String
  /// Gerçek kişide ad ve soyad zorunludur, unvan bunlardan türer (CARI-21).
  /// Tüzel kişide boştur.
  ad                      String?
  soyad                   String?
  kisaAd                  String?                @map("kisa_ad")
  tip                     CariTip
  kisiTipi                KisiTip                @default(tuzel) @map("kisi_tipi")
  sektor                  String?
  temsilciUserId          String?                @map("temsilci_user_id") @db.Uuid
  /// CARI-41: holding / ana firma grubu; grup limiti üyelerin toplam riskine uygulanır.
  grupId                  String?                @map("grup_id") @db.Uuid
  vknTckn                 String?                @map("vkn_tckn")
  /// EBLG-86: alıcının GİB'de birden çok posta kutusu varsa elle seçilen kutu.
  /// Listede durduğu sürece seçim kuralının önüne geçer; listeden düşerse
  /// kurala dönülür.
  efaturaPostaKutusu      String?                @map("efatura_posta_kutusu")
  eirsaliyePostaKutusu    String?                @map("eirsaliye_posta_kutusu")
  /// Veritabanının ürettiği aksansız arama kolonu (20260904200000_aksansiz_arama).
  /// GENERATED ALWAYS olduğu için yalnız okunur; Prisma ile yazılmaz.
  aramaNormal             String?                @map("arama_normal")
  vergiDairesi            String?                @map("vergi_dairesi")
  mersisNo                String?                @map("mersis_no")
  ticaretSicilNo          String?                @map("ticaret_sicil_no")
  kvkkOnayTarihi          DateTime?              @map("kvkk_onay_tarihi") @db.Date
  eposta                  String?
  telefon                 String?
  webSitesi               String?                @map("web_sitesi")
  faks                    String?
  iban                    String?
  karaListe               Boolean                @default(false) @map("kara_liste")
  karaListeNotu           String?                @map("kara_liste_notu")
  dovizCinsi              DovizCinsi             @default(TRY) @map("doviz_cinsi")
  fiyatListesiId          String?                @map("fiyat_listesi_id") @db.Uuid
  varsayilanIskonto       Decimal?               @map("varsayilan_iskonto") @db.Decimal(5, 2)
  varsayilanVadeGun       Int?                   @map("varsayilan_vade_gun")
  riskLimiti              Decimal?               @map("risk_limiti") @db.Decimal(15, 2)
  eFaturaMukellefi        Boolean?               @map("e_fatura_mukellefi")
  /// KAMU senaryosu: GİB listesinde ÖZEL görünen kamu idaresi için elle işaret;
  /// harcama birimi sihirbazda varsayılan olarak gelir.
  kamuIdaresi             Boolean                @default(false) @map("kamu_idaresi")
  harcamaBirimiVkn        String?                @map("harcama_birimi_vkn")
  harcamaBirimiAdi        String?                @map("harcama_birimi_adi")
  mukellefiyetSorguZamani DateTime?              @map("mukellefiyet_sorgu_zamani")
  /// Bu cariye kesilen e-Faturaların varsayılan profili (FTR-19); fatura
  /// üzerinde değiştirilebilir.
  efaturaProfili          EfaturaProfili         @default(temel) @map("efatura_profili")
  /// Bu cariye kesilen e-Arşiv faturaların varsayılan teslim şekli (EBLG-26);
  /// e-Belge sihirbazında fatura bazında değiştirilebilir.
  earsivGonderimSekli     EarsivGonderimSekli    @default(elektronik) @map("earsiv_gonderim_sekli")
  /// FTR-40: bu cariye kesilen ticari belgelerin varsayılan basım dili; boşsa Türkçe.
  belgeDili               String?                @map("belge_dili")
  belgeCiftDil            Boolean                @default(false) @map("belge_cift_dil")
  notlar                  String?
  aktif                   Boolean                @default(true)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  fiyatListesi          FiyatListesi?        @relation(fields: [fiyatListesiId], references: [id])
  temsilci              User?                @relation("CariTemsilci", fields: [temsilciUserId], references: [id])
  grup                  CariGrup?            @relation(fields: [grupId], references: [id], onDelete: SetNull)
  bayiKullanicilari     User[]               @relation("BayiKullaniciCari")
  satinAlmaTeklifleri   SatinAlmaTeklifi[]
  adresler              CariAdres[]
  kisiler               CariKisi[]
  bankaHesaplari        CariBankaHesap[]
  etiketler             CariEtiketAtama[]
  hareketler            CariHareket[]
  crmEtkilesimleri      CrmEtkilesim[]
  crmGorevleri          CrmGorev[]
  crmFirsatlari         CrmFirsat[]
  gelenEpostalar        GelenEposta[]
  faturas               Fatura[]
  cekSenetleri          CekSenet[]           @relation("CekSenetCari")
  ceklerCiro            CekSenet[]           @relation("CekSenetCiro")
  cekBordrolari         CekSenetBordro[]
  odemeTalimatlari      BankaOdemeTalimati[]
  kasaBankaHareketleri  KasaBankaHareket[]
  gelirKayitlari        GelirKaydi[]
  stokTedarikcilikleri  StokTedarikci[]
  belgeler              Belge[]
  tasidigiBelgeler      Belge[]              @relation("BelgeTasiyici")
  ekstreSatirlari       BankaEkstreSatir[]
  pazaryeriSiparisleri  PazaryeriSiparis[]
  posTahsilatlari       PosTahsilat[]
  krediKartiHareketleri KrediKartiHareket[]
  masraflar             Masraf[]
  kiraSozlesmeleri      KiraSozlesme[]
  teminatlar            CariTeminat[]
  mutabakatlar          CariMutabakat[]
  personel              Personel?
  projeler              Proje[]

  /// KSB-16: bu tarihten önce girilmiş ödeme/iadeler otomatik dağıtılmaz (göç öncesi veri);
  /// "vadeye göre yeniden denkleştir" boşaltır. Yeni carilerde boş (hepsi).
  denklestirmeBaslangic DateTime?      @map("denklestirme_baslangic")
  /// KSB-25: denkleştirmeden sonra kalan açık alış ve satış faturalarını birbirine karşı mahsup et.
  otomatikMahsup        Boolean        @default(false) @map("otomatik_mahsup")
  mahsuplar             CariMahsup[]
  /// CARI-60: başka karta birleştirildiyse ana kart; kart pasiftir, listede ve önerilerde çıkmaz.
  birlestigiCariId      String?        @map("birlestigi_cari_id") @db.Uuid
  kapamalar             FaturaKapama[]

  @@unique([tenantId, kod])
  @@index([tenantId, unvan])
  @@index([tenantId, grupId])
  @@map("cari_hesaplar")
}

/// CARI-42 (karar 2026-10-04): bakiye mutabakatı talebi ve karşı tarafın
/// girişsiz portaldan verdiği yanıt. Bakiye ve ekstre PDF'i talep anında
/// dondurulur; bağlantı anahtarının yalnız SHA-256 özeti saklanır.
/// Durum: gonderildi | goruldu | mutabik | itiraz | iptal ("süresi doldu" türetilir).
model CariMutabakat {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  cariId                 String    @map("cari_id") @db.Uuid
  mutabakatTarihi        DateTime  @map("mutabakat_tarihi") @db.Date
  baslangicTarihi        DateTime? @map("baslangic_tarihi") @db.Date
  sonYanitTarihi         DateTime  @map("son_yanit_tarihi") @db.Date
  /// [{ dovizCinsi, bakiye }] — bakiye = borç − alacak (artı: cari bize borçlu).
  bakiyeler              Json
  bakiyeTry              Decimal   @map("bakiye_try") @db.Decimal(15, 2)
  alici                  String
  anahtarOzeti           String    @map("anahtar_ozeti")
  /// Hatırlatma e-postasındaki ikinci bağlantının özeti; ikisi de geçerlidir.
  hatirlatmaAnahtarOzeti String?   @map("hatirlatma_anahtar_ozeti")
  ekstreAnahtari         String    @map("ekstre_anahtari")
  durum                  String    @default("gonderildi")
  gorulduAt              DateTime? @map("goruldu_at")
  yanitAt                DateTime? @map("yanit_at")
  yanitlayanAd           String?   @map("yanitlayan_ad")
  yanitlayanGorev        String?   @map("yanitlayan_gorev")
  yanitlayanEposta       String?   @map("yanitlayan_eposta")
  yanitAciklama          String?   @map("yanit_aciklama")
  /// İtirazda karşı tarafın bakiyeleri: [{ dovizCinsi, bakiye }] aynı işaretle.
  karsiBakiyeler         Json?     @map("karsi_bakiyeler")
  ekAnahtari             String?   @map("ek_anahtari")
  ekDosyaAdi             String?   @map("ek_dosya_adi")
  ekMime                 String?   @map("ek_mime")
  yanitIp                String?   @map("yanit_ip")
  yanitTarayici          String?   @map("yanit_tarayici")
  hatirlatmaAt           DateTime? @map("hatirlatma_at")
  itirazKapandiAt        DateTime? @map("itiraz_kapandi_at")
  itirazKapatmaNotu      String?   @map("itiraz_kapatma_notu")
  itirazKapatanUserId    String?   @map("itiraz_kapatan_user_id") @db.Uuid
  iptalAt                DateTime? @map("iptal_at")
  olusturanUserId        String    @map("olusturan_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  cari CariHesap @relation(fields: [cariId], references: [id], onDelete: Restrict)

  @@unique([tenantId, anahtarOzeti])
  @@index([tenantId, cariId, createdAt])
  @@index([tenantId, durum, sonYanitTarihi])
  @@index([tenantId, hatirlatmaAnahtarOzeti])
  @@map("cari_mutabakatlari")
}

/// CARI-41 (karar 2026-10-04): tek seviyeli cari grubu. Grup riski üyelerin
/// riskleri toplamıdır; limit = grup risk limiti + üyelerin geçerli teminatları.
