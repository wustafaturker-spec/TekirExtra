generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

enum Rol {
  yonetici
  muhasebe
  satis
  salt_okunur
  mali_musavir
  b2b_bayi
  uretim_planlama
  uretim_operatoru
  depo
  kalite
  maliyet_muhasebesi
}

enum BaglantiAile {
  ebelge
  pazaryeri
  pos
  banka
  sms
}

enum BaglantiDurumu {
  pasif
  aktif
  hata
}

enum BelgeDurum {
  kuyrukta
  iletildi
  kabul
  ret
  hata
  iptal
}

enum AbonelikDurumu {
  deneme
  aktif
  askida
  iptal
}

enum PazaryeriSiparisDurumu {
  yeni
  esleme_bekliyor
  faturalanmaya_hazir
  faturalandi
  iptal
  hata
}

enum PazaryeriKesintiDurumu {
  bekliyor
  giderlesti
}

enum PosTahsilatDurumu {
  baslatildi
  odendi
  basarisiz
  iptal
  suresi_doldu
}

enum DuzeltmeDurumu {
  acik
  incelemede
  beklemede
  cozuldu
  yoksayildi
}

enum DuzeltmeOnemi {
  bilgi
  uyari
  kritik
}

enum DuzeltmeTuru {
  banka_ekstre
  kredi_karti
  masraf
  pos
  ebelge
  stok
  cek_senet
  fatura_cari
  /// SAT-11: sipariş–mal kabul–fatura arasındaki miktar/fiyat farkı
  satin_alma
}

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  unvan              String
  vkn                String   @unique
  vergiDairesi       String?  @map("vergi_dairesi")
  /// EBLG-62: e-belgenin satıcı tarafına ve PDF'lere yazılan firma bilgisi.
  adres              String?  @map("adres")
  ilce               String?  @map("ilce")
  il                 String?  @map("il")
  postaKodu          String?  @map("posta_kodu")
  telefon            String?  @map("telefon")
  eposta             String?  @map("eposta")
  webSitesi          String?  @map("web_sitesi")
  /// EBLG-101: entegratöre yüklenen firma tasarımının üst şeridi. Boşsa ünvan yazılır.
  belgeMarkaAdi      String?  @map("belge_marka_adi")
  belgeMarkaAlt      String?  @map("belge_marka_alt")
  /// EBLG-101: satıcı bilgilerinin altında ve alt satırda basılan serbest ek bilgi (ör. sertifika no).
  belgeEkBilgi       String?  @map("belge_ek_bilgi")
  /// EBLG-101: sağ üstte basılan rozet görselleri (data URI dizisi, en çok 3).
  belgeRozetleri     Json?    @map("belge_rozetleri")
  mersisNo           String?  @map("mersis_no")
  ticaretSicilNo     String?  @map("ticaret_sicil_no")
  /// EBLG-77: firmanın kendi e-belge mükellefiyetleri. null: GİB mükellef
  /// listesinden belirlenir; true/false: firma ayarında elle söylenmiştir.
  /// e-Arşiv listesi GİB'de yayınlanmadığı için otomatikte e-Faturayı izler.
  efaturaMukellefi   Boolean? @map("efatura_mukellefi")
  earsivMukellefi    Boolean? @map("earsiv_mukellefi")
  eirsaliyeMukellefi Boolean? @map("eirsaliye_mukellefi")
  /// Yolcu beraberi (tax-free): KDV iadesini yapan aracı kurumun varsayılanı;
  /// sihirbazda faturaya özel değiştirilir.
  araciKurumVkn      String?  @map("araci_kurum_vkn")
  araciKurumEtiket   String?  @map("araci_kurum_etiket")
  araciKurumUnvan    String?  @map("araci_kurum_unvan")
  /// SGK faturası: firmanın hangi grupta olduğu ve Kurum'da tanımlı kodu/adı.
  /// Sağlık hizmeti sunucusunda sabittir, her faturada tekrar yazılmaz.
  sgkIlaveFaturaTipi String?  @map("sgk_ilave_fatura_tipi")
  sgkMukellefKodu    String?  @map("sgk_mukellef_kodu")
  sgkMukellefAdi     String?  @map("sgk_mukellef_adi")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  users                     User[]
  modulAyarlari             ModulAyar[]
  baglantilar               Baglanti[]
  auditLoglar               AuditLog[]
  abonelik                  TenantAbonelik?
  abonelikDegisiklikleri    AbonelikDegisikligi[]
  pazaryeriSiparisleri      PazaryeriSiparis[]
  posTahsilatlari           PosTahsilat[]
  pazaryeriKesintileri      PazaryeriKesinti[]
  bankaHesapEslemeleri      BankaBaglantiHesap[]
  bankaOdemeTalimatlari     BankaOdemeTalimati[]
  masrafKategorileri        MasrafKategori[]
  masraflar                 Masraf[]
  masrafOdemeleri           MasrafOdeme[]
  gelirKategorileri         GelirKategori[]
  gelirKayitlari            GelirKaydi[]
  kiraSozlesmeleri          KiraSozlesme[]
  epostaGonderimleri        EpostaGonderim[]
  eirsaliyeKayitlari        EirsaliyeKayit[]
  gelenEirsaliyeler         GelenEirsaliye[]
  elleKurlari               ElleKur[]
  elleKurOlaylari           ElleKurOlayi[]
  krediKartlari             KrediKarti[]
  krediKartiHareketleri     KrediKartiHareket[]
  krediKartiTaksitleri      KrediKartiTaksit[]
  personeller               Personel[]
  personelBordrolari        PersonelBordro[]
  personelAvanslari         PersonelAvans[]
  personelIstihdamDonemleri PersonelIstihdamDonemi[]
  personelBordroKalemleri   PersonelBordroKalemi[]
  personelBordroOdemeleri   PersonelBordroOdeme[]
  izinTurleri               PersonelIzinTuru[]
  izinTalepleri             PersonelIzinTalebi[]
  izinBakiyeHareketleri     PersonelIzinBakiyeHareketi[]
  personelTatilGunleri      PersonelTatilGunu[]
  personelIsyerleri         PersonelIsyeri[]
  personelDepartmanlari     PersonelDepartman[]
  personelPozisyonlari      PersonelPozisyon[]
  personelBelgeleri         PersonelBelgesi[]
  bordroMevzuatSetleri      BordroMevzuatSeti[]
  personelDonemCalismalari  PersonelDonemCalisma[]
  bordroKabulSenaryolari    BordroKabulSenaryosu[]
  personelSayaci            PersonelSayac?
  uretimSayaclari           UretimSayac[]
  uretimBildirimleri        UretimBildirimi[]
  isMerkezleri              IsMerkezi[]
  kaliteKontrolleri         UretimKaliteKontrol[]
  uretimSarfDuzeltmeleri    UretimSarfDuzeltme[]
  uretimVardiyalari         UretimVardiya[]
  uretimDuruslari           UretimDurus[]
  uretimDonemKilitleri      UretimDonemKilidi[]
  maliDonemler              MaliDonem[]
  bildirimler               Bildirim[]
  bildirimTeslimatlari      BildirimTeslimati[]
  bildirimTercihleri        BildirimTercihi[]
  bildirimAyarlari          BildirimKullaniciAyari[]
  maliDonemOlaylari         MaliDonemOlayi[]
  butceler                  Butce[]
  satinAlmaTalepleri        SatinAlmaTalebi[]
  satinAlmaTalepKalemleri   SatinAlmaTalepKalemi[]
  satinAlmaTeklifleri       SatinAlmaTeklifi[]
  satinAlmaTeklifKalemleri  SatinAlmaTeklifKalemi[]
  satinAlmaTalepOlaylari    SatinAlmaTalepOlayi[]
  satinAlmaSayaclari        SatinAlmaSayac[]
  butceSatirlari            ButceSatiri[]
  butceOlaylari             ButceOlayi[]
  donemKontrolleri          DonemKontrolu[]
  uretimEmriCiktilari       UretimEmriCikti[]
  urunRecetesiCiktilari     UrunRecetesiCikti[]
  crmFirsatlari             CrmFirsat[]
  projeler                  Proje[]
  projeAsamalari            ProjeAsama[]
  projeAltKirilimlari       ProjeAltKirilim[]
  projeNotlari              ProjeNot[]
  duzeltmeKayitlari         DuzeltmeKaydi[]
  duzeltmeOlaylari          DuzeltmeOlayi[]

  @@map("tenants")
}

/// KLN-08: v1.0 fiyatlandırma uygulamaz. Sağlayıcı ve dönem alanları ileride
/// ödeme altyapısı bağlanırken tenant tablosunu değiştirmeden kullanılacaktır.
model TenantAbonelik {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @unique @map("tenant_id") @db.Uuid
  planKodu             String         @default("v1") @map("plan_kodu")
  durum                AbonelikDurumu @default(aktif)
  faturaEpostasi       String?        @map("fatura_epostasi")
  faturalandirmaUnvani String?        @map("faturalandirma_unvani")
  saglayici            String?
  saglayiciMusteriRef  String?        @map("saglayici_musteri_ref")
  donemBaslangici      DateTime?      @map("donem_baslangici")
  donemSonu            DateTime?      @map("donem_sonu")
  iptalTarihi          DateTime?      @map("iptal_tarihi")
  meta                 Json?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([durum, donemSonu])
  @@map("tenant_abonelikleri")
}

model AbonelikDegisikligi {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  oncekiPlan  String?         @map("onceki_plan")
  yeniPlan    String          @map("yeni_plan")
  oncekiDurum AbonelikDurumu? @map("onceki_durum")
  yeniDurum   AbonelikDurumu  @map("yeni_durum")
  neden       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("abonelik_degisiklikleri")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  eposta             String
  parolaHash         String   @map("parola_hash")
  adSoyad            String   @map("ad_soyad")
  rol                Rol
  aktif              Boolean  @default(true)
  epostaDogrulandi   Boolean  @default(false) @map("eposta_dogrulandi")
  /// TOTP gizli anahtarı AES-256-GCM ile şifreli saklanır (KLN-05)
  totpSecretSifreli  String?  @map("totp_secret_sifreli")
  totpAktif          Boolean  @default(false) @map("totp_aktif")
  maksIskontoYuzdesi Decimal? @map("maks_iskonto_yuzdesi") @db.Decimal(5, 2)
  bayiCariId         String?  @map("bayi_cari_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant                       Tenant                  @relation(fields: [tenantId], references: [id])
  temsilciCariler              CariHesap[]             @relation("CariTemsilci")
  bayiCari                     CariHesap?              @relation("BayiKullaniciCari", fields: [bayiCariId], references: [id], onDelete: SetNull)
  crmGorevleri                 CrmGorev[]              @relation("CrmGorevAtanan")
  crmKayitlari                 CrmEtkilesim[]
  crmFirsatlari                CrmFirsat[]             @relation("CrmFirsatSorumlu")
  olusturduguOdemeTalimatlari  BankaOdemeTalimati[]    @relation("TalimatOlusturan")
  onayladigiOdemeTalimatlari   BankaOdemeTalimati[]    @relation("TalimatOnaylayan")
  uretimOperasyonlari          UretimEmriOperasyonu[]  @relation("UretimOperatoru")
  olusturduguUretimDuruslari   UretimDurus[]           @relation("UretimDurusOlusturan")
  kapattigiUretimDonemleri     UretimDonemKilidi[]     @relation("UretimDonemKapatan")
  maliDonemOlaylari            MaliDonemOlayi[]        @relation("MaliDonemOlayKullanicisi")
  onaylananButceler            Butce[]                 @relation("ButceOnaylayan")
  butceOlaylari                ButceOlayi[]            @relation("ButceOlayKullanicisi")
  satinAlmaTalepleri           SatinAlmaTalebi[]       @relation("SatinAlmaTalepEden")
  onayladigiSatinAlmaTalepleri SatinAlmaTalebi[]       @relation("SatinAlmaTalepOnaylayan")
  satinAlmaTalepOlaylari       SatinAlmaTalepOlayi[]
  elleKurlari                  ElleKur[]               @relation("ElleKurKullanicisi")
  elleKurOlaylari              ElleKurOlayi[]          @relation("ElleKurOlayKullanicisi")
  bildirimTeslimatlari         BildirimTeslimati[]
  bildirimTercihleri           BildirimTercihi[]
  bildirimAyari                BildirimKullaniciAyari?
  sorumluProjeler              Proje[]                 @relation("ProjeSorumlu")
  projeNotlari                 ProjeNot[]
  atananDuzeltmeKayitlari      DuzeltmeKaydi[]         @relation("DuzeltmeAtanan")
  cozduguDuzeltmeKayitlari     DuzeltmeKaydi[]         @relation("DuzeltmeCozen")
  duzeltmeOlaylari             DuzeltmeOlayi[]

  @@unique([tenantId, eposta])
  @@index([tenantId])
  @@index([tenantId, bayiCariId])
  @@map("users")
}

model PazaryeriSiparis {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  baglantiId     String                 @map("baglanti_id") @db.Uuid
  hariciId       String                 @map("harici_id")
  siparisNo      String                 @map("siparis_no")
  durum          PazaryeriSiparisDurumu @default(yeni)
  hariciDurum    String?                @map("harici_durum")
  siparisTarihi  DateTime               @map("siparis_tarihi")
  musteriUnvani  String                 @map("musteri_unvani")
  musteriEposta  String?                @map("musteri_eposta")
  musteriTelefon String?                @map("musteri_telefon")
  vknTckn        String?                @map("vkn_tckn")
  dovizCinsi     DovizCinsi             @default(TRY) @map("doviz_cinsi")
  toplam         Decimal                @db.Decimal(15, 2)
  teslimatAdresi Json?                  @map("teslimat_adresi")
  hamVeri        Json?                  @map("ham_veri")
  cariId         String?                @map("cari_id") @db.Uuid
  faturaId       String?                @map("fatura_id") @db.Uuid
  hataMesaji     String?                @map("hata_mesaji")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglanti Baglanti                 @relation(fields: [baglantiId], references: [id], onDelete: Cascade)
  cari     CariHesap?               @relation(fields: [cariId], references: [id])
  fatura   Fatura?                  @relation(fields: [faturaId], references: [id])
  satirlar PazaryeriSiparisSatiri[]

  @@unique([tenantId, baglantiId, hariciId])
  @@index([tenantId, durum, siparisTarihi])
  @@map("pazaryeri_siparisleri")
}

model PazaryeriSiparisSatiri {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  siparisId     String   @map("siparis_id") @db.Uuid
  hariciSatirId String   @map("harici_satir_id")
  sku           String
  barkod        String?
  urunAdi       String   @map("urun_adi")
  miktar        Decimal  @db.Decimal(15, 4)
  birimFiyat    Decimal  @map("birim_fiyat") @db.Decimal(15, 6)
  kdvOrani      Decimal  @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  stokId        String?  @map("stok_id") @db.Uuid
  varyantId     String?  @map("varyant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  siparis PazaryeriSiparis @relation(fields: [siparisId], references: [id], onDelete: Cascade)
  stok    StokKart?        @relation(fields: [stokId], references: [id])
  varyant StokVaryant?     @relation(fields: [varyantId], references: [id])

  @@unique([siparisId, hariciSatirId])
  @@index([tenantId, stokId])
  @@map("pazaryeri_siparis_satirlari")
}

model PazaryeriKesinti {
  id         String                 @id @default(uuid()) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  baglantiId String                 @map("baglanti_id") @db.Uuid
  hariciId   String                 @map("harici_id")
  siparisNo  String?                @map("siparis_no")
  tur        String
  aciklama   String?
  tarih      DateTime               @db.Date
  tutar      Decimal                @db.Decimal(15, 2)
  dovizCinsi DovizCinsi             @default(TRY) @map("doviz_cinsi")
  durum      PazaryeriKesintiDurumu @default(bekliyor)
  hareketId  String?                @unique @map("hareket_id") @db.Uuid
  hamVeri    Json?                  @map("ham_veri")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglanti Baglanti          @relation(fields: [baglantiId], references: [id], onDelete: Cascade)
  hareket  KasaBankaHareket? @relation(fields: [hareketId], references: [id])

  @@unique([tenantId, baglantiId, hariciId])
  @@index([tenantId, durum, tarih])
  @@map("pazaryeri_kesintileri")
}

/// e-posta → (tenant, user) rehberi. BİLİNÇLİ OLARAK RLS'SİZ: oturum açma
/// anında kiracı bağlamı henüz yoktur. Parola içermez; e-posta sistem
/// genelinde tekildir (MIMARI §7).
model AuthKimlik {
  id        String   @id @default(uuid()) @db.Uuid
  eposta    String   @unique
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_kimlikler")
}

/// Refresh token oturumları (hash saklanır). RLS'siz: token yenileme
/// ön-kimlik aşamasında yapılır (MIMARI §7).
model Oturum {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  gecerlilikSonu   DateTime @map("gecerlilik_sonu")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("oturumlar")
}

/// e-posta doğrulama token'ları (KLN-09; hash saklanır, süreli). RLS'siz:
/// doğrulama linki oturum açılmadan tıklanır (MIMARI §7).
model EpostaDogrulama {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  gecerlilikSonu DateTime @map("gecerlilik_sonu")
  kullanildi     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("eposta_dogrulamalar")
}

model EpostaGonderim {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  alici      String
  konu       String
  tur        String   @default("genel")
  durum      String
  ekSayisi   Int      @default(0) @map("ek_sayisi")
  hataMesaji String?  @map("hata_mesaji")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("eposta_gonderimleri")
}

/// Modül başına ayarlar; zod şemasıyla doğrulanır (AYR-01/03, MIMARI §4.2).
model ModulAyar {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  modul     String
  ayarlar   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, modul])
  @@map("modul_ayarlari")
}

/// Dış bağlantılar: e-belge/pazaryeri/POS/banka (ENT-01, MIMARI §5).
/// sifreliConfig: AES-256-GCM ile şifrelenmiş erişim bilgileri (EBLG-01b).
model Baglanti {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  aile                 BaglantiAile
  saglayici            String
  sifreliConfig        String         @map("sifreli_config")
  durum                BaglantiDurumu @default(pasif)
  senkronImleci        String?        @map("senkron_imleci")
  kesintiSenkronImleci String?        @map("kesinti_senkron_imleci")
  sonSenkronTarihi     DateTime?      @map("son_senkron_tarihi")
  sonSenkronHatasi     String?        @map("son_senkron_hatasi")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  pazaryeriSiparises   PazaryeriSiparis[]
  pazaryeriKesintileri PazaryeriKesinti[]
  posHesaplari         PosHesap[]
  bankaHesapEslemeleri BankaBaglantiHesap[]

  @@index([tenantId, aile])
  @@map("baglantilar")
}

/// Denetim izi (KLN-04) — uygulamadan salt-ekleme; güncelleme/silme yok.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  islem     String
  varlik    String
  varlikId  String?  @map("varlik_id")
  detay     Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// Kayıtlı rapor görünümleri (RPR-06): adlandırılmış filtre setleri.
/// Kişiseldir; firmaGeneli=true ise firmadaki tüm kullanıcılara görünür.
model RaporGorunumu {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  raporKod    String   @map("rapor_kod")
  ad          String
  girdi       Json
  firmaGeneli Boolean  @default(false) @map("firma_geneli")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, raporKod, ad])
  @@index([tenantId, raporKod])
  @@map("rapor_gorunumleri")
}

