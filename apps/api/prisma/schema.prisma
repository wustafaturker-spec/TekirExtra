/// P1-2a: farklı dövizdeki iki kasa/banka hesabı arasında döviz alım/satımı.
/// Döviz bacağı işlem günü TCMB alış kuruyla, TL bacağı bankanın gerçek
/// tutarıyla değerlenir; TL karşılıkları arasındaki fark kambiyo kârı (gelir
/// kaydı) ya da zararı (masraf) olarak yazılır. Bacaklar `kaynak_tur =
/// 'doviz_islem'`, `kaynak_ref = id` olan virman hareketleridir.
model DovizIslemi {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tarih           DateTime   @db.Date
  cikanTutar      Decimal    @map("cikan_tutar") @db.Decimal(15, 2)
  cikanDoviz      DovizCinsi @map("cikan_doviz")
  cikanKur        Decimal    @map("cikan_kur") @db.Decimal(15, 6)
  cikanTry        Decimal    @map("cikan_try") @db.Decimal(15, 2)
  girenTutar      Decimal    @map("giren_tutar") @db.Decimal(15, 2)
  girenDoviz      DovizCinsi @map("giren_doviz")
  girenKur        Decimal    @map("giren_kur") @db.Decimal(15, 6)
  girenTry        Decimal    @map("giren_try") @db.Decimal(15, 2)
  /// girenTry − cikanTry: artı kambiyo kârı, eksi kambiyo zararı.
  farkTry         Decimal    @map("fark_try") @db.Decimal(15, 2)
  gidisHareketId  String     @unique @map("gidis_hareket_id") @db.Uuid
  gelisHareketId  String     @unique @map("gelis_hareket_id") @db.Uuid
  kambiyoGelirId  String?    @unique @map("kambiyo_gelir_id") @db.Uuid
  kambiyoMasrafId String?    @unique @map("kambiyo_masraf_id") @db.Uuid
  /// Bankanın ayrıca kestiği komisyon/BSMV (ödenmiş masraf).
  bankaMasrafId   String?    @unique @map("banka_masraf_id") @db.Uuid
  aciklama        String?
  userId          String?    @map("user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([tenantId, tarih])
  @@map("doviz_islemleri")
}

/// P1-6: ödenmiş POS tahsilatının (tam/kısmi) iadesi. Kayıt bazlıdır; iade
/// sağlayıcı ya da banka panelinden ayrıca yapılır.
model PosIade {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  posTahsilatId String   @map("pos_tahsilat_id") @db.Uuid
  tutar         Decimal  @db.Decimal(15, 2)
  tarih         DateTime @db.Date
  neden         String
  hareketId     String   @unique @map("hareket_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  posTahsilat PosTahsilat      @relation(fields: [posTahsilatId], references: [id], onDelete: Cascade)
  hareket     KasaBankaHareket @relation(fields: [hareketId], references: [id])

  @@index([tenantId, posTahsilatId])
  @@map("pos_iadeleri")
}

/// KSB-06: ekstre satırının eşleştiği kayıt türü.
enum EkstreEslesmeTuru {
  cari
  mevcut_fis
  masraf
  gelir
  virman
  cek
  kredi_karti
  pos
  odeme_talimati
  /// P1-2a: farklı dövizdeki iki hesap arasında döviz alım/satımı.
  doviz_islem
  /// KRD-04: banka kredisi kullanımı, taksiti ya da rotatif işlemi.
  kredi
}

enum EkstreKuralYonu {
  giris
  cikis
}

/// KSB-06: "açıklamada X geçen giriş/çıkış → şununla eşleştir" önerisi.
/// Kural yalnız öneri üretir; satır kullanıcı onayıyla işlenir.
model EkstreKurali {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  /// null: firmanın bütün banka hesaplarında geçerli.
  bankaHesapId      String?           @map("banka_hesap_id") @db.Uuid
  /// Açıklama + karşı unvanda aranan, aksansız büyük harfe indirgenmiş metin.
  anahtar           String
  yon               EkstreKuralYonu
  eslesmeTuru       EkstreEslesmeTuru @map("eslesme_turu")
  cariId            String?           @map("cari_id") @db.Uuid
  masrafKategoriId  String?           @map("masraf_kategori_id") @db.Uuid
  gelirKategoriId   String?           @map("gelir_kategori_id") @db.Uuid
  hedefKasaId       String?           @map("hedef_kasa_id") @db.Uuid
  hedefBankaHesapId String?           @map("hedef_banka_hesap_id") @db.Uuid
  aktif             Boolean           @default(true)
  kullanimSayisi    Int               @default(0) @map("kullanim_sayisi")
  sonKullanim       DateTime?         @map("son_kullanim")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, aktif])
  @@map("ekstre_kurallari")
}

enum EkstreSatirDurum {
  beklemede
  eslesti
  yoksayildi
}

/// KSB-06: bir ekstre dosyası yüklemesi. Satırlar bu kayda bağlanır ki
/// "hangi dosyadan geldi" izlenebilsin.
model BankaEkstre {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  bankaHesapId    String   @map("banka_hesap_id") @db.Uuid
  dosyaAdi        String   @map("dosya_adi")
  satirSayisi     Int      @map("satir_sayisi")
  /// Aynı dosya ikinci kez yüklendiğinde yinelenmeyen satır sayısı.
  yeniSatirSayisi Int      @map("yeni_satir_sayisi")
  createdAt       DateTime @default(now()) @map("created_at")

  bankaHesap BankaHesap         @relation(fields: [bankaHesapId], references: [id], onDelete: Cascade)
  satirlar   BankaEkstreSatir[]

  @@index([tenantId, bankaHesapId])
  @@map("banka_ekstreleri")
}

/// KSB-06: ekstredeki tek bir hareket. Onaylanana kadar muhasebeye
/// dokunmaz; eşleştirilince KasaBankaHareket üretir (hareketId dolar).
model BankaEkstreSatir {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  ekstreId     String             @map("ekstre_id") @db.Uuid
  bankaHesapId String             @map("banka_hesap_id") @db.Uuid
  tarih        DateTime           @db.Date
  /// İşaretli: artı = hesaba giriş (tahsilat), eksi = çıkış (tediye).
  tutar        Decimal            @db.Decimal(15, 2)
  aciklama     String
  dekontNo     String?            @map("dekont_no")
  karsiIban    String?            @map("karsi_iban")
  karsiUnvan   String?            @map("karsi_unvan")
  bakiye       Decimal?           @db.Decimal(15, 2)
  durum        EkstreSatirDurum   @default(beklemede)
  cariId       String?            @map("cari_id") @db.Uuid
  faturaId     String?            @map("fatura_id") @db.Uuid
  /// KSB-06: satır neyle eşleşti; geri almanın ne yapacağını belirler
  /// (mevcut fiş yalnız bağdan çözülür, üretilen kayıtlar silinir).
  eslesmeTuru  EkstreEslesmeTuru? @map("eslesme_turu")
  /// tarih+tutar+açıklama+dekont özeti; aynı satırın tekrar yüklenmesini önler.
  satirOzeti   String             @map("satir_ozeti")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  ekstre     BankaEkstre        @relation(fields: [ekstreId], references: [id], onDelete: Cascade)
  bankaHesap BankaHesap         @relation(fields: [bankaHesapId], references: [id], onDelete: Cascade)
  cari       CariHesap?         @relation(fields: [cariId], references: [id])
  fatura     Fatura?            @relation(fields: [faturaId], references: [id])
  /// Bir satır birden çok harekete bağlanabilir (çoklu fatura dağıtımı, virman).
  hareketler KasaBankaHareket[]

  @@unique([tenantId, bankaHesapId, satirOzeti])
  @@index([tenantId, durum])
  @@map("banka_ekstre_satirlari")
}

model KasaBankaHareket {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  kasaId            String?             @map("kasa_id") @db.Uuid
  bankaHesapId      String?             @map("banka_hesap_id") @db.Uuid
  posHesapId        String?             @map("pos_hesap_id") @db.Uuid
  tip               KasaBankaHareketTip
  tutar             Decimal             @db.Decimal(15, 2)
  dovizCinsi        DovizCinsi          @default(TRY) @map("doviz_cinsi")
  kur               Decimal             @default(1) @db.Decimal(15, 6)
  tutarTry          Decimal             @map("tutar_try") @db.Decimal(15, 2)
  tarih             DateTime            @db.Date
  aciklama          String?
  cariId            String?             @map("cari_id") @db.Uuid
  faturaId          String?             @map("fatura_id") @db.Uuid
  /// KSB-07: ödemenin bağlı faturanın dövizindeki tam karşılığı; cari hareketi
  /// bu tutarla fatura dövizinde yazılır. Aynı dövizde `tutar`a eşittir.
  faturaKarsiligi   Decimal?            @map("fatura_karsiligi") @db.Decimal(15, 2)
  /// KSB-07: karşılığın faturaya mahsup edilen kısmı (en fazla kalan); artanı
  /// carinin avansı olarak bakiyede kalır. Faturanın kalanı yalnız bundan hesaplanır.
  faturaMahsubu     Decimal?            @map("fatura_mahsubu") @db.Decimal(15, 2)
  karsiHareketId    String?             @map("karsi_hareket_id") @db.Uuid
  kaynakTur         String              @default("manuel") @map("kaynak_tur")
  kaynakRef         String?             @map("kaynak_ref")
  projeId           String?             @map("proje_id") @db.Uuid
  projeAltKirilimId String?             @map("proje_alt_kirilim_id") @db.Uuid
  /// KSB-06: hareketin eşleştiği banka ekstresi satırı.
  ekstreSatirId     String?             @map("ekstre_satir_id") @db.Uuid
  kurFarkiFaturaId  String?             @map("kur_farki_fatura_id") @db.Uuid
  /// KSB-07: kur farkı için fatura gerekmediğine karar verildi (ör. önemsiz tutar).
  kurFarkiKapandi   Boolean             @default(false) @map("kur_farki_kapandi")
  /// KSB-09: tahsilat/tediye makbuz numarası (ör. TM2026-000001). Veritabanı
  /// tetikleyicisi `makbuz_no_ver` kayıtta verir; uygulama yazmaz.
  makbuzNo          String?             @map("makbuz_no")
  /// KSB-13: açıklama + makbuz no, aksansız (veritabanında üretilir, yalnız okunur).
  aramaNormal       String?             @map("arama_normal")
  createdAt         DateTime            @default(now()) @map("created_at")

  kasa              Kasa?              @relation(fields: [kasaId], references: [id])
  bankaHesap        BankaHesap?        @relation(fields: [bankaHesapId], references: [id])
  posHesap          PosHesap?          @relation(fields: [posHesapId], references: [id])
  cari              CariHesap?         @relation(fields: [cariId], references: [id])
  fatura            Fatura?            @relation("HareketFaturasi", fields: [faturaId], references: [id])
  /// KSB-07: gerçekleşen kur farkını faturalayan (ya da karşı taraftan gelen) kur farkı faturası.
  kurFarkiFatura    Fatura?            @relation("KurFarkiFaturasi", fields: [kurFarkiFaturaId], references: [id], onDelete: SetNull)
  proje             Proje?             @relation(fields: [projeId], references: [id])
  projeAltKirilim   ProjeAltKirilim?   @relation(fields: [projeAltKirilimId], references: [id])
  ekstreSatir       BankaEkstreSatir?  @relation(fields: [ekstreSatirId], references: [id], onDelete: SetNull)
  pazaryeriKesinti  PazaryeriKesinti?
  posTahsilat       PosTahsilat?
  posIade           PosIade?
  masraf            Masraf?
  krediKartiOdemesi KrediKartiHareket?
  gelirKaydi        GelirKaydi?

  kapamalar FaturaKapama[]

  @@unique([tenantId, makbuzNo])
  @@index([tenantId, tarih])
  @@index([tenantId, projeId])
  @@index([tenantId, ekstreSatirId])
  @@index([tenantId, kasaId, tarih])
  @@index([tenantId, bankaHesapId, tarih])
  @@index([tenantId, kaynakTur, kaynakRef])
  @@map("kasa_banka_hareketleri")
}

/// cari: alınanda çeki veren müşteri, verilende lehtar (çeki verdiğimiz taraf).
/// borclu: alınanda keşideci, verilende kendi firmamız.
model CekSenet {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tur           CekSenetTur
  yon           CekSenetYon   @default(alinan)
  portfoyNo     String        @map("portfoy_no")
  cekNo         String?       @map("cek_no")
  islemTarihi   DateTime      @default(now()) @map("islem_tarihi") @db.Date
  vadeTarihi    DateTime      @map("vade_tarihi") @db.Date
  tutar         Decimal       @db.Decimal(15, 2)
  dovizCinsi    DovizCinsi    @default(TRY) @map("doviz_cinsi")
  kur           Decimal       @default(1) @db.Decimal(15, 6)
  tutarTry      Decimal       @map("tutar_try") @db.Decimal(15, 2)
  borclu        String
  kesideYeri    String?       @map("keside_yeri")
  banka         String?
  sube          String?
  hesapNo       String?       @map("hesap_no")
  durum         CekSenetDurum @default(portfoyde)
  cariId        String?       @map("cari_id") @db.Uuid
  ciroCariId    String?       @map("ciro_cari_id") @db.Uuid
  aciklama      String?
  fizikselKonum String?       @map("fiziksel_konum")
  /// KSB-11: tahsile/teminata verildiği banka hesabı (bankadayken dolu).
  bankaHesapId  String?       @map("banka_hesap_id") @db.Uuid
  /// KSB-11: ön ve arka yüz görüntüsü (ekler tablosunda, MinIO'da).
  onYuzEkId     String?       @map("on_yuz_ek_id") @db.Uuid
  arkaYuzEkId   String?       @map("arka_yuz_ek_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  cari       CariHesap?     @relation("CekSenetCari", fields: [cariId], references: [id])
  ciroCari   CariHesap?     @relation("CekSenetCiro", fields: [ciroCariId], references: [id])
  bankaHesap BankaHesap?    @relation(fields: [bankaHesapId], references: [id])
  onYuzEk    Ek?            @relation("CekOnYuz", fields: [onYuzEkId], references: [id], onDelete: SetNull)
  arkaYuzEk  Ek?            @relation("CekArkaYuz", fields: [arkaYuzEkId], references: [id], onDelete: SetNull)
  olaylar    CekSenetOlay[]

  kapamalar FaturaKapama[]

  @@unique([tenantId, portfoyNo])
  @@map("cek_senetler")
}

/// KSB-11: çek/senet bordrosu — birden çok evrakın tek seferde girişi,
/// cirosu, bankaya verilmesi ya da kendi çeklerimizin çıkışı. Numaralı
/// belgedir; bütün olarak geri alınır, geri alınan bordronun numarası yanar.
model CekSenetBordro {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  no             String
  tur            CekSenetBordroTur
  durum          CekSenetBordroDurum @default(aktif)
  tarih          DateTime            @db.Date
  cariId         String?             @map("cari_id") @db.Uuid
  bankaHesapId   String?             @map("banka_hesap_id") @db.Uuid
  dovizCinsi     DovizCinsi          @default(TRY) @map("doviz_cinsi")
  toplam         Decimal             @db.Decimal(15, 2)
  adet           Int
  /// Tutar ağırlıklı ortalama vade.
  ortalamaVade   DateTime            @map("ortalama_vade") @db.Date
  aciklama       String?
  userId         String?             @map("user_id") @db.Uuid
  geriAlmaNedeni String?             @map("geri_alma_nedeni")
  createdAt      DateTime            @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cari       CariHesap?     @relation(fields: [cariId], references: [id])
  bankaHesap BankaHesap?    @relation(fields: [bankaHesapId], references: [id])
  olaylar    CekSenetOlay[]

  @@unique([tenantId, no])
  @@index([tenantId, tarih])
  @@map("cek_senet_bordrolari")
}

model CekSenetBordroSayac {
  tenantId String @map("tenant_id") @db.Uuid
  yil      Int
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, yil])
  @@map("cek_senet_bordro_sayaclari")
}

enum CekSenetBordroTur {
  giris
  ciro
  tahsile
  teminata
  borc_cikis
}

enum CekSenetBordroDurum {
  aktif
  geri_alindi
}

model CekSenetOlay {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  cekSenetId   String         @map("cek_senet_id") @db.Uuid
  oncekiDurum  CekSenetDurum? @map("onceki_durum")
  yeniDurum    CekSenetDurum  @map("yeni_durum")
  islemTarihi  DateTime       @map("islem_tarihi") @db.Date
  aciklama     String?
  userId       String         @map("user_id") @db.Uuid
  /// KSB-08: bu olay sonradan geri alındı (etkisi silindi ya da ters kaydı atıldı).
  geriAlindi   Boolean        @default(false) @map("geri_alindi")
  /// KSB-08: bu olay, önceki bir olayın geri alınmasıdır; kendisi geri alınamaz.
  geriAlma     Boolean        @default(false) @map("geri_alma")
  /// KSB-11: olayın yapıldığı bordro.
  bordroId     String?        @map("bordro_id") @db.Uuid
  /// KSB-11: olayla çekin girdiği banka hesabı (geri almada önceki hesap buradan döner).
  bankaHesapId String?        @map("banka_hesap_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  cekSenet CekSenet        @relation(fields: [cekSenetId], references: [id], onDelete: Cascade)
  bordro   CekSenetBordro? @relation(fields: [bordroId], references: [id])

  @@index([tenantId, cekSenetId, createdAt])
  @@map("cek_senet_olaylari")
}

enum EkSahipTur {
  cari
  stok
  fatura
  belge
  kasa_banka
  firma
  masraf
  kira_sozlesme
  personel
  satin_alma_teklif
  cek_senet
  /// FTR-42: ticari belgelerin imza alanına basılan kaşe/imza görseli.
  firma_kase
  /// AI-79: asistan sohbetine eklenen dosya; sahip ajan oturumudur, yalnız sohbet sahibi okur.
  ai_sohbet
  /// DMR-01: demirbaş kartının faturası, garanti belgesi, fotoğrafı.
  demirbas
}

enum PersonelBelgeTuru {
  kimlik
  is_sozlesmesi
  diploma
  sertifika
  saglik_raporu
  adli_sicil
  ikametgah
  askerlik
  sgk_bildirgesi
  diger
}

enum MasrafBelgeTuru {
  fis
  fatura
  kira
  dekont
  serbest_meslek_makbuzu
  diger
}

enum MasrafDurum {
  taslak
  onaylandi
  iptal
}

enum MasrafOdemeDurumu {
  odenmedi
  kismi_odendi
  odendi
}

model MasrafKategori {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  ad                 String
  varsayilanKdvOrani Decimal? @map("varsayilan_kdv_orani") @db.Decimal(5, 2)
  muhasebeKodu       String?  @map("muhasebe_kodu")
  ustId              String?  @map("ust_id") @db.Uuid
  aktif              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masraflar        Masraf[]
  kiraSozlesmeleri KiraSozlesme[]
  ust              MasrafKategori?  @relation("MasrafKategoriAgaci", fields: [ustId], references: [id])
  altlar           MasrafKategori[] @relation("MasrafKategoriAgaci")

  @@unique([tenantId, ad])
  @@index([tenantId, aktif])
  @@index([tenantId, ustId])
  @@map("masraf_kategorileri")
}

model GelirKategori {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  ad                    String
  varsayilanStopajOrani Decimal? @map("varsayilan_stopaj_orani") @db.Decimal(5, 2)
  varsayilanKdvOrani    Decimal? @map("varsayilan_kdv_orani") @db.Decimal(5, 2)
  muhasebeKodu          String?  @map("muhasebe_kodu")
  ustId                 String?  @map("ust_id") @db.Uuid
  aktif                 Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gelirKayitlari GelirKaydi[]
  ust            GelirKategori?  @relation("GelirKategoriAgaci", fields: [ustId], references: [id])
  altlar         GelirKategori[] @relation("GelirKategoriAgaci")

  @@unique([tenantId, ad])
  @@index([tenantId, aktif])
  @@index([tenantId, ustId])
  @@map("gelir_kategorileri")
}

model GelirKaydi {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  kategoriId        String     @map("kategori_id") @db.Uuid
  tarih             DateTime   @db.Date
  brutTutar         Decimal    @map("brut_tutar") @db.Decimal(15, 2)
  stopajOrani       Decimal    @default(0) @map("stopaj_orani") @db.Decimal(5, 2)
  stopajTutari      Decimal    @default(0) @map("stopaj_tutari") @db.Decimal(15, 2)
  kdvOrani          Decimal    @default(0) @map("kdv_orani") @db.Decimal(5, 2)
  kdvTutari         Decimal    @default(0) @map("kdv_tutari") @db.Decimal(15, 2)
  netTutar          Decimal    @map("net_tutar") @db.Decimal(15, 2)
  dovizCinsi        DovizCinsi @default(TRY) @map("doviz_cinsi")
  kur               Decimal    @default(1) @db.Decimal(15, 6)
  netTutarTry       Decimal    @map("net_tutar_try") @db.Decimal(15, 2)
  aciklama          String?
  belgeNo           String?    @map("belge_no")
  cariId            String?    @map("cari_id") @db.Uuid
  kasaId            String?    @map("kasa_id") @db.Uuid
  bankaHesapId      String?    @map("banka_hesap_id") @db.Uuid
  hareketId         String?    @unique @map("hareket_id") @db.Uuid
  projeId           String?    @map("proje_id") @db.Uuid
  projeAltKirilimId String?    @map("proje_alt_kirilim_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kategori        GelirKategori     @relation(fields: [kategoriId], references: [id])
  cari            CariHesap?        @relation(fields: [cariId], references: [id])
  kasa            Kasa?             @relation(fields: [kasaId], references: [id])
  bankaHesap      BankaHesap?       @relation(fields: [bankaHesapId], references: [id])
  hareket         KasaBankaHareket? @relation(fields: [hareketId], references: [id])
  proje           Proje?            @relation(fields: [projeId], references: [id])
  projeAltKirilim ProjeAltKirilim?  @relation(fields: [projeAltKirilimId], references: [id])

  @@index([tenantId, tarih])
  @@index([tenantId, kategoriId])
  @@index([tenantId, projeId])
  @@map("gelir_kayitlari")
}

model Masraf {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  kategoriId        String            @map("kategori_id") @db.Uuid
  cariId            String?           @map("cari_id") @db.Uuid
  belgeTuru         MasrafBelgeTuru   @map("belge_turu")
  belgeNo           String?           @map("belge_no")
  tarih             DateTime          @db.Date
  vadeTarihi        DateTime?         @map("vade_tarihi") @db.Date
  saticiUnvan       String?           @map("satici_unvan")
  vknTckn           String?           @map("vkn_tckn")
  vergiDairesi      String?           @map("vergi_dairesi")
  iban              String?
  aciklama          String?
  matrah            Decimal           @db.Decimal(15, 2)
  kdvOrani          Decimal           @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  kdvTutari         Decimal           @map("kdv_tutari") @db.Decimal(15, 2)
  toplam            Decimal           @db.Decimal(15, 2)
  dovizCinsi        DovizCinsi        @default(TRY) @map("doviz_cinsi")
  /// Belge tarihindeki TL karşılığı kuru; masraftan doğan kasa/banka ve cari
  /// hareketlerin `tutarTry` değeri buradan gelir. TRY masrafta 1'dir.
  kur               Decimal           @default(1) @db.Decimal(15, 6)
  durum             MasrafDurum       @default(taslak)
  odemeDurumu       MasrafOdemeDurumu @default(odenmedi) @map("odeme_durumu")
  odenenTutar       Decimal           @default(0) @map("odenen_tutar") @db.Decimal(15, 2)
  odemeTarihi       DateTime?         @map("odeme_tarihi") @db.Date
  kasaId            String?           @map("kasa_id") @db.Uuid
  bankaHesapId      String?           @map("banka_hesap_id") @db.Uuid
  hareketId         String?           @unique @map("hareket_id") @db.Uuid
  kiraSozlesmeId    String?           @map("kira_sozlesme_id") @db.Uuid
  kiraDonemi        DateTime?         @map("kira_donemi") @db.Date
  stopajOrani       Decimal?          @map("stopaj_orani") @db.Decimal(5, 2)
  stopajTutari      Decimal?          @map("stopaj_tutari") @db.Decimal(15, 2)
  projeId           String?           @map("proje_id") @db.Uuid
  projeAltKirilimId String?           @map("proje_alt_kirilim_id") @db.Uuid
  /// KSB-10: "kredi_karti" — kart ekranından girilen gider; kart hareketiyle birlikte geri alınır.
  kaynakTur         String            @default("manuel") @map("kaynak_tur")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kategori        MasrafKategori    @relation(fields: [kategoriId], references: [id])
  cari            CariHesap?        @relation(fields: [cariId], references: [id])
  kasa            Kasa?             @relation(fields: [kasaId], references: [id])
  bankaHesap      BankaHesap?       @relation(fields: [bankaHesapId], references: [id])
  hareket         KasaBankaHareket? @relation(fields: [hareketId], references: [id])
  kiraSozlesme    KiraSozlesme?     @relation(fields: [kiraSozlesmeId], references: [id])
  proje           Proje?            @relation(fields: [projeId], references: [id])
  projeAltKirilim ProjeAltKirilim?  @relation(fields: [projeAltKirilimId], references: [id])
  odemeler        MasrafOdeme[]

  maliyetDagitimlari MaliyetDagitimi[]

  @@unique([kiraSozlesmeId, kiraDonemi])
  @@index([tenantId, tarih])
  @@index([tenantId, kategoriId, durum])
  @@index([tenantId, odemeDurumu, vadeTarihi])
  @@index([tenantId, projeId])
  @@map("masraflar")
}

model MasrafOdeme {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  masrafId            String   @map("masraf_id") @db.Uuid
  kasaId              String?  @map("kasa_id") @db.Uuid
  bankaHesapId        String?  @map("banka_hesap_id") @db.Uuid
  krediKartiId        String?  @map("kredi_karti_id") @db.Uuid
  hareketId           String?  @unique @map("hareket_id") @db.Uuid
  krediKartiHareketId String?  @unique @map("kredi_karti_hareket_id") @db.Uuid
  tutar               Decimal  @db.Decimal(15, 2)
  odemeTarihi         DateTime @map("odeme_tarihi") @db.Date
  aciklama            String?
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masraf            Masraf             @relation(fields: [masrafId], references: [id], onDelete: Cascade)
  kasa              Kasa?              @relation(fields: [kasaId], references: [id])
  bankaHesap        BankaHesap?        @relation(fields: [bankaHesapId], references: [id])
  krediKarti        KrediKarti?        @relation(fields: [krediKartiId], references: [id])
  krediKartiHareket KrediKartiHareket? @relation(fields: [krediKartiHareketId], references: [id])

  @@index([tenantId, masrafId, odemeTarihi])
  @@map("masraf_odemeleri")
}

model KiraSozlesme {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  kategoriId      String     @map("kategori_id") @db.Uuid
  cariId          String?    @map("cari_id") @db.Uuid
  baslik          String
  tasinmazAdresi  String?    @map("tasinmaz_adresi")
  kirayaVeren     String?    @map("kiraya_veren")
  vknTckn         String?    @map("vkn_tckn")
  iban            String?
  baslangicTarihi DateTime   @map("baslangic_tarihi") @db.Date
  bitisTarihi     DateTime?  @map("bitis_tarihi") @db.Date
  odemeGunu       Int        @default(1) @map("odeme_gunu")
  matrah          Decimal    @db.Decimal(15, 2)
  kdvOrani        Decimal    @default(0) @map("kdv_orani") @db.Decimal(5, 2)
  stopajOrani     Decimal    @default(0) @map("stopaj_orani") @db.Decimal(5, 2)
  dovizCinsi      DovizCinsi @default(TRY) @map("doviz_cinsi")
  aktif           Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kategori  MasrafKategori @relation(fields: [kategoriId], references: [id])
  cari      CariHesap?     @relation(fields: [cariId], references: [id])
  masraflar Masraf[]

  @@index([tenantId, aktif, baslangicTarihi])
  @@map("kira_sozlesmeleri")
}

model Ek {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  sahipTur       EkSahipTur @map("sahip_tur")
  sahipId        String     @map("sahip_id") @db.Uuid
  dosyaAdi       String     @map("dosya_adi")
  mimeTip        String     @map("mime_tip")
  boyut          Int
  depoAnahtari   String     @unique @map("depo_anahtari")
  yukleyenUserId String?    @map("yukleyen_user_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")

  personelBelgesi PersonelBelgesi?
  cekOnYuzleri    CekSenet[]       @relation("CekOnYuz")
  cekArkaYuzleri  CekSenet[]       @relation("CekArkaYuz")

  @@index([tenantId, sahipTur, sahipId])
  @@map("ekler")
}

// ─── Belge Zinciri (FTR-12): teklif → sipariş → irsaliye → fatura ──────────

enum BelgeTur {
  teklif
  siparis
  irsaliye
}

enum BelgeYon {
  satis
  alis
}

/// kapandi = zincirde sonraki belgeye/faturaya dönüştü; kismen_kapandi =
/// siparişin bir kısmı irsaliyeye dönüştü, kalanı hâlâ bekliyor (SAT-09)
enum ZincirBelgeDurum {
  taslak
  onaylandi
  kismen_kapandi
  kapandi
  iptal
  /// FTR-34: teklifin yeni sürümü açıldı; salt okunur, dönüştürülemez.
  revize_edildi
}

/// Stok düşümü HER ZAMAN faturada (S-01 2026-07-13); irsaliye yalnız sevk
/// belgesidir. Satış siparişi onayı rezerv, alış siparişi yoldaki üretir.
/// Kayıtlı araç kartı (EBLG-25). e-İrsaliyede plaka her seferinde elle
/// girilmesin diye tutulur; seçildiğinde değerler belgeye **kopyalanır**,
/// belge kartı referans almaz — kart sonradan değişse de geçmiş irsaliye
/// GİB'e ne gönderildiyse onu göstermeye devam eder.
model Arac {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  plaka             String
  dorsePlaka        String?   @map("dorse_plaka")
  aciklama          String?
  aktif             Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// ARC-01/02 (§3.21): araç takibi alanları; e-İrsaliye yalnız plakayı kullanır.
  marka             String?
  model             String?
  modelYili         Int?      @map("model_yili")
  saseNo            String?   @map("sase_no")
  /// binek | hafif_ticari | agir_vasita | motosiklet | is_makinesi | diger
  tur               String?
  yakitTuru         String?   @map("yakit_turu")
  /// oz | kiralik | diger
  mulkiyet          String?
  demirbasId        String?   @map("demirbas_id") @db.Uuid
  kiraSozlesmeId    String?   @map("kira_sozlesme_id") @db.Uuid
  sorumluPersonelId String?   @map("sorumlu_personel_id") @db.Uuid
  /// ARC-06: binek oto kiralama/işletme faaliyeti — gider kısıtı uygulanmaz.
  binekSinirYok     Boolean   @default(false) @map("binek_sinir_yok")
  bakimKmAraligi    Int?      @map("bakim_km_araligi")
  bakimAyAraligi    Int?      @map("bakim_ay_araligi")
  sonBakimTarihi    DateTime? @map("son_bakim_tarihi") @db.Date
  sonBakimKm        Int?      @map("son_bakim_km")

  yukumlulukler AracYukumluluk[]
  giderler      AracGider[]
  kmKayitlari   AracKmKaydi[]
  bakimlar      AracBakim[]
  cezalar       AracCeza[]

  @@unique([tenantId, plaka])
  @@index([tenantId, aktif])
  @@map("araclar")
}

/// Kayıtlı şoför kartı (EBLG-25). Araçtan ayrı tutulur: aynı şoför başka araç
/// kullandığında kart çoğalmasın.
model Sofor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ad        String
  soyad     String
  /// GİB `DriverPerson/NationalityID`. Kişisel veri; zorunlu değil.
  tckn      String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, aktif])
  @@map("soforler")
}

model Belge {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  tur                    BelgeTur
  yon                    BelgeYon
  durum                  ZincirBelgeDurum @default(taslak)
  no                     String?
  tarih                  DateTime         @db.Date
  gecerlilikTarihi       DateTime?        @map("gecerlilik_tarihi") @db.Date
  /// Müşterinin sipariş referansı (EBLG-74). e-İrsaliyeye `OrderReference`
  /// olarak yazılır; boşsa zincirdeki siparişin numarası ve tarihi kullanılır.
  siparisNo              String?          @map("siparis_no")
  siparisTarihi          DateTime?        @map("siparis_tarihi") @db.Date
  /// FTR-31: müşterinin talep (teklif isteği) referansı. Teklifte girilir,
  /// zincir boyunca kopyalanır; sipariş numarası yoksa `OrderReference` olur.
  talepNo                String?          @map("talep_no")
  talepTarihi            DateTime?        @map("talep_tarihi") @db.Date
  /// FTR-32: müşteri tarafında ilgili kişi. Cari kişilerinden seçilir ya da
  /// elle yazılır; belgeye kopyalanır, kart değişse de çıktı değişmez.
  ilgiliKisi             String?          @map("ilgili_kisi")
  ilgiliKisiGorevi       String?          @map("ilgili_kisi_gorevi")
  /// FTR-33: teklif koşulları. Vade günü faturaya vade tarihi olarak geçer
  /// (fatura tarihi + gün); teslim şekli Incoterms kodudur, ihracat
  /// faturasının boş teslim şartını doldurur. Teslim süresi serbest metindir.
  odemeVadeGun           Int?             @map("odeme_vade_gun")
  teslimSuresi           String?          @map("teslim_suresi")
  teslimSekli            String?          @map("teslim_sekli")
  /// FTR-34: teklif revizyonu. Sürümler aynı numarayı taşır (Rev.1, Rev.2…);
  /// `revizyonKokId` ilk sürümün kimliğidir, ilk sürümde boştur.
  revizyonNo             Int              @default(0) @map("revizyon_no")
  revizyonKokId          String?          @map("revizyon_kok_id") @db.Uuid
  /// FTR-40: basım dili (tr/en/de/ar/ru); çift dilde Türkçe + bu dil.
  /// Varsayılanı cari kartından gelir, zincir boyunca faturaya taşınır.
  belgeDili              String           @default("tr") @map("belge_dili")
  ciftDil                Boolean          @default(false) @map("cift_dil")
  /// FTR-27: alış irsaliyesinde tedarikçinin kendi irsaliye numarası. `no`
  /// bizim iç seri numaramızdır (AIR…); giden e-İrsaliye serisinden alınmaz.
  tedarikciBelgeNo       String?          @map("tedarikci_belge_no")
  /// SAT-12: alış irsaliyesi gelen e-İrsaliyeden oluşturulduysa kaynağı.
  /// Tekildir: aynı e-İrsaliyeden ikinci irsaliye açılmaz.
  gelenEirsaliyeId       String?          @unique @map("gelen_eirsaliye_id") @db.Uuid
  gelenEirsaliye         GelenEirsaliye?  @relation(fields: [gelenEirsaliyeId], references: [id], onDelete: SetNull)
  /// EBLG-83: satış irsaliyesi e-İrsaliye düzenlenemeyen yere (firma ya da
  /// alıcı e-İrsaliye kullanıcısı değil) kesildiyse kâğıt irsaliyedir: iç
  /// seriden (KIR…) numaralanır, e-İrsaliye olarak gönderilmez.
  kagitIrsaliye          Boolean          @default(false) @map("kagit_irsaliye")
  /// EBLG-83: kâğıt irsaliyenin basımevi (matbu) numarası; elle girilir.
  matbuBelgeNo           String?          @map("matbu_belge_no")
  /// EBLG-84: irsaliyeye özel teslimat adresi (ihracatta gümrük kapısı).
  /// Doluysa carinin sevk adresinin önüne geçer; Türkiye'de bir adrestir.
  teslimatAdres          String?          @map("teslimat_adres")
  teslimatIl             String?          @map("teslimat_il")
  teslimatIlce           String?          @map("teslimat_ilce")
  teslimatPostaKodu      String?          @map("teslimat_posta_kodu")
  /// EBLG-87: ithal malın gümrükten depoya kısım kısım taşınması. Alış
  /// irsaliyesidir ama firma düzenler ve e-İrsaliye olarak gönderir; satıcı
  /// da alıcı da firmanın kendisidir. Teslimat adresi = boşaltma (depo).
  gumrukDepoSevki        Boolean          @default(false) @map("gumruk_depo_sevki")
  gumrukBeyannameNo      String?          @map("gumruk_beyanname_no")
  gumrukBeyannameTarihi  DateTime?        @map("gumruk_beyanname_tarihi") @db.Date
  /// Aynı beyannamenin kaçıncı seferi; onayda verilir.
  gumrukSeferNo          Int?             @map("gumruk_sefer_no")
  /// Yükleme adresi (gümrük); e-İrsaliyede `Despatch/DespatchAddress`.
  yuklemeAdres           String?          @map("yukleme_adres")
  yuklemeIl              String?          @map("yukleme_il")
  yuklemeIlce            String?          @map("yukleme_ilce")
  yuklemePostaKodu       String?          @map("yukleme_posta_kodu")
  cariId                 String           @map("cari_id") @db.Uuid
  /// STK-07: rezerv/yoldaki ve irsaliye stok etkisinin işleneceği depo
  depoId                 String?          @map("depo_id") @db.Uuid
  dovizCinsi             DovizCinsi       @default(TRY) @map("doviz_cinsi")
  kur                    Decimal          @default(1) @db.Decimal(15, 6)
  genelIskontoYuzdesi    Decimal          @default(0) @map("genel_iskonto_yuzdesi") @db.Decimal(5, 2)
  genelIskontoTutari     Decimal          @default(0) @map("genel_iskonto_tutari") @db.Decimal(15, 2)
  toplamBrut             Decimal          @map("toplam_brut") @db.Decimal(15, 2)
  toplamSatirIskontosu   Decimal          @map("toplam_satir_iskontosu") @db.Decimal(15, 2)
  genelIskontoToplam     Decimal          @map("genel_iskonto_toplam") @db.Decimal(15, 2)
  toplamMatrah           Decimal          @map("toplam_matrah") @db.Decimal(15, 2)
  toplamKdv              Decimal          @map("toplam_kdv") @db.Decimal(15, 2)
  toplamTevkifat         Decimal          @default(0) @map("toplam_tevkifat") @db.Decimal(15, 2)
  toplamNetKdv           Decimal          @map("toplam_net_kdv") @db.Decimal(15, 2)
  /// EBLG-132: KDV dışı vergiler (fatura gibi); genel toplama dahil, stopaj düşülmüş.
  toplamEkVergi          Decimal          @default(0) @map("toplam_ek_vergi") @db.Decimal(15, 2)
  toplamStopaj           Decimal          @default(0) @map("toplam_stopaj") @db.Decimal(15, 2)
  genelToplam            Decimal          @map("genel_toplam") @db.Decimal(15, 2)
  aciklama               String?
  notlar                 String?
  /// e-İrsaliye taşıma bilgileri (EBLG-23). Yalnız irsaliyede anlamlı.
  /// Malın fiilen yola çıktığı an; boşsa onay anı yazılır.
  fiiliSevkZamani        DateTime?        @map("fiili_sevk_zamani")
  /// Taşıyan nakliyeci/kargo firması. Boşsa malı kendi aracımızla götürdük.
  /// İDİS (EBLG-72): sevkiyat numarası; doluysa e-İrsaliye IDISIRSALIYE
  /// profiliyle gider.
  idisSevkiyatNo         String?          @map("idis_sevkiyat_no")
  tasiyiciCariId         String?          @map("tasiyici_cari_id") @db.Uuid
  plaka                  String?
  dorsePlaka             String?          @map("dorse_plaka")
  soforAdi               String?          @map("sofor_adi")
  soforSoyadi            String?          @map("sofor_soyadi")
  soforTckn              String?          @map("sofor_tckn")
  kaynakBelgeId          String?          @map("kaynak_belge_id") @db.Uuid
  faturaId               String?          @map("fatura_id") @db.Uuid
  b2bIdempotencyAnahtari String?          @map("b2b_idempotency_anahtari") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  cari            CariHesap        @relation(fields: [cariId], references: [id])
  tasiyiciCari    CariHesap?       @relation("BelgeTasiyici", fields: [tasiyiciCariId], references: [id])
  depo            Depo?            @relation(fields: [depoId], references: [id])
  kaynakBelge     Belge?           @relation("BelgeZinciri", fields: [kaynakBelgeId], references: [id])
  turetilenler    Belge[]          @relation("BelgeZinciri")
  revizyonKoku    Belge?           @relation("TeklifRevizyonu", fields: [revizyonKokId], references: [id], onDelete: Restrict)
  revizyonlar     Belge[]          @relation("TeklifRevizyonu")
  fatura          Fatura?          @relation(fields: [faturaId], references: [id])
  satirlar        BelgeSatir[]
  /// SAT-06: bu sipariş bir satın alma talebinden oluştuysa.
  satinAlmaTalebi SatinAlmaTalebi?
  eirsaliye       EirsaliyeKayit?
  teklifTakibi    TeklifTakibi?
  teklifYanitlari GelenEposta[]    @relation("TeklifYanitlari")

  /// FTR-34: teklif sürümleri aynı numarayı paylaşır.
  @@unique([tenantId, no, revizyonNo])
  @@unique([tenantId, b2bIdempotencyAnahtari])
  @@index([tenantId, revizyonKokId])
  @@index([tenantId, tur, durum])
  @@index([tenantId, cariId])
  @@map("belgeler")
}

enum EirsaliyeDurum {
  kuyrukta
  iletildi
  kabul
  ret
  hata
  /// Alıcı irsaliyenin bir kısmını kabul etti, bir kısmını reddetti (EBLG-36).
  kismi_kabul
}

enum GelenEirsaliyeDurum {
  yeni
  kabul
  ret
}

/// Elektronik irsaliye yalnız sevk belgesidir; stok etkisi faturada doğar.
model EirsaliyeKayit {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  belgeId             String         @unique @map("belge_id") @db.Uuid
  durum               EirsaliyeDurum @default(kuyrukta)
  entegratorRef       String?        @map("entegrator_ref")
  xmlIcerik           String?        @map("xml_icerik")
  hataMesaji          String?        @map("hata_mesaji")
  /// EBLG-85: alıcı GİB e-İrsaliye listesinde değildi, belge alıcı etiketi
  /// olmadan (GİB sanal alıcısına) gitti. Alıcı yanıt veremez; çıktısı
  /// düzenleyen tarafından verilir.
  aliciKayitsiz       Boolean        @default(false) @map("alici_kayitsiz")
  /// EBLG-94: son gönderim geçici bir hatayla düştü (ağ, entegratörün 5xx/429
  /// yanıtı); kuyruk işçisi aynı numarayla kendiliğinden yeniden dener.
  geciciHata          Boolean        @default(false) @map("gecici_hata")
  yenidenDenemeSayisi Int            @default(0) @map("yeniden_deneme_sayisi")
  /// EBLG-106: entegratörün kendi durum adı (NES `outgoingStatus`). `kuyrukta`
  /// taslakta kalan ile GİB'de bekleyen belgeyi ayırt etmez; anlamı
  /// `eirsaliyeAsamasi` (shared) verir.
  entegratorDurumu    String?        @map("entegrator_durumu")
  /// Durumun en son sorgulandığı an; aynı irsaliye 2 saat dolmadan tekrar sorulmaz (EBLG-36).
  sonDurumSorguAt     DateTime?      @map("son_durum_sorgu_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  belge               Belge          @relation(fields: [belgeId], references: [id], onDelete: Cascade)

  @@index([tenantId, durum, sonDurumSorguAt])
  @@map("eirsaliye_kayitlari")
}

/// Belge durum geçmişi (EBLG-35). Satırları veritabanı tetikleyicisi yazar
/// (`belge_durum_gecmisi_yaz`); uygulama yalnız okur, rolün UPDATE/DELETE
/// yetkisi yoktur. `eksen`: fatura | ebelge | alici_yaniti | eirsaliye.
model BelgeDurumGecmisi {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eksen     String
  kayitId   String   @map("kayit_id") @db.Uuid
  faturaId  String?  @map("fatura_id") @db.Uuid
  belgeId   String?  @map("belge_id") @db.Uuid
  eskiDurum String?  @map("eski_durum")
  yeniDurum String   @map("yeni_durum")
  aciklama  String?
  /// İşlem başında kurulan `app.user_id`; sistem işlerinde sıfır UUID.
  userId    String?  @map("user_id") @db.Uuid
  /// Özellik öncesi kayıtlar için eklenen, gerçek değişiklik olmayan satır.
  baslangic Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, faturaId, createdAt])
  @@index([tenantId, belgeId, createdAt])
  @@map("belge_durum_gecmisi")
}

model GelenEirsaliye {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  uuid           String
  belgeNo        String              @map("belge_no")
  gonderenVkn    String              @map("gonderen_vkn")
  gonderenUnvan  String              @map("gonderen_unvan")
  tarih          DateTime            @db.Date
  /// EBLG-96: belgedeki fiilî sevk günü; yanıt süresi (7 gün) buradan sayılır.
  sevkTarihi     DateTime            @map("sevk_tarihi") @db.Date
  xmlIcerik      String              @map("xml_icerik")
  durum          GelenEirsaliyeDurum @default(yeni)
  yanitRef       String?             @map("yanit_ref")
  /// Yanıt belgesinin numarası; sağlayıcı atar (EBLG-24).
  yanitBelgeNo   String?             @map("yanit_belge_no")
  yanitGerekcesi String?             @map("yanit_gerekcesi")
  /// EBLG-87: firmanın kendi gönderdiği belge (gümrükten depoya sevk, alıcı da
  /// firma). Yanıt istenmez, bekleyenlere girmez.
  kendiSevkimiz  Boolean             @default(false) @map("kendi_sevkimiz")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SAT-12: bu e-İrsaliyeden oluşturulan alış irsaliyesi.
  alisIrsaliyesi Belge?

  @@unique([tenantId, uuid])
  @@index([tenantId, durum, tarih])
  @@map("gelen_eirsaliyeler")
}

model BelgeSatir {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  belgeId            String  @map("belge_id") @db.Uuid
  stokId             String  @map("stok_id") @db.Uuid
  varyantId          String? @map("varyant_id") @db.Uuid
  partiBilgileri     Json?   @map("parti_bilgileri")
  miktar             Decimal @db.Decimal(15, 3)
  birim              String  @default("adet")
  birimFiyat         Decimal @map("birim_fiyat") @db.Decimal(15, 4)
  iskontoOrani       Decimal @default(0) @map("iskonto_orani") @db.Decimal(5, 2)
  iskontoTutari      Decimal @default(0) @map("iskonto_tutari") @db.Decimal(15, 2)
  genelIskontoPayi   Decimal @default(0) @map("genel_iskonto_payi") @db.Decimal(15, 2)
  matrah             Decimal @db.Decimal(15, 2)
  kdvOrani           Decimal @default(20) @map("kdv_orani") @db.Decimal(5, 2)
  kdvTutari          Decimal @map("kdv_tutari") @db.Decimal(15, 2)
  tevkifatPay        Int?    @map("tevkifat_pay")
  tevkifatPayda      Int?    @map("tevkifat_payda")
  tevkifatTutari     Decimal @default(0) @map("tevkifat_tutari") @db.Decimal(15, 2)
  netKdvTutari       Decimal @map("net_kdv_tutari") @db.Decimal(15, 2)
  /// EBLG-132: KDV dışı vergiler, fatura satırındaki biçimde. Boş dizi =
  /// vergisiz; NULL = özellikten önce yazılmış satır (faturaya geçerken
  /// vergiler ürün kartından çözülür).
  ekVergiler         Json?   @map("ek_vergiler")
  ekVergiTutari      Decimal @default(0) @map("ek_vergi_tutari") @db.Decimal(15, 2)
  stopajTutari       Decimal @default(0) @map("stopaj_tutari") @db.Decimal(15, 2)
  toplamTutar        Decimal @map("toplam_tutar") @db.Decimal(15, 2)
  fiyatListesiId     String? @map("fiyat_listesi_id") @db.Uuid
  /// SAT-09: sipariş satırından şimdiye dek irsaliyeye dönüşen miktar; kalan
  /// = miktar − teslimEdilenMiktar. Yalnız sipariş satırlarında birikir.
  teslimEdilenMiktar Decimal @default(0) @map("teslim_edilen_miktar") @db.Decimal(15, 3)
  /// SAT-09: bu satırın türediği sipariş satırı. İrsaliye iptal edilince
  /// teslim edilen miktarın hangi satırdan düşeceğini bu bağ söyler.
  kaynakSatirId      String? @map("kaynak_satir_id") @db.Uuid
  /// İDİS etiket numarası (EBLG-72); irsaliye satırında da zorunludur.
  idisEtiketNo       String? @map("idis_etiket_no")

  belge             Belge               @relation(fields: [belgeId], references: [id], onDelete: Cascade)
  stok              StokKart            @relation(fields: [stokId], references: [id])
  varyant           StokVaryant?        @relation(fields: [varyantId], references: [id])
  uretimEmirleri    UretimEmri[]
  kaynakSatir       BelgeSatir?         @relation("BelgeSatirZinciri", fields: [kaynakSatirId], references: [id], onDelete: SetNull)
  turetilenSatirlar BelgeSatir[]        @relation("BelgeSatirZinciri")
  girisTarihi       SiparisGirisTarihi?

  @@unique([tenantId, id])
  @@index([tenantId, belgeId])
  @@index([kaynakSatirId])
  @@map("belge_satirlari")
}

/// F04: yalnız açık alış siparişinin kalan satırı için kullanıcı doğrulaması.
/// Geçmiş revizyonlar audit_log içinde korunur; kaynak değişirse özet eşleşmez.
model SiparisGirisTarihi {
  tenantId         String     @map("tenant_id") @db.Uuid
  satirId          String     @map("satir_id") @db.Uuid
  tarih            DateTime?  @db.Date
  surum            Int        @default(1)
  kaynakOzeti      String     @map("kaynak_ozeti") @db.VarChar(64)
  gerekce          String     @db.VarChar(1000)
  dogrulayanUserId String     @map("dogrulayan_user_id") @db.Uuid
  guncellendiAt    DateTime   @default(now()) @map("guncellendi_at") @db.Timestamp(3)
  satir            BelgeSatir @relation(fields: [tenantId, satirId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tenantId, satirId])
  @@unique([satirId])
  @@map("siparis_giris_tarihleri")
}

/// Belge numaralama sayacı (tur + yıl bazında; yasal kesintisizlik gerekmez).
model BelgeSayac {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  tur      BelgeTur
  /// FTR-27: irsaliye sayacı yöne göre ayrılır — alış irsaliyesi giden
  /// e-İrsaliye serisinde boşluk bırakmasın. Diğer türler hep `satis` anahtarını
  /// kullanır (iç belgeler; alış/satış siparişi aynı SIP serisini paylaşır).
  yon      BelgeYon @default(satis)
  /// EBLG-83: aynı tür ve yönde ayrı numara serisi; boş = türün varsayılanı
  /// (satış irsaliyesinde giden e-İrsaliye serisi), "KIR" = kâğıt irsaliye.
  seri     String   @default("")
  yil      Int
  sonSira  Int      @default(0) @map("son_sira")

  @@unique([tenantId, tur, yon, seri, yil])
  @@map("belge_sayaclari")
}

/// Satın alma talebi (SAT-01…SAT-08): taslak → onay_bekliyor → onaylandi /
/// reddedildi → siparise_donustu; taslak veya onay bekleyen talep iptal edilebilir.
enum SatinAlmaTalepDurumu {
  taslak
  onay_bekliyor
  onaylandi
  reddedildi
  siparise_donustu
  iptal
}

enum SatinAlmaOlayTuru {
  olusturuldu
  guncellendi
  onaya_gonderildi
  geri_cekildi
  onaylandi
  reddedildi
  iptal_edildi
  teklif_eklendi
  teklif_silindi
  teklif_secildi
  siparise_donustu
  /// SAT-09: seçilen teklif onaylanan tutarı marjın üstünde aştı ya da eşiği geçti.
  yeniden_onaya_gonderildi
}

model IhtiyacSatinAlmaBagi {
  tenantId   String          @map("tenant_id") @db.Uuid
  planId     String          @map("plan_id") @db.Uuid
  talepId    String          @map("talep_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  istekOzeti String          @map("istek_ozeti") @db.VarChar(64)
  createdAt  DateTime        @default(now()) @map("created_at")
  plan       IhtiyacPlani    @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
  talep      SatinAlmaTalebi @relation(fields: [tenantId, talepId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, planId])
  @@unique([tenantId, talepId])
  @@map("ihtiyac_satin_alma_baglari")
}

model SatinAlmaTalebi {
  ihtiyacBagi          IhtiyacSatinAlmaBagi?
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  no                   String
  talepEdenUserId      String                @map("talep_eden_user_id") @db.Uuid
  departmanId          String?               @map("departman_id") @db.Uuid
  ihtiyacTarihi        DateTime              @map("ihtiyac_tarihi") @db.Date
  gerekce              String
  /// Bütçe satırı anahtarı (BUT-05): mal_alis, hizmet_alis veya masraf_kategori:<id>.
  butceAnahtari        String                @map("butce_anahtari")
  durum                SatinAlmaTalepDurumu  @default(taslak)
  /// Kalemlerin tahmini tutarı; KDV hariç, TL.
  tahminiToplam        Decimal               @map("tahmini_toplam") @db.Decimal(15, 2)
  /// Onaylayan ya da reddeden kullanıcı.
  onaylayanUserId      String?               @map("onaylayan_user_id") @db.Uuid
  onayZamani           DateTime?             @map("onay_zamani")
  /// SAT-09: onay anındaki etkin tutar (TL, KDV hariç); seçilen teklif bunu %10'dan fazla aşarsa yeniden onay gerekir.
  onaylananTutar       Decimal?              @map("onaylanan_tutar") @db.Decimal(15, 2)
  butceAsimGerekcesi   String?               @map("butce_asim_gerekcesi")
  redGerekcesi         String?               @map("red_gerekcesi")
  teklifSecimGerekcesi String?               @map("teklif_secim_gerekcesi")
  siparisBelgeId       String?               @unique @map("siparis_belge_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  talepEden    User                   @relation("SatinAlmaTalepEden", fields: [talepEdenUserId], references: [id])
  onaylayan    User?                  @relation("SatinAlmaTalepOnaylayan", fields: [onaylayanUserId], references: [id], onDelete: SetNull)
  departman    PersonelDepartman?     @relation(fields: [departmanId], references: [id], onDelete: SetNull)
  siparisBelge Belge?                 @relation(fields: [siparisBelgeId], references: [id], onDelete: SetNull)
  kalemler     SatinAlmaTalepKalemi[]
  teklifler    SatinAlmaTeklifi[]
  olaylar      SatinAlmaTalepOlayi[]

  @@unique([tenantId, id])
  @@unique([tenantId, no])
  @@index([tenantId, durum])
  @@index([tenantId, talepEdenUserId])
  @@map("satin_alma_talepleri")
}

model SatinAlmaTalepKalemi {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  talepId           String  @map("talep_id") @db.Uuid
  sira              Int
  /// Siparişe dönüşümde belge satırı kart ister; hizmet alımı hizmet kartıyla girilir.
  stokId            String  @map("stok_id") @db.Uuid
  miktar            Decimal @db.Decimal(15, 3)
  /// Kartın ana birimi.
  birim             String
  tahminiBirimFiyat Decimal @map("tahmini_birim_fiyat") @db.Decimal(15, 4)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  talep           SatinAlmaTalebi         @relation(fields: [talepId], references: [id], onDelete: Cascade)
  stok            StokKart                @relation(fields: [stokId], references: [id])
  teklifKalemleri SatinAlmaTeklifKalemi[]

  @@index([talepId])
  @@map("satin_alma_talep_kalemleri")
}

model SatinAlmaTeklifi {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  talepId          String     @map("talep_id") @db.Uuid
  tedarikciCariId  String     @map("tedarikci_cari_id") @db.Uuid
  dovizCinsi       DovizCinsi @default(TRY) @map("doviz_cinsi")
  kur              Decimal    @default(1) @db.Decimal(18, 6)
  teslimSuresiGun  Int?       @map("teslim_suresi_gun")
  gecerlilikTarihi DateTime?  @map("gecerlilik_tarihi") @db.Date
  aciklama         String?
  /// KDV hariç, teklif dövizinde.
  toplam           Decimal    @db.Decimal(15, 2)
  /// KDV hariç, teklifin kuruyla TL; karşılaştırma ve bütçe bu tutarla yapılır.
  toplamTry        Decimal    @map("toplam_try") @db.Decimal(15, 2)
  secildi          Boolean    @default(false)
  createdAt        DateTime   @default(now()) @map("created_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  talep     SatinAlmaTalebi         @relation(fields: [talepId], references: [id], onDelete: Cascade)
  tedarikci CariHesap               @relation(fields: [tedarikciCariId], references: [id])
  kalemler  SatinAlmaTeklifKalemi[]

  @@index([talepId])
  @@map("satin_alma_teklifleri")
}

model SatinAlmaTeklifKalemi {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  teklifId      String  @map("teklif_id") @db.Uuid
  talepKalemiId String  @map("talep_kalemi_id") @db.Uuid
  birimFiyat    Decimal @map("birim_fiyat") @db.Decimal(15, 4)
  kdvOrani      Decimal @map("kdv_orani") @db.Decimal(5, 2)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teklif      SatinAlmaTeklifi     @relation(fields: [teklifId], references: [id], onDelete: Cascade)
  talepKalemi SatinAlmaTalepKalemi @relation(fields: [talepKalemiId], references: [id], onDelete: Cascade)

  @@unique([teklifId, talepKalemiId])
  @@map("satin_alma_teklif_kalemleri")
}

/// SAT-03: talep olay geçmişi; yalnız eklenir.
model SatinAlmaTalepOlayi {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  talepId   String            @map("talep_id") @db.Uuid
  tur       SatinAlmaOlayTuru
  aciklama  String?
  userId    String            @map("user_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  talep  SatinAlmaTalebi @relation(fields: [talepId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id])

  @@index([tenantId, talepId, createdAt])
  @@map("satin_alma_talep_olaylari")
}

model SatinAlmaSayac {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  yil      Int
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yil])
  @@map("satin_alma_sayaclari")
}

// ─── 4. Aşama (Ek Modüller): Personel & İK ─────────────────────────────

enum PersonelCalismaTipi {
  tam_zamanli
  yari_zamanli
  sozlesmeli
}

enum PersonelDurum {
  taslak
  aktif
  askida
  uzun_sureli_izin
  isten_ayrildi
}

enum PersonelBordroDurum {
  hesaplandi
  onay_bekliyor
  onaylandi
  kismen_odendi
  reddedildi
  odendi
  iptal
}

enum PersonelBordroOdemeDurum {
  aktif
  iptal
}

enum PersonelEksikGunNedeni {
  istirahat
  ucretsiz_izin
  disiplin
  gozaltina_alinma
  kismi_istihdam
  puantaj
  diger
}

enum PersonelAvansDurum {
  talep
  onaylandi
  odendi
  kismen_mahsup
  mahsup_edildi
  reddedildi
  iptal
}

enum PersonelIzinTalepDurum {
  talep
  onaylandi
  reddedildi
  iptal
}

enum PersonelIzinBakiyeHareketTipi {
  devir
  hak_edis
  kullanim
  iade
  duzeltme_artis
  duzeltme_azalis
}

enum PersonelBordroKalemTipi {
  kazanc
  kesinti
}

model PersonelSayac {
  tenantId String @id @map("tenant_id") @db.Uuid
  sonSira  Int    @default(0) @map("son_sira")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("personel_sayaclari")
}

model Personel {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  personelNo         String              @map("personel_no")
  ad                 String
  soyad              String
  tckn               String?
  eposta             String?
  telefon            String?
  /// PRS-21: çalışanın adresi (self-servis bilgi güncelleme talebiyle değişir).
  adres              String?
  departman          String?
  unvan              String?
  calismaTipi        PersonelCalismaTipi @default(tam_zamanli) @map("calisma_tipi")
  girisTarihi        DateTime            @map("giris_tarihi") @db.Date
  cikisTarihi        DateTime?           @map("cikis_tarihi") @db.Date
  netMaas            Decimal             @map("net_maas") @db.Decimal(15, 2)
  brutMaas           Decimal?            @map("brut_maas") @db.Decimal(15, 2)
  engellilikDerecesi Int?                @map("engellilik_derecesi")
  /// PRS-08: yıllık izin yaş kuralı (18 yaş altı / 50 yaş üstü en az 20 gün).
  dogumTarihi        DateTime?           @map("dogum_tarihi") @db.Date
  sgkTesvikOrani     Decimal             @default(0) @map("sgk_tesvik_orani") @db.Decimal(6, 3)
  /// PRS-23: SGK bildirge ve MUHSGK alanları. Meslek kodu ISCO-08 (NNNN.NN), belge türü SGK kodu,
  /// öğrenim durumu SGK 0–7, teşvik kanun no 5 hane (boşsa döküm teşvik oranından önerir).
  meslekKodu         String?             @map("meslek_kodu")
  sgkBelgeTuru       String              @default("1") @map("sgk_belge_turu")
  ogrenimDurumu      Int?                @map("ogrenim_durumu")
  tesvikKanunNo      String?             @map("tesvik_kanun_no")
