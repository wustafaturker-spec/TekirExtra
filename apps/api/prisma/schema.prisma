  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  personelId      String   @map("personel_id") @db.Uuid
  yururlukTarihi  DateTime @map("yururluk_tarihi") @db.Date
  tip             String
  tutar           Decimal  @db.Decimal(15, 2)
  neden           String?
  olusturanUserId String?  @map("olusturan_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personelId, yururlukTarihi])
  @@map("personel_ucretleri")
}

