  faturaId             String?           @map("fatura_id") @db.Uuid
  tutar                Decimal           @db.Decimal(15, 2)
  dovizCinsi           DovizCinsi        @default(TRY) @map("doviz_cinsi")
  durum                PosTahsilatDurumu @default(baslatildi)
  saglayiciToken       String?           @unique @map("saglayici_token")
  saglayiciOdemeId     String?           @map("saglayici_odeme_id")
  odemeSayfasiUrl      String?           @map("odeme_sayfasi_url")
  hareketId            String?           @unique @map("hareket_id") @db.Uuid
  hataMesaji           String?           @map("hata_mesaji")
  odemeTarihi          DateTime?         @map("odeme_tarihi")
  sonKullanimTarihi    DateTime?         @map("son_kullanim_tarihi")
  denemeSayisi         Int               @default(1) @map("deneme_sayisi")
  makbuzAnahtari       String            @unique @map("makbuz_anahtari")
  epostaGonderimTarihi DateTime?         @map("eposta_gonderim_tarihi")
  epostaHatasi         String?           @map("eposta_hatasi")
  smsGonderimTarihi    DateTime?         @map("sms_gonderim_tarihi")
  smsGorevId           String?           @map("sms_gorev_id")
  smsHatasi            String?           @map("sms_hatasi")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

