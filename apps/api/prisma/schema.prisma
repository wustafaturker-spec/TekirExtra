  @@index([tenantId, ad, soyad])
  @@map("personel")
}

/// PRS-22 (P3-4): çalışanın self-servisten iletişim/IBAN güncelleme talebi; İK onaylayınca karta yazılır.
model PersonelBilgiTalebi {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
